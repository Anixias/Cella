mod test

Text: own rec
{
	id: i32

	drop: op
	{
	}
}

Holder: ref rec
{
	t: imm[Text]
}

Count: ref rec
{
	n: imm[i32]
}

consume: fun(t: Text)
{
}

holderSourceMoved: fun -> i32
{
	var a = Text(1)
	val h = Holder(a)
	val r = imm h
	consume(a)
	ret r.t.id
}

holderRepointed: fun -> i32
{
	var y = 1
	var h = Count(y)
	val r = imm h
	{
		var x = 2
		h = Count(x)
	}

	ret r.n
}

closureViewScope: fun -> i32
{
	var y = 0
	var view: imm[i32] = y
	val f = fun -> i32 => view
	{
		var x = 1
		view = x
	}

	ret f()
}

closureViewMoved: fun -> i32
{
	val text = Text(1)
	val r: imm[Text] = imm text
	val f = fun -> i32 => r.id
	consume(text)
	ret f()
}

closureOfClosure: fun -> i32
{
	val text = Text(1)
	val inner = fun -> i32 => text.id
	val outer = fun -> i32 => inner() + 1
	consume(text)
	ret outer()
}

main: fun -> i32 => 0
