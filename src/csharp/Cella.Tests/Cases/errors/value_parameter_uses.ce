mod test

Ring[T, const N: usize]: rec
{
	items: array[T, N]
}

Ring[T, const N: u8]: impl
{
	slots: fun(imm self) -> u8 => N
}

Short: trait
{
	doubled: fun(imm self) -> u8
}

array[T, const N: u8]: impl Short
{
	doubled: fun(imm self) -> u8 => N * 2
}

Small[const N: u8]: rec
{
	items: array[i32, N]
}

misuse[const N: usize]: fun -> usize
{
	val x: N = 1
	val y = N()
	val z = N.length
	ret N
}

typed[T]: fun(imm value: T) {}

tiny[const N: u8]: fun(values: array[i32, N]) -> i32 => 0

count: const i32 = 3

lengths: fun
{
	var negative: array[i32, -1] = undef
	var typed: array[i32, count] = undef
	var bare: array[i32] = [1, 2]
	val r = Ring[i32, -1]()
	val s = Ring[i32, count]()
	val t = sizeOf(array[i32, -2])
	val u = Ring[i32, 300]().slots()
	var huge: array[i32, 300] = undef
	val v = huge.doubled()
}

main: fun -> i32
{
	val a = Ring[16, i32]()
	val b = Small[300]()
	val c = Ring[i32]()
	val d = Small[1.5]()
	typed[4](1)
	var big: array[i32, 300] = undef
	ret tiny(big)
}
