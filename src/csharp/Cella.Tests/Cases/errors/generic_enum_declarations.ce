mod test

Option[T]: enum
{
	none
	some(value: T)
}

Pair[T, T]: enum
{
	both(first: T, second: T)
}

Wrapper[T]: enum
{
	one(value: T)

	pick[T]: fun(imm self, imm other: T) -> i32 => 0
}

Endless[T]: enum
{
	stop
	more(next: Endless[T])
}

Growing[T]: enum
{
	stop
	more(next: Growing[ptr[T]])
}

Holder: rec
{
	name: Option[imm[i32]]
}

Plain: enum
{
	nothing
	held(value: Option[str])
}

bare: fun(o: Option) -> i32 => 0

main: fun -> i32 => 0
