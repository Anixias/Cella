mod test

Eq: trait
{
	==: op(imm a: Self, imm b: Self) -> bool
}

grow[const N: usize]: fun(values: array[i32, N]) -> array[i32, N + 1] => undef

Doubled[const N: usize]: rec
{
	items: array[i32, N * 2]
}

Signed[const N: i32]: rec
{
	items: array[i32, N]
}

Floaty[const N: f64]: rec
{
	value: i32
}

Lettered[const N: char]: rec
{
	value: i32
}

Vector: rec
{
	x: i32

	+[const N: usize]: op(a: Vector, b: Vector) -> Vector => a
	[][const N: usize]: op(self, i: usize) -> i32 => 0
}

array[T]: impl Eq
{
	==: op(imm a: array[T, 1], imm b: array[T, 1]) -> bool => true
}

Sized: trait
{
	size: fun(imm self) -> usize
}

array[const N: usize, T]: impl Sized
{
	size: fun(self) -> usize => 0
}

array[T, const N: i32]: impl Sized
{
	size: fun(self) -> usize => 0
}

Ring[T, const N: usize]: rec
{
	items: array[T, N]
}

Ring[const N: usize, T]: impl Sized
{
	size: fun(self) -> usize => 0
}

main: fun -> i32 => 0
