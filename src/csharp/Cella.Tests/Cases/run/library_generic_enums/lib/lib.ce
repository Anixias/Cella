mod lib

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: pub enum
{
	none
	some(value: T)

	made: var i32 = 0

	wrap: fun(own value: T) -> Option[T]
	{
		made += 1
		ret Option.some(own value)
	}

	orElse: fun(own self, own fallback: T) -> T
	{
		match own self
		{
			some(own v) => ret v
			none => ret fallback
		}
	}

	isSome: get(imm self) -> bool => self is some(_)
}

Token: pub rec
{
	id: i32

	drop: op
	{
		printf("drop %d ", self.id)
	}
}

first[T]: pub fun(own a: Option[T], own b: Option[T]) -> Option[T]
{
	if a.isSome
		ret a

	ret b
}

libraryCount: pub fun -> i32
{
	val item = Option[i32].wrap(1)
	ret Option[i32].made
}
