mod test

Secret: pvt trait
{
	id: fun(imm self) -> i32
}

Hash: mod trait
{
	hash: fun(imm self) -> u64
}

Hidden: pvt rec
{
	x: i32
}

f[T: Secret]: pub fun(imm x: T) -> i32 = x.id()
g[T: new(Hidden)]: pub fun -> i32 = 0
h[F: fun[Hidden -> i32]]: pub fun -> i32 = 0
k[T: Hash]: fun(imm x: T) -> i32 = 0

box[T: Secret]: pub rec
{
	value: T
}

holder[T: Hash]: pub rec
{
	value: T
}

main: fun -> i32 = 0
