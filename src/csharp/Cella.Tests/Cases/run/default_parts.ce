mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Effect: enum
{
	hit(amount: i32)
	none
}

Handler: rec
{
	callback: fun[i32 -> i32]
	scale: i32
}

Holder: rec
{
	effect: Effect
	count: i32
}

Outer: rec
{
	handler: Handler
	label: i32
}

Wrapper: rec
{
	handler: Handler

	new: op(f: fun[i32 -> i32])
	{
		self.handler.callback = f
	}
}

double: fun(n: i32) -> i32 = n * 2
negate: fun(n: i32) -> i32 = -n

amount: fun(effect: Effect) -> i32 = match effect
{
	hit(n) => n
	none => 0
}

local: fun -> i32
{
	var handler: Handler
	handler.callback = double
	ret handler.callback(5) + handler.scale
}

holder: fun -> i32
{
	var holder: Holder
	holder.effect = Effect.hit(3)
	ret amount(holder.effect) + holder.count
}

elements: fun -> i32
{
	var handlers: array[Handler, 2]
	handlers[0].callback = double
	handlers[1].callback = negate
	ret handlers[0].callback(handlers[1].scale + 4) + handlers[1].callback(1)
}

nested: fun -> i32
{
	var outer: Outer
	outer.handler.callback = negate
	ret outer.handler.callback(outer.label + 2)
}

constructed: fun -> i32
{
	val wrapper = Wrapper(double)
	ret wrapper.handler.callback(wrapper.handler.scale + 21)
}

Closer: rec
{
	id: i32

	drop: op
	{
	}
}

Keeper: rec
{
	closer: Closer
	count: i32
}

Guarded: rec
{
	handle: req i32
	flags: i32

	drop: op
	{
	}
}

describeCloser: fun(closer: Closer) -> i32 = closer.id
describeKeeper: fun(keeper: Keeper) -> i32 = keeper.closer.id * 10 + keeper.count
describeGuarded: fun(guarded: Guarded) -> i32 = guarded.handle * 10 + guarded.flags

explicit: fun -> i32 = describeCloser(Closer())

written: fun -> i32
{
	var closer: Closer
	closer.id = 5
	ret describeCloser(closer)
}

kept: fun -> i32
{
	var keeper: Keeper
	keeper.closer.id = 7
	ret describeKeeper(keeper)
}

guarded: fun -> i32
{
	var guarded: Guarded
	guarded.handle = 8
	ret describeGuarded(guarded)
}

main: fun -> i32
{
	printf("%d %d %d %d %d\n", local(), holder(), elements(), nested(), constructed())
	printf("%d %d %d %d\n", explicit(), written(), kept(), guarded())
	ret 0
}
