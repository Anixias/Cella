mod test

Option[T]: enum
{
	none
	some(value: T)
}

Iterator[T]: trait
{
	next: fun(mut self) -> Option[T]
}

From[T]: trait
{
	new: op(imm value: T)
}

Countdown: rec impl Iterator[i64]
{
	left: i32

	next: fun(mut self) -> Option[i32] => none
}

Empty: rec impl Iterator[i32]
{
	x: i32
}

Celsius: rec impl From[f32] + From[f32]
{
	degrees: f32
}

Tag[T]: trait
{
}

Box[T]: rec
{
	value: T
}

Box[T]: impl Tag[T]
{
}

Box[T]: impl Tag[i32]
{
}

Box[T]: impl Tag[str]
{
}

Pair[A, B]: rec
{
	a: A
	b: B
}

Pair[A, B]: impl Tag[A]
{
}

Pair[X, Y]: impl Tag[Y]
{
}

Console: rec
{
	x: i32
}

Console: impl Iterator[i32]
{
	next: fun(mut self) -> Option[i32] => none
	flush: fun(self) { }
}

main: fun -> i32 => 0
