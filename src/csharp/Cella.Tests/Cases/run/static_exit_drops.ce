mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Buffer: pub rec
{
	id: i32

	drop: op
	{
		printf("drop %d\n", self.id)
	}
}

Holder[T]: rec
{
	kept: var Buffer = Buffer(30)
}

first: var Buffer = Buffer(1)

second: val Buffer = Buffer(2)

Pool: rec
{
	spare: var Buffer = Buffer(3)
}

main: fun -> i32
{
	first = Buffer(10)
	Holder[i32].kept.id += 1
	Holder[bool].kept.id += 2
	printf("%d %d %d %d %d\n", first.id, second.id, Pool.spare.id, Holder[i32].kept.id, Holder[bool].kept.id)
	ret 0
}
