mod test

Texture: own rec
{
	id: i32

	drop: op
	{
	}
}

Result[T, E]: enum
{
	ok(value: T)
	err(error: E)

	?: op(self) -> T => match self
	{
		ok(val value) => value
		err(val error) => ret Result.err(error)
	}
}

load: fun(id: i32) -> Result[Texture, i32] => Result.ok(Texture(id))

twice: fun -> Result[i32, i32]
{
	val r = load(2)
	val a = r?
	val b = r?
	ret Result.ok(a.id + b.id)
}

main: fun -> i32 => 0
