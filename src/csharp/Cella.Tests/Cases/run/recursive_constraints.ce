mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Cell[T: copy]: rec
{
	value: ptr[T]
}

Holder[T: new]: rec
{
	value: ptr[T]
}

Guard[T: drop]: rec
{
	value: ptr[T]
}

Node: rec
{
	next: Cell[Node]
	x: i32
}

Leaf: rec
{
	up: Holder[Leaf]
	y: i32
}

Item: own rec
{
	link: Guard[Item]

	drop: op
	{
	}
}

main: fun -> i32
{
	val n = Node(Cell[Node](null), 1)
	val l = Leaf(Holder[Leaf](null), 2)
	printf("%d %d\n", n.x, l.y)
	ret 0
}
