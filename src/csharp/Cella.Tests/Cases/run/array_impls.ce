mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Eq: trait
{
	==: op(imm a: Self, imm b: Self) -> bool
}

Counted: trait
{
	count: fun(imm self) -> usize
}

i32: impl Eq

array[T: Eq, N: const usize]: impl Eq
{
	==: op(imm a: array[T, N], imm b: array[T, N]) -> bool
	{
		for i in 0..N
		{
			if !(a[i] == b[i])
				ret false
		}

		ret true
	}
}

array[T, N: const usize]: impl Counted
{
	count: fun(imm self) -> usize => N
}

Short: trait
{
	doubled: fun(imm self) -> u8
}

array[T, N: const u8]: impl Short
{
	doubled: fun(imm self) -> u8 => N * 2
}

same[T: Eq]: fun(imm a: T, imm b: T) -> bool => a == b

counted[T: Counted]: fun(imm item: T) -> usize => item.count()

main: fun -> i32
{
	printf("%d %d %d\n", i32(same([1, 2], [1, 2])), i32(same([1, 2, 3], [1, 2, 4])),
		i32(same([[1, 2], [3, 4]], [[1, 2], [3, 4]])))

	printf("%d %d %d\n", i32(counted([7, 8, 9])), i32([1, 2, 3, 4].count()), i32([5, 6].doubled()))
	ret 0
}
