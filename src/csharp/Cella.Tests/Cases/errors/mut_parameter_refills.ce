mod test

Buffer: own rec
{
	id: i32

	drop: op
	{
	}
}

Pair: own rec
{
	left: Buffer
	right: Buffer
}

Wrapper: own rec
{
	pair: Pair

	drop: op
	{
		take(self.pair.left)
	}
}

make: fun(id: i32) -> Buffer => Buffer(id)
take: fun(buffer: Buffer) -> i32 => buffer.id

whole: fun(mut buffer: Buffer)
{
	take(buffer)
}

field: fun(mut pair: Pair) -> i32
{
	val old = own pair.left
	ret old.id
}

early: fun(mut buffer: Buffer, flag: bool) -> i32
{
	val old = own buffer
	if flag
		ret 1

	buffer = make(old.id + 1)
	ret 0
}

swap: fun(mut pair: Pair)
{
	val left = own pair.left
	pair.left = pair.right
	pair.right = left
}

keep: fun(built: Built) -> i32 => built.buffer.id

Built: own rec
{
	buffer: Buffer

	new: op(id: i32)
	{
		self.buffer = make(id)
		keep(self)
	}
}

implicit: fun(mut buffer: Buffer)
{
	val copy: Buffer = buffer
}

main: fun -> i32 => 0
