mod lib

Eq: pub trait
{
	==: op(imm a: Self, imm b: Self) -> bool
}

i32: impl Eq

box[T]: pub rec
{
	value: T
}

box[T: Eq]: impl
{
	same: fun(imm self, imm other: box[T]) -> bool = self.value == other.value
}

cell[K: trait]: pub rec
{
	object: ptr[dyn[K]]

	of[T: K]: fun(value: ptr[T]) -> cell[K] = cell[K](value)

	*: op(self) -> imm[dyn[K]] = imm *self.object
}

holder[T]: pub rec
{
	count: i32

	new: op
	{
		self.count = 5
	}
}

make[T: new]: pub fun -> T = T()

Meters: pub rec
{
	value: i32

	new: op(value: i32)
	{
		self.value = value * 100
	}
}

build[T: new(i32)]: pub fun(value: i32) -> T = T(value)

twin[T: copy]: pub fun(value: T) -> box[T] = box(value)

measure[K: trait, T: K]: pub fun(value: ptr[T], action: fun[imm dyn[K] -> f64]) -> f64 = action(imm *cell[K].of(value))
