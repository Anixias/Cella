mod test

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Effect: enum
{
	none
	hold(buffer: Buffer)
}

make: fun(id: i32) -> Effect = Effect.hold(Buffer(id))
take: fun(own buffer: Buffer) -> i32 = buffer.id
touch: fun(mut buffer: Buffer)
{
}

owned: fun -> i32
{
	match make(2)
	{
		hold(mut buffer) => touch(mut buffer)
		else => {}
	}

	ret 0
}

mutable: fun -> i32
{
	var effect = make(3)
	match mut effect
	{
		hold(own buffer) => ret take(buffer)
		else => ret 0
	}
}

main: fun -> i32 = 0
