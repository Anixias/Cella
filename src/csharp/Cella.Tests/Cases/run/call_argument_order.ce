mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Token: rec
{
	id: i32

	drop: op
	{
		printf("drop%d ", self.id)
	}
}

Bag: rec
{
	tokens: array[Token, 2]

	[]: op(imm self, i: usize) -> imm[Token]
	{
		printf("bag[] ")
		ret imm self.tokens[i]
	}

	[]: op(mut self, i: usize) -> mut[Token]
	{
		printf("mutbag[] ")
		ret mut self.tokens[i]
	}
}

Row: rec
{
	values: array[i32, 3]

	[]: op(mut self, i: usize) -> mut[i32]
	{
		printf("mutrow[] ")
		ret mut self.values[i]
	}

	bump: fun(mut self, amount: i32)
	{
		printf("bump ")
		self.values[0] += amount
	}
}

Grid: rec
{
	rows: array[Row, 2]

	[]: op(mut self, i: usize) -> mut[Row]
	{
		printf("mutgrid[] ")
		ret mut self.rows[i]
	}
}

pick: fun -> usize
{
	printf("pick ")
	ret 1
}

second: fun -> usize
{
	printf("second ")
	ret 2
}

compute: fun -> i32
{
	printf("compute ")
	ret 5
}

make: fun(id: i32) -> Token
{
	printf("make ")
	ret Token(id)
}

reset: fun(mut bag: Bag) -> i32
{
	printf("reset ")
	bag = Bag([Token(7), Token(8)])
	ret 9
}

show: fun(imm token: Token, extra: i32) -> i32
{
	printf("show%d ", token.id)
	ret extra
}

pair: fun(imm first: Token, imm second: Token) -> i32
{
	printf("pair%d%d ", first.id, second.id)
	ret 0
}

add: fun(mut slot: i32, amount: i32) -> i32
{
	slot += amount
	ret slot
}

sum: fun(a: i32, b: i32) -> i32 => a + b

point: fun(p: ptr[i32], amount: i32) -> i32 => *p + amount

main: fun -> i32
{
	var grid = Grid([Row([1, 2, 3]), Row([4, 5, 6])])
	val a = grid[pick()][second()]
	printf("= %d | read through []\n", a)
	add(mut grid[pick()][second()], compute())
	printf("| mut argument\n")
	grid[pick()].bump(compute())
	printf("| mut self method\n")
	sum(compute(), add(mut grid[pick()][second()], compute()))
	printf("| nested call\n")
	var bag = Bag([Token(1), Token(2)])
	show(imm bag[pick()], compute())
	printf("| lent argument\n")
	show(imm bag[1], reset(mut bag))
	printf("| lent argument, container replaced\n")
	pair(imm bag[pick()], make(3))
	printf("| lent temporary\n")
	sum(compute(), show(make(4), 0))
	printf("| lent temporary in order\n")
	var numbers = [10, 20, 30]
	point(@numbers[pick()], compute())
	printf("| pointer argument\n")
	var rows: array[array[i32, 3], 2]
	val b = rows[pick()][second()]
	printf("= %d | nested arrays\n", b)
	ret 0
}
