mod test

Option[T]: enum
{
	none
	some(value: T)
}

Team: enum
{
	red
	blue
}

pick: fun(o: Option[i32]) -> i32 => 0
some: fun(value: i32) -> Option[i32] => Option.some(value)
blue: val Team = Team.red

locals: fun -> Option[i32]
{
	val none = Option[i32].some(1)
	val picked = pick(none)
	ret none
}

calls: fun -> i32 => pick(some(2))
globals: fun -> bool => Team.red == blue

main: fun -> i32 => 0
