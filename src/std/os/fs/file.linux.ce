mod std.fs

use when linux

use std.[Result, Span, View]
use std.io.[IoError, SeekFrom]
use std.mem.[Heap, Layout]
use std.text.[Text, Utf8]

Status: pvt rec
{
	device: u64
	inode: u64
	links: u64
	mode: u32
	user: u32
	group: u32
	padding: i32
	specialDevice: u64
	size: i64
	blockSize: i64
	blocks: i64
	accessed: array[i64, 2]
	modified: array[i64, 2]
	changed: array[i64, 2]
	reserved: array[i64, 3]
}

pvt ext
{
	openFile: ext("open") fun(path: ptr[u8], flags: i32, ...) -> i32
	readFile: ext("read") fun(file: i32, buffer: ptr, count: usize) -> isize
	writeFile: ext("write") fun(file: i32, buffer: ptr, count: usize) -> isize
	seekFile: ext("lseek") fun(file: i32, offset: i64, origin: i32) -> i64
	fstat: fun(file: i32, status: ptr[Status]) -> i32
	pathStatus: ext("stat") fun(path: ptr[u8], status: ptr[Status]) -> i32
	linkStatus: ext("lstat") fun(path: ptr[u8], status: ptr[Status]) -> i32
	fsync: fun(file: i32) -> i32
	fchmod: fun(file: i32, mode: u32) -> i32
	changeMode: ext("chmod") fun(path: ptr[u8], mode: u32) -> i32
	ftruncate: fun(file: i32, length: i64) -> i32
	renameFile: ext("rename") fun(from: ptr[u8], to: ptr[u8]) -> i32
	renameat2: fun(fromDirectory: i32, from: ptr[u8], toDirectory: i32, to: ptr[u8], flags: u32) -> i32
	linkFile: ext("link") fun(from: ptr[u8], to: ptr[u8]) -> i32
	unlinkFile: ext("unlink") fun(path: ptr[u8]) -> i32
	makeFolder: ext("mkdir") fun(path: ptr[u8], mode: u32) -> i32
	removeFolder: ext("rmdir") fun(path: ptr[u8]) -> i32
	closeFile: ext("close") fun(file: i32) -> i32
	errorLocation: ext("__errno_location") fun -> ptr[i32]
	openAt: ext("openat") fun(directory: i32, path: ptr[u8], flags: i32, ...) -> i32
	statusAt: ext("fstatat") fun(directory: i32, path: ptr[u8], status: ptr[Status], flags: i32) -> i32
	unlinkAt: ext("unlinkat") fun(directory: i32, path: ptr[u8], flags: i32) -> i32
	fdopendir: fun(file: i32) -> ptr
	readdir: fun(directory: ptr) -> ptr[DirectoryEntry]
	dirfd: fun(directory: ptr) -> i32
	closedir: fun(directory: ptr) -> i32
	stringLength: ext("strlen") fun(text: ptr[u8]) -> usize
	readLink: ext("readlink") fun(path: ptr[u8], buffer: ptr[u8], size: usize) -> isize
	makeLink: ext("symlink") fun(target: ptr[u8], link: ptr[u8]) -> i32
}

readOnly: pvt const i32 = 0x0
writeOnly: pvt const i32 = 0x1
readWriteFlag: pvt const i32 = 0x2
createFlag: pvt const i32 = 0x40
exclusiveFlag: pvt const i32 = 0x80
truncateFlag: pvt const i32 = 0x200
appendFlag: pvt const i32 = 0x400
createPermissions: pvt const i32 = 0x1B6
closeOnExec: pvt const i32 = 0x80000
directoryFlag: pvt const i32 = 0x10000
noFollowFlag: pvt const i32 = 0x20000
noFollowLinks: pvt const i32 = 0x100
removeDirectoryFlag: pvt const i32 = 0x200
seekStart: pvt const i32 = 0
seekCurrent: pvt const i32 = 1
seekEnd: pvt const i32 = 2
currentDirectory: pvt const i32 = -100
noReplace: pvt const u32 = 1
notPermitted: pvt const u32 = 1
noEntry: pvt const u32 = 2
interrupted: pvt const u32 = 4
accessDenied: pvt const u32 = 13
fileExists: pvt const u32 = 17
crossDevice: pvt const u32 = 18
noSpace: pvt const u32 = 28
readOnlyFileSystem: pvt const u32 = 30
quotaExceeded: pvt const u32 = 122
notDirectory: pvt const u32 = 20
isDirectoryError: pvt const u32 = 21
invalidArgument: pvt const u32 = 22
nameTooLong: pvt const u32 = 36
tooManyLinks: pvt const u32 = 40
directoryNotEmptyError: pvt const u32 = 39
notImplemented: pvt const u32 = 38
typeMask: pvt const u32 = 0xF000
regularType: pvt const u32 = 0x8000
directoryType: pvt const u32 = 0x4000
linkType: pvt const u32 = 0xA000
writePermissions: pvt const u32 = 0x92
ownerReadBit: pvt const u32 = 0x100
ownerWriteBit: pvt const u32 = 0x80
ownerExecuteBit: pvt const u32 = 0x40
groupReadBit: pvt const u32 = 0x20
groupWriteBit: pvt const u32 = 0x10
groupExecuteBit: pvt const u32 = 0x8
othersReadBit: pvt const u32 = 0x4
othersWriteBit: pvt const u32 = 0x2
othersExecuteBit: pvt const u32 = 0x1
setUserIdBit: pvt const u32 = 0x800
setGroupIdBit: pvt const u32 = 0x400
stickyBit: pvt const u32 = 0x200
permissionBits: pvt const u32 = 0xFFF
folderPermissions: pvt const u32 = 0x1FF
largestTransfer: pvt const usize = 0x7FFFF000
stackPathLength: pvt const usize = 512
linkBufferSize: pvt const usize = 4096
unknownEntry: pvt const u8 = 0
directoryEntry: pvt const u8 = 4
regularEntry: pvt const u8 = 8
linkEntry: pvt const u8 = 10
separator: mod const u8 = 0x2F

lastError: pvt fun -> u32 => u32(*errorLocation())

errorFrom: pvt fun(code: u32) -> IoError => match code
{
	noEntry, notDirectory => IoError(notFound, code)
	accessDenied, notPermitted, readOnlyFileSystem => IoError(permissionDenied, code)
	fileExists => IoError(alreadyExists, code)
	noSpace, quotaExceeded => IoError(storageFull, code)
	isDirectoryError => IoError(isDirectory, code)
	crossDevice => IoError(crossesDevices, code)
	directoryNotEmptyError => IoError(directoryNotEmpty, code)
	invalidArgument, nameTooLong => IoError(invalidInput, code)
	else => IoError(other, code)
}

flagsOf: pvt fun(mode: FileMode, access: FileAccess) -> i32
{
	var flags = closeOnExec | match access
	{
		read => readOnly
		write => writeOnly
		readWrite => readWriteFlag
	}
	
	flags |= match mode
	{
		open => 0
		openOrCreate => createFlag
		create => createFlag | truncateFlag
		createNew => createFlag | exclusiveFlag
		truncate => truncateFlag
		append => createFlag | appendFlag
	}
	
	ret flags
}

checkPath: pvt fun(path: str) -> Result[IoError]
{
	for i in 0..path.byteLength
	{
		if path[i] == 0
			ret err(IoError(invalidInput, invalidArgument))
	}
	
	ret ok
}

withBytePath[R: noref]: pvt fun(path: str, imm action: fun[ptr[u8] -> R]) -> R
{
	if path.byteLength < stackPathLength
	{
		var buffer: array[u8, stackPathLength]
		copyPath(path, @buffer)
		ret action(@buffer)
	}
	
	var heap = Heap()
	val layout = Layout.arrayOf[u8](path.byteLength + 1)
	val bytes = ptr[u8](heap.allocate(layout))
	if bytes == null
		panic "out of memory"
	
	copyPath(path, bytes)
	val result = action(bytes)
	heap.release(bytes, layout)
	ret result
}

copyPath: pvt fun(path: str, bytes: ptr[u8])
{
	for i in 0..path.byteLength
		bytes[i] = path[i]
	
	bytes[path.byteLength] = 0
}

pathMetadata: mod fun(path: str, followLinks: bool) -> Result[Metadata, IoError]
{
	checkPath(path)?
	ret withBytePath(path, fun(bytes) => metadataOfPath(bytes, followLinks))
}

metadataOfPath: pvt fun(bytes: ptr[u8], followLinks: bool) -> Result[Metadata, IoError]
{
	var status: Status
	var result: i32 = 0
	if followLinks
		result = pathStatus(bytes, @status)
	else
		result = linkStatus(bytes, @status)
	
	if result != 0
		ret err(errorFrom(lastError()))
	
	ret ok(metadataOf(status))
}

metadataOf: pvt fun(status: Status) -> Metadata
{
	val kind = match status.mode & typeMask
	{
		regularType => EntryKind.file
		directoryType => EntryKind.directory
		linkType => EntryKind.symbolicLink
		else => EntryKind.other
	}
	
	var size: u64 = 0
	if kind is file
		size = u64(status.size)
	
	ret Metadata(kind, size, Attributes(status.mode), status.device, status.inode)
}

removePath: mod fun(path: str) -> Result[IoError]
{
	checkPath(path)?
	ret withBytePath(path, fun(bytes) => removeBytes(bytes))
}

removeBytes: pvt fun(bytes: ptr[u8]) -> Result[IoError]
{
	if unlinkFile(bytes) != 0
		ret err(errorFrom(lastError()))
	
	ret ok
}

createPath: mod fun(path: str) -> Result[IoError]
{
	checkPath(path)?
	ret withBytePath(path, fun(bytes) => createBytes(bytes))
}

createBytes: pvt fun(bytes: ptr[u8]) -> Result[IoError]
{
	if makeFolder(bytes, folderPermissions) != 0
		ret err(errorFrom(lastError()))
	
	ret ok
}

removeDirectoryPath: mod fun(path: str) -> Result[IoError]
{
	checkPath(path)?
	ret withBytePath(path, fun(bytes) => removeDirectoryBytes(bytes))
}

removeDirectoryBytes: pvt fun(bytes: ptr[u8]) -> Result[IoError]
{
	if removeFolder(bytes) == 0
		ret ok
	
	val code = lastError()
	var status: Status
	if code == notDirectory && linkStatus(bytes, @status) == 0
		ret err(IoError(notADirectory, code))
	
	ret err(errorFrom(code))
}

copyPath: mod fun(from: str, to: str, replace: bool) -> Result[IoError]
{
	checkPath(from)?
	checkPath(to)?
	ret withBytePath(from, fun(source) => withBytePath(to, fun(target) => copyBytes(source, target, replace)))
}

copyBytes: pvt fun(source: ptr[u8], target: ptr[u8], replace: bool) -> Result[IoError]
{
	val input = NativeFile.openBytes(source, readOnly | closeOnExec)?
	val result = copyFrom(input, target, replace)
	input.close()
	ret result
}

copyFrom: pvt fun(input: NativeFile, target: ptr[u8], replace: bool) -> Result[IoError]
{
	var flags = writeOnly | createFlag | closeOnExec
	if !replace
		flags |= exclusiveFlag
	
	val output = NativeFile.openBytes(target, flags)?
	val result = copyInto(input, output)
	output.close()
	ret result
}

copyInto: pvt fun(input: NativeFile, output: NativeFile) -> Result[IoError]
{
	var source: Status
	var target: Status
	if fstat(input.descriptor, @source) != 0 || fstat(output.descriptor, @target) != 0
		ret err(errorFrom(lastError()))
	
	if source.device == target.device && source.inode == target.inode
		ret err(IoError(invalidInput, 0))
	
	if ftruncate(output.descriptor, 0) != 0
		ret err(errorFrom(lastError()))
	
	var chunk: array[u8, 65536]
	loop
	{
		val count = input.read(mut chunk)?
		if count == 0
			break
		
		var rest = View[u8](@chunk, count)
		while !rest.isEmpty
		{
			val written = output.write(rest)?
			if written == 0
				ret err(IoError(other, 0))
			
			rest = rest.slice(written, rest.length)
		}
	}
	
	if fchmod(output.descriptor, source.mode & permissionBits) != 0
		ret err(errorFrom(lastError()))
	
	ret ok
}

movePath: mod fun(from: str, to: str, replace: bool) -> Result[IoError]
{
	checkPath(from)?
	checkPath(to)?
	ret withBytePath(from, fun(source) => withBytePath(to, fun(target) => moveBytes(source, target, replace)))
}

moveBytes: pvt fun(source: ptr[u8], target: ptr[u8], replace: bool) -> Result[IoError]
{
	var result: i32 = 0
	if replace
		result = renameFile(source, target)
	else
		result = renameat2(currentDirectory, source, currentDirectory, target, noReplace)
	
	if result == 0
		ret ok
	
	val code = lastError()
	if code == crossDevice
		ret moveAcrossDevices(source, target, replace)
	
	if !replace && (code == invalidArgument || code == notImplemented)
		ret moveWithoutReplacing(source, target)
	
	if code == fileExists && sameFile(source, target)
		ret ok
	
	ret err(errorFrom(code))
}

sameFile: pvt fun(first: ptr[u8], second: ptr[u8]) -> bool
{
	var a: Status
	var b: Status
	ret linkStatus(first, @a) == 0 && linkStatus(second, @b) == 0 && a.device == b.device && a.inode == b.inode
}

moveWithoutReplacing: pvt fun(source: ptr[u8], target: ptr[u8]) -> Result[IoError]
{
	if linkFile(source, target) == 0
	{
		if unlinkFile(source) != 0
			ret err(errorFrom(lastError()))
		
		ret ok
	}
	
	val code = lastError()
	if code == fileExists && sameFile(source, target)
		ret ok
	
	if code == fileExists
		ret err(errorFrom(code))
	
	if code == crossDevice
		ret moveAcrossDevices(source, target, false)
	
	var status: Status
	if linkStatus(target, @status) == 0
		ret err(IoError(alreadyExists, fileExists))
	
	if renameFile(source, target) != 0
		ret err(errorFrom(lastError()))
	
	ret ok
}

moveAcrossDevices: pvt fun(source: ptr[u8], target: ptr[u8], replace: bool) -> Result[IoError]
{
	var status: Status
	if linkStatus(source, @status) != 0
		ret err(errorFrom(lastError()))
	
	if (status.mode & typeMask) != regularType
		ret err(IoError(crossesDevices, crossDevice))
	
	copyBytes(source, target, replace)?
	unlinkFile(source)
	ret ok
}

Attributes: pub rec
{
	mode: pvt u32
	
	new: mod op(mode: u32)
	{
		self.mode = mode & permissionBits
	}
	
	readOnly: prop bool
	{
		get(self) => (self.mode & writePermissions) == 0
		set(mut self, value)
		{
			if value
				self.mode &= ~writePermissions
			else
				self.mode |= ownerWriteBit
		}
	}
	
	ownerRead: prop bool
	{
		get(self) => self.has(ownerReadBit)
		set(mut self, value) => self.change(ownerReadBit, value)
	}
	
	ownerWrite: prop bool
	{
		get(self) => self.has(ownerWriteBit)
		set(mut self, value) => self.change(ownerWriteBit, value)
	}
	
	ownerExecute: prop bool
	{
		get(self) => self.has(ownerExecuteBit)
		set(mut self, value) => self.change(ownerExecuteBit, value)
	}
	
	groupRead: prop bool
	{
		get(self) => self.has(groupReadBit)
		set(mut self, value) => self.change(groupReadBit, value)
	}
	
	groupWrite: prop bool
	{
		get(self) => self.has(groupWriteBit)
		set(mut self, value) => self.change(groupWriteBit, value)
	}
	
	groupExecute: prop bool
	{
		get(self) => self.has(groupExecuteBit)
		set(mut self, value) => self.change(groupExecuteBit, value)
	}
	
	othersRead: prop bool
	{
		get(self) => self.has(othersReadBit)
		set(mut self, value) => self.change(othersReadBit, value)
	}
	
	othersWrite: prop bool
	{
		get(self) => self.has(othersWriteBit)
		set(mut self, value) => self.change(othersWriteBit, value)
	}
	
	othersExecute: prop bool
	{
		get(self) => self.has(othersExecuteBit)
		set(mut self, value) => self.change(othersExecuteBit, value)
	}
	
	setUserId: prop bool
	{
		get(self) => self.has(setUserIdBit)
		set(mut self, value) => self.change(setUserIdBit, value)
	}
	
	setGroupId: prop bool
	{
		get(self) => self.has(setGroupIdBit)
		set(mut self, value) => self.change(setGroupIdBit, value)
	}
	
	sticky: prop bool
	{
		get(self) => self.has(stickyBit)
		set(mut self, value) => self.change(stickyBit, value)
	}
	
	has: pvt fun(self, bit: u32) -> bool => (self.mode & bit) != 0
	
	change: pvt fun(mut self, bit: u32, value: bool)
	{
		if value
			self.mode |= bit
		else
			self.mode &= ~bit
	}
	
	bits: mod get(self) -> u32 => self.mode
}

setPathAttributes: mod fun(path: str, attributes: Attributes) -> Result[IoError]
{
	checkPath(path)?
	val mode = attributes.bits
	ret withBytePath(path, fun(bytes) => setByteAttributes(bytes, mode))
}

setByteAttributes: pvt fun(bytes: ptr[u8], mode: u32) -> Result[IoError]
{
	if changeMode(bytes, mode) != 0
		ret err(errorFrom(lastError()))
	
	ret ok
}

DirectoryEntry: mod rec
{
	inode: u64
	offset: i64
	length: u16
	kind: u8
	name: array[u8, 256]
}

openListingAt: pvt fun(directory: i32, bytes: ptr[u8], flags: i32) -> Result[NativeListing, IoError]
{
	var descriptor = openAt(directory, bytes, flags)
	var code: u32 = 0
	while descriptor < 0
	{
		code = lastError()
		if code != interrupted
			break
		
		descriptor = openAt(directory, bytes, flags)
	}
	
	if descriptor < 0
	{
		var status: Status
		val linked = code == tooManyLinks && (flags & noFollowFlag) != 0
		if (code == notDirectory || linked) && statusAt(directory, bytes, @status, noFollowLinks) == 0
			ret err(IoError(notADirectory, code))
		
		ret err(errorFrom(code))
	}
	
	val stream = fdopendir(descriptor)
	if stream == null
	{
		val failure = lastError()
		closeFile(descriptor)
		ret err(errorFrom(failure))
	}
	
	ret ok(NativeListing(stream))
}

NativeListing: mod rec
{
	stream: ptr
	current: ptr[DirectoryEntry]
	currentKind: EntryKind
	
	new: op(stream: ptr)
	{
		self.stream = stream
		self.current = null
		self.currentKind = EntryKind.other
	}
	
	open: fun(path: str, followLinks: bool) -> Result[NativeListing, IoError]
	{
		checkPath(path)?
		var flags = readOnly | directoryFlag | closeOnExec
		if !followLinks
			flags |= noFollowFlag
		
		ret withBytePath(path, fun(bytes) => openListingAt(currentDirectory, bytes, flags))
	}
	
	openChild: fun(self) -> Result[NativeListing, IoError] =>
		openListingAt(dirfd(self.stream), self.currentName(), readOnly | directoryFlag | noFollowFlag | closeOnExec)
	
	next: fun(mut self) -> Result[bool, IoError]
	{
		loop
		{
			*errorLocation() = 0
			val entry = readdir(self.stream)
			if entry == null
			{
				val code = lastError()
				if code != 0
					ret err(errorFrom(code))
				
				ret ok(false)
			}
			
			self.current = entry
			val name = self.currentName()
			if name[0] == 0x2E && (name[1] == 0 || name[1] == 0x2E && name[2] == 0)
				cont
			
			self.currentKind = self.kindOf(entry.kind, name)
			ret ok(true)
		}
	}
	
	kindOf: pvt fun(self, kind: u8, name: ptr[u8]) -> EntryKind
	{
		if kind == regularEntry
			ret EntryKind.file
		
		if kind == directoryEntry
			ret EntryKind.directory
		
		if kind == linkEntry
			ret EntryKind.symbolicLink
		
		if kind != unknownEntry
			ret EntryKind.other
		
		var status: Status
		if statusAt(dirfd(self.stream), name, @status, noFollowLinks) != 0
			ret EntryKind.other
		
		ret metadataOf(status).kind
	}
	
	currentName: pvt fun(self) -> ptr[u8] => ptr[u8](@self.current.name)
	name: get(self) -> str => Text[Utf8](View[u8](self.currentName(), stringLength(self.currentName())))
	kind: get(self) -> EntryKind => self.currentKind
	
	removeCurrent: fun(self) -> Result[IoError]
	{
		var flags: i32 = 0
		if self.currentKind is directory
			flags = removeDirectoryFlag
		
		if unlinkAt(dirfd(self.stream), self.currentName(), flags) != 0
			ret err(errorFrom(lastError()))
		
		ret ok
	}
	
	close: fun(self)
	{
		closedir(self.stream)
	}
}

copyLink: mod fun(from: str, to: str) -> Result[IoError]
{
	checkPath(from)?
	checkPath(to)?
	ret withBytePath(from, fun(source) => withBytePath(to, fun(target) => copyLinkBytes(source, target)))
}

copyLinkBytes: pvt fun(source: ptr[u8], target: ptr[u8]) -> Result[IoError]
{
	var buffer: array[u8, linkBufferSize]
	val length = readLink(source, @buffer, linkBufferSize - 1)
	if length < 0
		ret err(errorFrom(lastError()))
	
	buffer[usize(length)] = 0
	if makeLink(@buffer, target) != 0
		ret err(errorFrom(lastError()))
	
	ret ok
}

createLinkPath: mod fun(target: str, link: str, directory: bool) -> Result[IoError]
{
	checkPath(target)?
	checkPath(link)?
	ret withBytePath(target, fun(destination) => withBytePath(link, fun(bytes) => createLinkBytes(destination, bytes)))
}

createLinkBytes: pvt fun(destination: ptr[u8], link: ptr[u8]) -> Result[IoError]
{
	if makeLink(destination, link) != 0
		ret err(errorFrom(lastError()))
	
	ret ok
}

NativeFile: mod rec
{
	descriptor: i32
	
	open: fun(path: str, mode: FileMode, access: FileAccess) -> Result[NativeFile, IoError]
	{
		checkPath(path)?
		val flags = flagsOf(mode, access)
		ret withBytePath(path, fun(bytes) => openBytes(bytes, flags))
	}
	
	openBytes: fun(bytes: ptr[u8], flags: i32) -> Result[NativeFile, IoError]
	{
		var descriptor = openFile(bytes, flags, createPermissions)
		var code: u32 = 0
		while descriptor < 0
		{
			code = lastError()
			if code != interrupted
				break
			
			descriptor = openFile(bytes, flags, createPermissions)
		}
		
		if descriptor < 0
			ret err(errorFrom(code))
		
		var status: Status
		if fstat(descriptor, @status) == 0 && (status.mode & typeMask) == directoryType
		{
			closeFile(descriptor)
			ret err(IoError(isDirectory, isDirectoryError))
		}
		
		ret ok(NativeFile(descriptor))
	}
	
	read: fun(self, buffer: Span[u8]) -> Result[usize, IoError]
	{
		var count = buffer.length
		if count > largestTransfer
			count = largestTransfer
		
		loop
		{
			val result = readFile(self.descriptor, buffer.data, count)
			if result >= 0
				ret ok(usize(result))
			
			val code = lastError()
			if code != interrupted
				ret err(errorFrom(code))
		}
	}
	
	write: fun(self, data: View[u8]) -> Result[usize, IoError]
	{
		var count = data.length
		if count > largestTransfer
			count = largestTransfer
		
		loop
		{
			val result = writeFile(self.descriptor, data.data, count)
			if result >= 0
				ret ok(usize(result))
			
			val code = lastError()
			if code != interrupted
				ret err(errorFrom(code))
		}
	}
	
	seek: fun(self, target: SeekFrom) -> Result[u64, IoError]
	{
		val distance = match target
		{
			start(val offset) => i64(offset)
			current(val offset) => offset
			end(val offset) => offset
		}
		
		val origin = match target
		{
			start(_) => seekStart
			current(_) => seekCurrent
			end(_) => seekEnd
		}
		
		val position = seekFile(self.descriptor, distance, origin)
		if position < 0
			ret err(errorFrom(lastError()))
		
		ret ok(u64(position))
	}
	
	size: fun(self) -> Result[u64, IoError]
	{
		var status: Status
		if fstat(self.descriptor, @status) != 0
			ret err(errorFrom(lastError()))
		
		ret ok(u64(status.size))
	}
	
	metadata: fun(self) -> Result[Metadata, IoError]
	{
		var status: Status
		if fstat(self.descriptor, @status) != 0
			ret err(errorFrom(lastError()))
		
		ret ok(metadataOf(status))
	}
	
	sync: fun(self) -> Result[IoError]
	{
		while fsync(self.descriptor) != 0
		{
			val code = lastError()
			if code != interrupted
				ret err(errorFrom(code))
		}
		
		ret ok
	}
	
	close: fun(self)
	{
		closeFile(self.descriptor)
	}
}