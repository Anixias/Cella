mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Display: trait
{
	print: fun(self, spec: str)
}

str: impl Display
{
	print: fun(self, spec: str) = printf("%.*s", i32(self.byteLength), self.data)
}

i32: impl Display
{
	print: fun(self, spec: str)
	{
		if spec.byteLength == 1 && spec[0] == 120
			printf("%x", self)
		else
			printf("%d", self)
	}
}

say: fun(text: fstr[Display])
{
	var i: usize = 0
	while i < text.holes
	{
		text.piece(i).print("")
		text.value(i).print(text.spec(i))
		i += 1
	}

	text.piece(text.holes).print("")
}

dump: fun(text: fstr[Display])
{
	printf("%d holes:", i32(text.holes))
	var i: usize = 0
	while i <= text.holes
	{
		val piece = text.piece(i)
		printf(" '%.*s'", i32(piece.byteLength), piece.data)
		if i < text.holes
		{
			val spec = text.spec(i)
			printf(" [%.*s]", i32(spec.byteLength), spec.data)
		}

		i += 1
	}

	printf("\n")
}

Point: rec impl Display
{
	x: i32
	y: i32

	print: fun(self, spec: str) = say("({self.x}, {self.y})")
}

title: val str = "Cella"

next: fun(mut counter: i32) -> i32
{
	counter += 1
	ret counter
}

main: fun -> i32
{
	val name: str = "Ana"
	val spot = Point(3, 4)
	say("{name} is at {spot} with {10 * 5} hp\n")
	say(name)
	say("\n")
	say("{255:x} {255} {"text"} {title}\n")
	var counter = 0
	say("{next(mut counter)} {next(mut counter)} {counter}\n")
	dump("a{1}b{2:x}c{3:>8}d")
	dump("{1:a:b} \{ } {(counter + 1):}")
	dump("plain")
	dump("")
	ret 0
}
