mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Enemy: rec
{
	name: Buffer
	hp: i32
}

Label: ref rec
{
	buffer: imm[Buffer]
}

Party: rec
{
	members: array[Enemy, 2]
	leaderIndex: usize

	leader: fun(self) -> imm[Enemy] = imm self.members[self.leaderIndex]

	leaderMut: fun(mut self) -> mut[Enemy] = mut self.members[self.leaderIndex]

	strongest: fun(self) -> imm[Enemy]
	{
		if self.members[0].hp >= self.members[1].hp
			ret imm self.members[0]
		ret imm self.members[1]
	}

	find: fun(self, key: Buffer) -> imm[Enemy] = imm self.members[usize(key.id)]

	findMut: fun(mut self, mut key: Buffer) -> mut[Enemy]
	{
		key.id += 1
		ret mut self.members[usize(key.id)]
	}

	bufferOf: fun(self, label: Label) -> imm[Buffer] = label.buffer

	stronger: fun(a: Enemy, b: Enemy) -> imm[Enemy]
	{
		if a.hp >= b.hp
			ret imm a
		ret imm b
	}

	best: fun(self) -> imm[Enemy] = stronger(self.members[0], self.members[1])

	bestLeader: fun(self) -> imm[Enemy] = self.leader()
}

Slot: enum
{
	small(buffer: Buffer)
	large(buffer: Buffer, extra: i32)

	buffer: fun(self) -> imm[Buffer] = match self
	{
		small(buffer) => buffer
		large(buffer, extra) => buffer
	}
}

main: fun -> i32
{
	var party = Party([Enemy(Buffer(1), 5), Enemy(Buffer(2), 8)], 0)
	val leader = party.leader()
	printf("%d ", leader.name.id)

	party.leaderMut().hp += 10
	printf("%d %d ", party.strongest().name.id, party.members[0].hp)

	val found = party.find(Buffer(1))
	var key = Buffer(0)
	val again = party.findMut(mut key)
	key = Buffer(5)
	again.hp += 1
	printf("%d %d %d ", found.name.id, again.name.id, party.members[1].hp)

	var buffer = Buffer(9)
	val got = party.bufferOf(Label(imm buffer))
	printf("%d %d %d ", got.id, party.best().name.id, party.bestLeader().name.id)

	val slot = Slot.large(Buffer(7), 3)
	printf("%d\n", slot.buffer().id)
	ret 0
}
