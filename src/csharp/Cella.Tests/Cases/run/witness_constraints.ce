mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Hash: trait
{
	hash: fun(imm self) -> u64
}

Apply: trait
{
	keep[U: copy]: fun(imm self, value: U) -> U
	tagged[U: Hash]: fun(imm self, imm value: U) -> i32
	loose[U: noref]: fun(imm self, imm value: U) -> i32
	cap[const N: usize]: fun(imm self) -> usize
}

Point: rec impl Apply
{
	x: i32

	keep[V: copy]: fun(self, value: V) -> V => value
	tagged[V: Hash]: fun(self, imm value: V) -> i32 => 1
	loose[V]: fun(self, imm value: V) -> i32 => 2
	cap[const M: usize]: fun(self) -> usize => M
}

run[T: Apply]: fun(imm item: T) -> i32 => item.keep(5) + item.loose(1) + i32(item.cap[3]())

main: fun -> i32
{
	printf("%d\n", run(Point(1)))
	ret 0
}
