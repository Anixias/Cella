mod test

Slot: ref rec
{
	value: mut[i32]
}

Ring: rec
{
	first: i32

	as: op(mut self) -> Slot => Slot(mut self.first)
}

pass: fun(slot: Slot) -> Slot => slot

kept: fun -> Slot
{
	var ring = Ring(1)
	val slot: Slot = mut ring
	ret slot
}

passed: fun -> Slot
{
	var ring = Ring(1)
	ret pass(mut ring)
}

main: fun -> i32 => 0
