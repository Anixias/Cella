mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Color: ext enum { red, green, blue }
twice: ext fun(x: i32) -> i32 = x * 2

nullable[T: null]: enum match T
{
	none = null
	some(value) = else
}

main: fun -> i32
{
	printf("%d\n", Color.blue)
	printf("", twice)
	val f: ext fun[i32 -> i32] = twice
	printf("%d\n", i32(ptr(f) == ptr(twice)))
	val missing: nullable[ptr[i32]] = nullable[ptr[i32]].none
	printf("%p\n", missing)
	ret 0
}
