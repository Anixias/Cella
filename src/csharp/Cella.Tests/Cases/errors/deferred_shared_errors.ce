{
	val y = missing
	ret x * 2
})

pick: fun(imm f: fun[i32 -> i32]) -> i32 => f(1)
pick: fun(imm f: fun[i64 -> i32]) -> i32 => 2

tied: fun -> i32 => pick(fun(x) => 3)

main: fun -> i32 => 0
