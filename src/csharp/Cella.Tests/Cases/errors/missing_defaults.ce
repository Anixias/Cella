mod test

ext
{
	abs: fun(n: i32) -> i32
}

Effect: enum
{
	hit(amount: i32)
	none
}

Holder: rec
{
	effect: Effect
	count: i32
}

Handler: rec
{
	callback: fun(i32) -> i32
	scale: i32
}

amount: fun(effect: Effect) -> i32 = match effect { hit(n) => n  none => 0 }

direct: fun -> i32
{
	var effect: Effect
	ret amount(effect)
}

partial: fun(flag: bool) -> i32
{
	var effect: Effect
	if flag
		effect = Effect.none

	ret amount(effect)
}

record: fun -> i32
{
	var holder: Holder
	holder.count = 1
	ret amount(holder.effect) + holder.count
}

array: fun -> i32
{
	var effects: array[Effect, 2]
	effects[0] = Effect.none
	ret amount(effects[1])
}

callback: fun -> i32
{
	var f: fun(i32) -> i32
	ret f(1)
}

handler: fun -> i32
{
	var handler: Handler
	handler.scale = 3
	ret handler.callback(handler.scale)
}

callbacks: fun -> i32
{
	var callbacks: array[fun(i32) -> i32, 2]
	callbacks[0] = abs
	ret callbacks[1](4)
}

native: fun -> i32
{
	var f: ext fun(i32) -> i32
	ret f(-6)
}

main: fun -> i32 = 0
