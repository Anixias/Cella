<idea-plugin>
	<id>com.anixias.cella</id>
	<name>Cella</name>
	<vendor>Anixias</vendor>
	<description><![CDATA[Language support for Cella source (.ce) and project (.celp) files.]]></description>
	
	<depends>com.intellij.modules.platform</depends>
	<depends>com.intellij.modules.rider</depends>
	<depends>com.intellij.modules.spellchecker</depends>
	
	<extensions defaultExtensionNs="com.intellij">
		<fileType name="Cella" implementationClass="com.anixias.cella.CellaFileType" fieldName="INSTANCE"
		          language="Cella" extensions="ce"/>
		<fileType name="Cella Project" implementationClass="com.anixias.cella.CelpFileType" fieldName="INSTANCE"
		          language="CellaProject" extensions="celp"/>
		
		<lang.parserDefinition language="Cella" implementationClass="com.anixias.cella.psi.CellaParserDefinition"/>
		<lang.parserDefinition language="CellaProject"
		                       implementationClass="com.anixias.cella.psi.CelpParserDefinition"/>
		<lang.syntaxHighlighterFactory language="Cella"
		                               implementationClass="com.anixias.cella.highlighting.CellaHighlighterFactory"/>
		<lang.syntaxHighlighterFactory language="CellaProject"
		                               implementationClass="com.anixias.cella.highlighting.CelpHighlighterFactory"/>
		<colorSettingsPage implementation="com.anixias.cella.highlighting.CellaColorSettingsPage"/>
		<colorSettingsPage implementation="com.anixias.cella.highlighting.CelpColorSettingsPage"/>
		
		<lang.commenter language="Cella" implementationClass="com.anixias.cella.editor.CellaCommenter"/>
		<lang.commenter language="CellaProject" implementationClass="com.anixias.cella.editor.CelpCommenter"/>
		<lang.braceMatcher language="Cella" implementationClass="com.anixias.cella.editor.CellaBraceMatcher"/>
		<lang.braceMatcher language="CellaProject" implementationClass="com.anixias.cella.editor.CelpBraceMatcher"/>
		<lang.quoteHandler language="Cella" implementationClass="com.anixias.cella.editor.CellaQuoteHandler"/>
		<lang.quoteHandler language="CellaProject" implementationClass="com.anixias.cella.editor.CelpQuoteHandler"/>
		<spellchecker.support language="Cella"
		                      implementationClass="com.anixias.cella.editor.CellaSpellcheckingStrategy"/>
		<spellchecker.support language="CellaProject"
		                      implementationClass="com.anixias.cella.editor.CelpSpellcheckingStrategy"/>
		<lineIndentProvider implementation="com.anixias.cella.editor.CellaLineIndentProvider"/>
		<langCodeStyleSettingsProvider implementation="com.anixias.cella.editor.CellaCodeStyleSettingsProvider"/>
		<spellchecker.bundledDictionaryProvider implementation="com.anixias.cella.editor.CellaDictionaryProvider"/>
		
		<applicationConfigurable parentId="language" instance="com.anixias.cella.server.CellaConfigurable"
		                         id="com.anixias.cella" displayName="Cella"/>
		<notificationGroup id="Cella" displayType="BALLOON"/>
		<editorFactoryListener implementation="com.anixias.cella.server.CellaEditorListener"/>
		<externalAnnotator language="Cella" implementationClass="com.anixias.cella.server.CellaAnnotator"/>
		<externalAnnotator language="CellaProject" implementationClass="com.anixias.cella.server.CellaAnnotator"/>
		<platform.backend.documentation.targetProvider
				implementation="com.anixias.cella.server.CellaDocumentationTargetProvider"/>
		<gotoDeclarationHandler implementation="com.anixias.cella.server.CellaGotoDeclarationHandler"/>
		<annotator language="Cella" implementationClass="com.anixias.cella.server.CellaHoverAnnotator"/>
		<targetElementEvaluator language="Cella"
		                        implementationClass="com.anixias.cella.server.CellaTargetElementEvaluator"/>
		<psi.declarationProvider implementation="com.anixias.cella.server.CellaDeclarationProvider"/>
		<psi.implicitReferenceProvider implementation="com.anixias.cella.server.CellaReferenceProvider"/>
		<uiDataRule implementation="com.anixias.cella.server.CellaSearchTargetsRule"/>
		<searcher forClass="com.intellij.find.usages.api.UsageSearchParameters"
		          implementationClass="com.anixias.cella.server.CellaUsageSearcher"/>
		<completion.contributor language="Cella"
		                        implementationClass="com.anixias.cella.server.CellaCompletionContributor"/>
		<codeInsight.parameterInfo language="Cella"
		                           implementationClass="com.anixias.cella.server.CellaParameterInfoHandler"/>
		<typedHandler implementation="com.anixias.cella.server.CellaTypedHandler"/>
	</extensions>
</idea-plugin>
