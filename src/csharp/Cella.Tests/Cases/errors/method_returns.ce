mod test

Buffer: own rec
{
	id: i32

	drop: op
	{
	}
}

Enemy: own rec
{
	name: Buffer
	hp: i32
}

Stats: rec
{
	kills: i32
}

Label: ref rec
{
	buffer: imm[Buffer]
}

kills: fun(mut stats: Stats) -> mut[i32] => mut stats.kills

stronger: fun(imm a: Enemy, imm b: Enemy) -> imm[Enemy]
{
	if a.hp >= b.hp
		ret imm a
	ret imm b
}

Referee: own rec
{
	rounds: i32
	best: Enemy

	pick: fun(imm self, imm a: Enemy, imm b: Enemy) -> imm[Enemy]
	{
		if a.hp >= b.hp
			ret imm a
		ret imm b
	}

	count: fun(imm self, mut stats: Stats) -> mut[i32] => mut stats.kills

	pickStronger: fun(imm self, imm a: Enemy, imm b: Enemy) -> imm[Enemy] => stronger(imm a, imm b)

	countKills: fun(imm self, mut stats: Stats) -> mut[i32] => kills(mut stats)

	leaderOf: fun(imm self, imm other: Referee) -> imm[Enemy] => other.leader()

	keep: fun(imm self, enemy: Enemy) -> imm[Enemy] => imm enemy

	leader: fun(imm self) -> imm[Enemy] => imm self.best

	bufferOf: fun(imm self, label: Label) -> imm[Buffer] => label.buffer
}

Point: rec
{
	x: i32

	get: fun(imm self) -> imm[i32] => imm self.x

	take: fun(self) -> imm[i32] => imm self.x
}

Slot: own enum
{
	empty
	held(buffer: Buffer)

	orElse: fun(imm self, imm fallback: Buffer) -> imm[Buffer]
	{
		match self
		{
			held(val buffer) => ret buffer
			empty => ret fallback
		}
	}
}

show: fun(imm buffer: Buffer)
{
}

main: fun -> i32
{
	var referee = Referee(0, Enemy(Buffer(1), 5))
	val leader = referee.leader()
	referee = Referee(1, Enemy(Buffer(2), 6))
	show(imm leader.name)

	var buffer = Buffer(3)
	val got = referee.bufferOf(Label(imm buffer))
	buffer = Buffer(4)
	show(imm got)
	ret 0
}
