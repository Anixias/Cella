mod test

Buffer: own rec
{
	id: i32

	drop: op
	{
	}
}

show: fun(imm wrapper: Wrapper) -> i32 => 0
take: fun(buffer: Buffer) -> i32 => buffer.id
consume: fun(whole: Whole) -> i32 => 0

Wrapper: own rec
{
	buffer: Buffer
	count: i32

	drop: op
	{
		take(self.buffer)
		show(imm self)
		self.count = self.buffer.id
	}
}

Whole: own rec
{
	id: i32

	drop: op
	{
		consume(self)
	}
}

main: fun -> i32 => 0
