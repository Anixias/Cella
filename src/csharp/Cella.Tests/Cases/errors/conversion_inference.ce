mod test

View[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[const N: usize]: op(imm values: array[T, N]) -> View[T] => View[T](@values, N)
}

Span[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[const N: usize]: op(mut values: array[T, N]) -> Span[T] => Span[T](@values, N)
}

Triple: ref rec
{
	data: pvt ptr[u8]

	new: op(data: ptr[u8])
	{
		self.data = data
	}

	as: op(mut values: array[u8, 3]) -> Triple => Triple(@values)
}

wide: fun(values: View[u16]) {}

narrow: fun(values: View[u8]) {}

take: fun(values: Triple) {}

count[T]: fun(values: View[T]) -> usize => values.length

main: fun -> i32
{
	var four: array[i32, 4] = [1, 2, 3, 4]
	val t: Span[i32] = four
	var u: Span[i32] = mut four
	u = four

	val words = [1, 2]
	wide(words)
	narrow(words)

	var bytes = [1, 2]
	take(mut bytes)

	val n = count(5)
	ret 0
}
