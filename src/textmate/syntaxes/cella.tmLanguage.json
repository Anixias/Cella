{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Cella",
	"scopeName": "source.cella",
	"fileTypes": ["ce"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#modules" },
		{ "include": "#declarations" },
		{ "include": "#labels" },
		{ "include": "#strings" },
		{ "include": "#chars" },
		{ "include": "#numbers" },
		{ "include": "#annotations" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#calls" },
		{ "include": "#operators" },
		{ "include": "#punctuation" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.cella",
					"begin": "//",
					"beginCaptures": { "0": { "name": "punctuation.definition.comment.cella" } },
					"end": "$"
				},
				{ "include": "#block-comment" }
			]
		},
		"block-comment": {
			"name": "comment.block.cella",
			"begin": "/\\*",
			"beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.cella" } },
			"end": "\\*/",
			"endCaptures": { "0": { "name": "punctuation.definition.comment.end.cella" } },
			"patterns": [{ "include": "#block-comment" }]
		},
		"modules": {
			"patterns": [
				{
					"match": "^\\s*(mod)\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)\\s*(?=$|//|/\\*)",
					"captures": {
						"1": { "name": "keyword.other.mod.cella" },
						"2": { "name": "entity.name.namespace.cella" }
					}
				},
				{
					"match": "\\b(use)\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
					"captures": {
						"1": { "name": "keyword.other.use.cella" },
						"2": { "name": "entity.name.namespace.cella" }
					}
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"match": "^\\s*([A-Za-z_]\\w*)(?=\\s*(?:\\[.*?\\])?\\s*:\\s*(?:(?:pub|pvt|mod|ext(?:\\(\"[^\"]*\"\\))?|req|const|ref|own|dyn)\\s+)*(?:fun\\b(?!\\s*\\[)|(?:get|set|prop)\\b))",
					"captures": { "1": { "name": "entity.name.function.cella" } }
				},
				{
					"match": "^\\s*([A-Za-z_]\\w*)(?=\\s*(?:\\[.*?\\])?\\s*:\\s*(?:(?:pub|pvt|mod|ext|ref|own|copy|noref)\\s+)*(?:rec|enum|union|trait|impl)\\b)",
					"captures": { "1": { "name": "entity.name.type.cella" } }
				},
				{
					"match": "(?<![.\\w])(impl)\\s+([A-Za-z_]\\w*)",
					"captures": {
						"1": { "name": "storage.type.impl.cella" },
						"2": { "name": "entity.other.inherited-class.cella" }
					}
				}
			]
		},
		"labels": {
			"patterns": [
				{
					"match": "^\\s*([A-Za-z_]\\w*)\\s*(:)(?=\\s*(?:for|while|loop|do)\\b)",
					"captures": {
						"1": { "name": "entity.name.label.cella" },
						"2": { "name": "punctuation.separator.label.cella" }
					}
				},
				{
					"match": "\\b(break|cont)\\s+([A-Za-z_]\\w*)",
					"captures": {
						"1": { "name": "keyword.control.cella" },
						"2": { "name": "entity.name.label.cella" }
					}
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.cella",
			"begin": "\"",
			"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cella" } },
			"end": "(\")([A-Za-z]\\w*)?|$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.string.end.cella" },
				"2": { "name": "storage.type.string.cella" }
			},
			"patterns": [
				{ "include": "#escapes" },
				{ "include": "#interpolation" }
			]
		},
		"chars": {
			"name": "string.quoted.single.cella",
			"begin": "'",
			"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cella" } },
			"end": "(')([A-Za-z]\\w*)?|$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.string.end.cella" },
				"2": { "name": "storage.type.string.cella" }
			},
			"patterns": [{ "include": "#escapes" }]
		},
		"escapes": {
			"patterns": [
				{
					"name": "constant.character.escape.cella",
					"match": "\\\\(?:[\\\\'\"0abfnrtv{}]|o[0-7]{3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
				},
				{
					"name": "invalid.illegal.escape.cella",
					"match": "\\\\."
				}
			]
		},
		"interpolation": {
			"name": "meta.interpolation.cella",
			"begin": "\\{",
			"beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.cella" } },
			"end": "\\}|(?=$)",
			"endCaptures": { "0": { "name": "punctuation.section.interpolation.end.cella" } },
			"contentName": "source.cella.embedded",
			"patterns": [
				{
					"match": "(:)((?:[^}\\\\]|\\\\.)*)(?=\\})",
					"captures": {
						"1": { "name": "punctuation.separator.format.cella" },
						"2": { "name": "string.other.format.cella" }
					}
				},
				{ "include": "#nested-groups" },
				{ "include": "$self" }
			]
		},
		"nested-groups": {
			"patterns": [
				{
					"begin": "\\(",
					"beginCaptures": { "0": { "name": "punctuation.section.parens.begin.cella" } },
					"end": "\\)|(?=^\\s*[{}]|^[A-Za-z_\\[])",
					"endCaptures": { "0": { "name": "punctuation.section.parens.end.cella" } },
					"patterns": [{ "include": "#nested-groups" }, { "include": "$self" }]
				},
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.cella" } },
					"end": "\\]|(?=^\\s*[{}]|^[A-Za-z_\\[])",
					"endCaptures": { "0": { "name": "punctuation.section.brackets.end.cella" } },
					"patterns": [{ "include": "#nested-groups" }, { "include": "$self" }]
				},
				{
					"begin": "\\{",
					"beginCaptures": { "0": { "name": "punctuation.section.block.begin.cella" } },
					"end": "\\}",
					"endCaptures": { "0": { "name": "punctuation.section.block.end.cella" } },
					"patterns": [{ "include": "#nested-groups" }, { "include": "$self" }]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.cella",
					"match": "\\b0[xX][0-9A-Fa-f_]*([G-Zg-z_]\\w*)?",
					"captures": { "1": { "name": "storage.type.numeric.cella" } }
				},
				{
					"name": "constant.numeric.octal.cella",
					"match": "\\b0[oO][0-7_]*([A-Za-z_]\\w*)?",
					"captures": { "1": { "name": "storage.type.numeric.cella" } }
				},
				{
					"name": "constant.numeric.binary.cella",
					"match": "\\b0[bB][01_]*([A-Za-z_]\\w*)?",
					"captures": { "1": { "name": "storage.type.numeric.cella" } }
				},
				{
					"name": "constant.numeric.decimal.cella",
					"match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?([A-Za-z_]\\w*)?",
					"captures": { "1": { "name": "storage.type.numeric.cella" } }
				}
			]
		},
		"annotations": {
			"patterns": [
				{
					"match": "^\\s*([A-Za-z_]\\w*)\\s*(?=:\\s*(?:(?:pub|pvt|mod|val|var|const|ext|ref|own|dyn)\\s+)*fun\\s*\\[)",
					"captures": { "1": { "name": "variable.other.member.cella" } }
				},
				{
					"match": "\\b(val|var|const)\\s+([A-Za-z_]\\w*)\\s*(:)\\s*((?:(?:mut|own|imm|ref|dyn|ext)\\s+)*)(?!(?:fun|op)\\b)([A-Za-z_]\\w*)",
					"captures": {
						"1": { "name": "storage.type.cella" },
						"2": { "name": "variable.other.cella" },
						"3": { "name": "punctuation.separator.colon.cella" },
						"4": { "patterns": [{ "include": "#keywords" }] },
						"5": { "patterns": [{ "include": "#keywords" }, { "include": "#types" }, { "match": ".+", "name": "entity.name.type.cella" }] }
					}
				},
				{
					"match": "^\\s*([A-Za-z_]\\w*)\\s*(:)\\s*((?:(?:pub|pvt|mod|val|var|const|mut|own|imm|ref|dyn)\\s+)*)(?!(?:fun|op|get|set|prop|rec|enum|union|trait|impl|val|var|const|ext|req|for|while|loop|do)\\b)([A-Za-z_]\\w*)(?=\\s*(?:\\[|=|$|//|/\\*))",
					"captures": {
						"1": { "name": "variable.other.member.cella" },
						"2": { "name": "punctuation.separator.colon.cella" },
						"3": { "patterns": [{ "include": "#keywords" }] },
						"4": { "patterns": [{ "include": "#keywords" }, { "include": "#types" }, { "match": ".+", "name": "entity.name.type.cella" }] }
					}
				},
				{
					"begin": "(?<![.\\w])(fun|op|get|set|new)\\s*(\\()",
					"beginCaptures": {
						"1": { "patterns": [{ "include": "#keywords" }] },
						"2": { "name": "punctuation.section.parameters.begin.cella" }
					},
					"end": "\\)|(?=^\\s*[{}]|^[A-Za-z_\\[])",
					"endCaptures": { "0": { "name": "punctuation.section.parameters.end.cella" } },
					"patterns": [
						{
							"match": "(?:\\b(mut|own|imm|ref)\\s+)?([A-Za-z_]\\w*)\\s*(:)\\s*((?:(?:mut|own|imm|ref|dyn|ext)\\s+)*)(?!fun\\b)([A-Za-z_]\\w*)?",
							"captures": {
								"1": { "name": "storage.modifier.cella" },
								"2": { "name": "variable.parameter.cella" },
								"3": { "name": "punctuation.separator.colon.cella" },
								"4": { "patterns": [{ "include": "#keywords" }] },
								"5": { "patterns": [{ "include": "#keywords" }, { "include": "#types" }, { "match": ".+", "name": "entity.name.type.cella" }] }
							}
						},
						{ "include": "#nested-groups" },
						{ "include": "$self" }
					]
				},
				{
					"match": "(->)\\s*((?:(?:mut|own|imm|ref|dyn|ext)\\s+)*)(?!fun\\b)([A-Za-z_]\\w*)",
					"captures": {
						"1": { "name": "keyword.operator.arrow.cella" },
						"2": { "patterns": [{ "include": "#keywords" }] },
						"3": { "patterns": [{ "include": "#keywords" }, { "include": "#types" }, { "match": ".+", "name": "entity.name.type.cella" }] }
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.cella",
					"match": "\\b(?:if|else|for|in|loop|while|do|break|cont|ret|match|is|when|panic|atomic)\\b"
				},
				{
					"name": "keyword.other.drop.cella",
					"match": "\\bdrop\\b"
				},
				{
					"name": "keyword.operator.new.cella",
					"match": "\\bnew\\b"
				},
				{
					"name": "keyword.operator.expression.cella",
					"match": "\\b(?:sizeOf|alignOf|nameOf)\\b"
				},
				{
					"name": "storage.type.function.cella",
					"match": "\\bfun\\b"
				},
				{
					"name": "storage.type.function.cella",
					"match": "(?<![.\\w])(?:op|prop|get|set)\\b(?!\\s*\\[)"
				},
				{
					"name": "storage.type.cella",
					"match": "(?<![.\\w])(?:rec|enum|union|trait|impl)\\b"
				},
				{
					"name": "storage.type.cella",
					"match": "\\b(?:var|val|const)\\b"
				},
				{
					"name": "storage.modifier.cella",
					"match": "\\b(?:mut|own|imm|ref|dyn)\\b"
				},
				{
					"name": "storage.modifier.cella",
					"match": "(?<![.\\w])(?:pub|pvt|mod|ext|req|noref|copy)\\b"
				},
				{
					"name": "keyword.other.use.cella",
					"match": "(?<![.\\w])use\\b"
				},
				{
					"name": "keyword.other.as.cella",
					"match": "(?<![.\\w])as\\b"
				},
				{
					"name": "constant.language.cella",
					"match": "\\b(?:true|false|null|undef|default)\\b"
				},
				{
					"name": "variable.language.self.cella",
					"match": "\\bself\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "entity.name.type.self.cella",
					"match": "\\bSelf\\b"
				},
				{
					"name": "support.type.primitive.cella",
					"match": "(?<![.\\w])(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|char|bool|str|cstr|fstr|ptr|array|never)\\b"
				},
				{
					"name": "entity.name.type.cella",
					"match": "\\b[A-Z]\\w*\\b"
				}
			]
		},
		"calls": {
			"match": "\\b([A-Za-z_]\\w*)(?=\\s*(?:\\[[^\\]]*\\])?\\()",
			"captures": { "1": { "name": "entity.name.function.call.cella" } }
		},
		"operators": {
			"patterns": [
				{ "name": "keyword.operator.arrow.cella", "match": "->|=>" },
				{ "name": "keyword.operator.range.cella", "match": "\\.\\.\\.|\\.\\.=|\\.\\." },
				{ "name": "keyword.operator.assignment.compound.cella", "match": "<<<=|>>>=|<<=|>>=|\\+%=|-%=|\\*%=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=" },
				{ "name": "keyword.operator.bitwise.shift.cella", "match": "<<<|>>>|<<|>>" },
				{ "name": "keyword.operator.comparison.cella", "match": "==|!=|<=|>=" },
				{ "name": "keyword.operator.logical.cella", "match": "&&|\\|\\||!" },
				{ "name": "keyword.operator.arithmetic.cella", "match": "\\+%|-%|\\*%|\\+|-|\\*|/|%" },
				{ "name": "keyword.operator.bitwise.cella", "match": "&|\\||\\^|~" },
				{ "name": "keyword.operator.comparison.cella", "match": "<|>" },
				{ "name": "keyword.operator.assignment.cella", "match": "=" },
				{ "name": "keyword.operator.address.cella", "match": "@" },
				{ "name": "keyword.operator.question.cella", "match": "\\?" }
			]
		},
		"punctuation": {
			"patterns": [
				{ "name": "punctuation.separator.comma.cella", "match": "," },
				{ "name": "punctuation.separator.colon.cella", "match": ":" },
				{ "name": "punctuation.accessor.cella", "match": "\\." },
				{ "name": "punctuation.section.block.begin.cella", "match": "\\{" },
				{ "name": "punctuation.section.block.end.cella", "match": "\\}" },
				{ "name": "punctuation.section.parens.begin.cella", "match": "\\(" },
				{ "name": "punctuation.section.parens.end.cella", "match": "\\)" },
				{ "name": "punctuation.section.brackets.begin.cella", "match": "\\[" },
				{ "name": "punctuation.section.brackets.end.cella", "match": "\\]" }
			]
		}
	}
}
