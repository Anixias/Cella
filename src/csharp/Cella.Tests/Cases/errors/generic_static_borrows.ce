mod test

Slot[T]: enum
{
	empty
	full(value: T)
}

View: ref rec
{
	p: imm[i32]
}

Open[T]: rec
{
	value: T
	last: var Slot[T] = Slot[T].empty
	count: var i32 = 0
	pointer: var ptr[T] = null
}

Bounded[T: noref]: rec
{
	value: T
	last: var Slot[T] = Slot[T].empty
}

main: fun -> i32
{
	var local = 42
	Bounded[View].last = Slot[View].full(View(imm local))
	ret 0
}
