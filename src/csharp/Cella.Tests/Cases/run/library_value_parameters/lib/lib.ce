mod lib

ring[T, N: const usize]: pub rec
{
	items: array[T, N]
	used: usize

	capacity: get(imm self) -> usize => N
}

total[N: const usize]: pub fun(values: array[i32, N]) -> i32
{
	var sum = 0
	for value in values
		sum += value

	ret sum
}

Measured: pub trait
{
	measure: fun(imm self) -> usize
}

array[T, N: const usize]: impl Measured
{
	measure: fun(imm self) -> usize => N * 100
}
