mod test

Point: rec
{
	x: i32
}

Cell[T: atomic]: rec
{
	value: T

	bump: fun(self, amount: T) -> T => atomic *@self.value += amount
}

Plain[T]: rec
{
	value: T

	load: fun(imm self) -> T => atomic *@self.value
}

main: fun -> i32
{
	val a = Cell[Point](Point(1))
	val b = Cell[str]("x")
	val c = Cell[i128](1)
	ret 0
}
