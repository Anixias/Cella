mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Fixed: rec
{
	raw: u32

	<: op(a: u32, b: Fixed) -> bool => a < b.raw
}

Name: rec
{
	id: i32

	<: op(a: Name, b: Name) -> bool => a.id < b.id
	as: op(self) -> i32 => self.id
}

Level: rec
{
	value: i32

	as: op(self) -> i32 => self.value
}

Low: val bool = i32(-1) < u32(1) < u64(2)
High: val bool = i32(-1) > u32(1) > u64(0)

main: fun -> i32
{
	var neg: i32 = -1
	var one: u32 = 1
	var two: u64 = 2
	printf("%d %d %d\n", i32(neg < one < two), i32(one > neg > -5), i32(two < one < neg))
	var a: i32 = 1
	var f: f32 = 1.5
	printf("%d %d\n", i32(a < f < 2.0), i32(a < f < 1.25))
	val n = Name(3)
	printf("%d %d\n", i32(0 < n < 5), i32(0 < n < 2))
	val l = Level(2)
	printf("%d %d\n", i32(1 < l < 3), i32(1 < l < 2))
	val u: u32 = 4
	printf("%d %d\n", i32(neg < u < Fixed(10)), i32(neg < u < Fixed(3)))
	val wide: u64 = 9
	printf("%d %d\n", i32(a < 5 < wide), i32(a < 10 < wide))
	printf("%d %d\n", i32(Low), i32(High))
	ret 0
}
