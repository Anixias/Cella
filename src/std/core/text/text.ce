mod std.text

use std.[Hash, HashBuilder, View]
use std.cmp.Eq

Text[E: Encoding[T]]: pub ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	isEmpty: get(self) -> bool => self.length == 0

	new: op(units: View[T])
	{
		self.data = units.data
		self.length = units.length
	}

	as: op(self) -> View[T] => View[T](self.data, self.length)

	chars: fun(self) -> CharCursor[E] => CharCursor[E](View[T](self.data, self.length))
}

Text[E: Encoding[T: Eq]]: impl Eq
{
	==: op(imm left: Text[E], imm right: Text[E]) -> bool
	{
		if left.length != right.length
			ret false

		for i in 0..left.length
		{
			if left.data[i] != right.data[i]
				ret false
		}

		ret true
	}

	!=: op(imm left: Text[E], imm right: Text[E]) -> bool => !(left == right)
}

Text[E: Encoding[T]]: impl Hash
{
	hash[H: HashBuilder]: fun(imm self, mut hashBuilder: H) =>
		hashBuilder.writeBytes(...View[u8](ptr[u8](self.data), self.length * sizeOf(T)))
}

Text[Utf8]: impl
{
	as: op(self) -> str => str(self.data, self.length)
}