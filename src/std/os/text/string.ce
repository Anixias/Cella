mod std.text

use std.mem.[free, malloc]

String: pub own rec
{
	data: pvt ptr[u8]
	length: pvt set usize
	
	new: op(text: str)
	{
		val length = text.byteLength
		self.data = ptr[u8](malloc(length))
		if self.data == null
			panic "out of memory"
		
		self.length = length
		for i in 0..length
			*(self.data + i) = text[i]
	}
	
	as: op(imm self) -> str => str(self.data, self.length)
	
	drop: op
	{
		free(self.data)
	}
}