mod test

View[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}
}

typed: fun(callback: ext fun[cstr, ...View[i32]]) {}
alone: fun(callback: ext fun[...View[i32]]) {}
after: fun(callback: fun[...View[i32], i32]) {}
writes: fun(callback: fun[mut ...View[i32]]) {}
plain: fun(callback: fun[...i32]) {}

main: fun -> i32 => 0
