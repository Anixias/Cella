mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: enum
{
	none
	some(value: T)

	empty: fun -> Option[T] => Option[T].none

	of: fun(value: T) -> Option[T] => Option[T].some(value)
}

Pair[A, B]: rec
{
	a: A
	b: B

	make: fun(a: A, b: B) -> Pair[A, B] => Pair[A, B](a, b)
}

main: fun -> i32
{
	val o: Option[i32] = Option.empty()
	val s = Option.of(5)
	val p = Pair.make(1, 2.5)
	val n: Option[i64] = Option.of(7)
	val sv = match s { some(val v) => v, else => 0 }
	val nv = match n { some(val v) => v, else => 0i64 }
	printf("%d %d %d %.1f %lld %d\n", i32(o is none), sv, p.a, p.b, nv, sizeOf(n))
	ret 0
}
