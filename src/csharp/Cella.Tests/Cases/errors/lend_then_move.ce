mod test

Item: own rec
{
	id: i32

	drop: op
	{
	}

	poke: fun(mut self, other: Item)
	{
	}
}

Holder: own rec
{
	inner: Item
	other: Item
}

view: fun(imm item: Item, owned: Item)
{
}

change: fun(mut item: Item, owned: Item)
{
}

store: fun(mut holder: Holder, item: Item)
{
}

run: fun(imm f: fun[-> i32], owned: Item)
{
}

main: fun -> i32
{
	var item = Item(1)
	view(imm item, item)

	var changed = Item(2)
	change(mut changed, changed)

	var poked = Item(3)
	poked.poke(poked)

	var holder = Holder(Item(4), Item(5))
	store(mut holder, holder.other)

	val captured = Item(6)
	run(fun -> i32 => captured.id, captured)

	val first = Item(7)
	val second = Item(8)
	view(imm first, second)
	ret 0
}
