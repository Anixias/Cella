mod test

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Pair: rec
{
	left: Buffer
	right: Buffer
}

Wrapper: rec
{
	pair: Pair

	drop: op
	{
	}
}

take: fun(own buffer: Buffer) -> i32 = buffer.id

whole: fun(mut buffers: array[Buffer, 2])
{
	for mut buffer in buffers
		take(own buffer)
}

field: fun(mut pairs: array[Pair, 2])
{
	for mut pair in pairs
		take(own pair.left)
}

broken: fun(mut buffers: array[Buffer, 2])
{
	for mut buffer in buffers
	{
		val old = own buffer
		if old.id == 1
			break

		buffer = own old
	}
}

returned: fun(mut buffers: array[Buffer, 2]) -> i32
{
	for mut buffer in buffers
	{
		val old = own buffer
		if old.id == 1
			ret 1

		buffer = own old
	}

	ret 0
}

guarded: fun(mut wrappers: array[Wrapper, 2])
{
	for mut wrapper in wrappers
	{
		val left = own wrapper.pair.left
		wrapper.pair.left = own left
	}
}

readOnly: fun(mut buffers: array[Buffer, 2])
{
	for imm buffer in buffers
		take(own buffer)
}

refilled: fun(mut pairs: array[Pair, 2])
{
	for mut pair in pairs
	{
		val left = own pair.left
		pair.left = own pair.right
		pair.right = own left
	}
}

main: fun -> i32 = 0
