mod test

Point: rec
{
	x: i32
	y: i32
}

Empty: rec
{
}

Counter: rec
{
	count: i32
	new: op(start: i32)
	{
		self.count = start
	}
}

Effect: enum
{
	hit(amount: i32)
	none
}

Holder: rec
{
	effect: Effect
	count: i32
}

Handler: rec
{
	callback: fun[i32 -> i32]
	scale: i32
}

main: fun -> i32
{
	var a = Point(1)
	var b = Point(1, true)
	var c = Point(1, 2, 3)
	var d = Counter()
	var e = Empty(1)
	var f = Point(missing, 2)
	var g = Counter("abc")
	var h = Counter(Counter(1))
	var i = Holder()
	var j = Holder(Effect.none)
	var k = Handler()
	var l = File()
	ret 0
}

File: rec
{
	handle: req i32
	flags: i32
}
