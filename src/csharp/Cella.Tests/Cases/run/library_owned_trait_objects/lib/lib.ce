mod lib

ext
{
	printf: fun(format: cstr, ...) -> i32
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

boxed[K: trait]: pub rec
{
	object: ptr[dyn[K]]

	of[T: K]: fun(own value: T) -> boxed[K]
	{
		val memory = ptr[T](malloc(sizeOf(T)))
		own *memory = own value
		ret boxed[K](memory)
	}

	*: op(self) -> imm[dyn[K]] = imm *self.object

	drop: op
	{
		printf("free %zu\n", sizeOf(*self.object))
		drop *self.object
		free(self.object)
	}
}

Shape: pub trait
{
	area: fun(self) -> f64
}

Circle: pub rec impl Shape
{
	radius: f64

	area: fun(self) -> f64 = self.radius * 2.0
	drop: op
	{
		printf("circle gone\n")
	}
}

circle: pub fun(radius: f64) -> boxed[Shape] = boxed[Shape].of(Circle(radius))
