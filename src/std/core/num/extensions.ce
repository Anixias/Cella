mod std.num

use std.cmp.[Eq, Ord, Ordering]
use std.mem.Bitcast

Additive: pub trait req copy
{
	+: op(left: Self, right: Self) -> Self
	-: op(left: Self, right: Self) -> Self
}

Multiplicative: pub trait req copy
{
	*: op(left: Self, right: Self) -> Self
	/: op(left: Self, right: Self) -> Self
	%: op(left: Self, right: Self) -> Self
}

WrappedAdditive: pub trait req copy
{
	+%: op(left: Self, right: Self) -> Self
	-%: op(left: Self, right: Self) -> Self
}

WrappedMultiplicative: pub trait req copy
{
	*%: op(left: Self, right: Self) -> Self
}

Number: pub trait req Additive + Multiplicative + Ord
{
	minValue: const Self
	maxValue: const Self
	zero: const Self
	one: const Self
	
	compare: fun(imm left: Self, imm right: Self) -> Ordering
	{
		if (left == right)
			ret equal
		
		if (left < right)
			ret less
		
		ret greater
	}
	
	max: fun(imm a: Self, imm b: Self) -> Self
	min: fun(imm a: Self, imm b: Self) -> Self
	clamp: fun(imm x: Self, imm min: Self, imm max: Self) -> Self
	abs: fun(imm x: Self) -> Self
}

Integer: pub trait req Number + WrappedAdditive + WrappedMultiplicative

Float: pub trait req Number
{
	posInf: const Self
	negInf: const Self
	nan: const Self
	epsilon: const Self
	subnormal: const Self
	normal: const Self
	pi: const Self
	tau: const Self
	e: const Self
	
	approxEq: fun(imm a: Self, imm b: Self) -> bool
	lerp: fun(imm a: Self, imm b: Self, imm t: Self) -> Self
	isNan: fun(imm x: Self) -> bool
	isInf: fun(imm x: Self) -> bool
	isPosInf: fun(imm x: Self) -> bool
	isNegInf: fun(imm x: Self) -> bool
	isFinite: fun(imm x: Self) -> bool
	isZero: fun(imm x: Self) -> bool
	isSubnormal: fun(imm x: Self) -> bool
	isNormal: fun(imm x: Self) -> bool
	isPositive: fun(imm x: Self) -> bool
	isNegative: fun(imm x: Self) -> bool
}

i8: impl Integer
{
	minValue: const i8 = -0x80
	maxValue: const i8 =  0x7F
	zero: const i8 = 0
	one: const i8 = 1
	
	abs: fun(x: i8) -> i8 => x & maxValue
	min: fun(a: i8, b: i8) -> i8 => match a < b { true => a, else => b }
	max: fun(a: i8, b: i8) -> i8 => match a > b { true => a, else => b }
	
	clamp: fun(x: i8, min: i8, max: i8) -> i8
	{
		if min > max
			panic "{nameOf(clamp)}'s lower bound is greater than its upper bound"
		
		if x < min
			ret min
		
		if x > max
			ret max
		
		ret x
	}
}

u8: impl Integer
{
	minValue: const u8 = 0
	maxValue: const u8 = 0xFF
	zero: const u8 = 0
	one: const u8 = 1
	
	abs: fun(x: u8) -> u8 => x
	min: fun(a: u8, b: u8) -> u8 => match a < b { true => a, else => b }
	max: fun(a: u8, b: u8) -> u8 => match a > b { true => a, else => b }
	
	clamp: fun(x: u8, min: u8, max: u8) -> u8
	{
