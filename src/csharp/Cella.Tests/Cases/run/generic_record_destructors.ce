mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Token: rec
{
	id: i32

	drop: op
	{
		printf("drop %d ", self.id)
	}
}

consume: fun(own token: Token)
{
	printf("consume %d ", token.id)
}

Guard[T]: rec
{
	value: T
	label: Token

	drop: op
	{
		consume(own self.label)
	}
}

Inventory: rec
{
	main: Guard[Token]
	spare: Guard[i32]

	combine: fun(imm self, imm other: Guard[Token]) -> i32 => self.main.value.id + other.value.id
}

main: fun -> i32
{
	val inventory = Inventory(Guard[Token](Token(1), Token(2)), Guard[i32](3, Token(4)))
	val other = Guard[Token](Token(6), Token(7))
	printf("%d %zu | ", inventory.combine(imm other), sizeOf(Guard[i64]))
	ret 0
}
