mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}
trace: fun(value: i32) -> i32
{
	printf("[%d]", value)
	ret value
}

Point: rec
{
	x: i32

	==: op(left: Point, right: Point) -> bool = left.x == right.x
	!=: op(left: Point, right: Point) -> bool = left.x != right.x
}

main: fun -> i32
{
	val a = 1
	val b = 1
	val c = 2
	printf(" %d\n", i32(a == b == c))
	printf(" %d\n", i32(a == b != c))
	printf(" %d\n", i32(trace(1) == trace(1) == trace(1)))
	printf(" %d\n", i32(trace(1) == trace(2) == trace(3)))
	printf(" %d\n", i32(Point(3) == Point(3) == Point(3)))
	printf(" %d\n", i32(true == (a == b)))
	ret 0
}
