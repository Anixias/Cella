mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Point: rec
{
	x: i32
	y: i32
}

Span[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[const N: usize]: op(mut values: array[T, N]) -> Span[T] => Span[T](ptr[T](ptr(@values)), N)

	in: op(self) -> SpanCursor[T] => SpanCursor[T](self.data, self.length, 0, 0)
}

SpanCursor[T]: ref rec
{
	data: ptr[T]
	length: usize
	current: usize
	next: usize

	for: op(mut self) -> bool
	{
		self.current = self.next
		self.next += 1
		ret self.current < self.length
	}

	*: op(self) -> mut[T] => mut *(self.data + self.current)
}

double: fun(values: Span[i32])
{
	for mut value in values
	{
		value *= 2
	}
}

shift: fun(points: Span[Point], by: i32)
{
	for mut point in points
	{
		point.x += by
		point.y -= by
	}
}

main: fun -> i32
{
	var numbers = [1, 2, 3]
	double(mut numbers)
	val all: Span[i32] = mut numbers
	for mut value in all
	{
		value += 1
	}

	printf("%d %d %d\n", numbers[0], numbers[1], numbers[2])

	var points = [Point(1, 1), Point(5, 5)]
	shift(mut points, 2)
	printf("%d %d %d %d\n", points[0].x, points[0].y, points[1].x, points[1].y)
	ret 0
}
