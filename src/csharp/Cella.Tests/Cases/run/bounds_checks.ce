mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

pick: fun(index: usize) -> i32
{
	val values = [10, 20, 30]
	ret values[index]
}

main: fun -> i32
{
	printf("first %d\n", pick(0))
	printf("last %d\n", pick(2))
	printf("past %d\n", pick(3))
	ret 0
}

ext
{
	_write: fun(fd: i32, data: ptr, count: u32) -> i32
	fflush: fun(stream: ptr) -> i32
	exit: fun(code: i32) -> never
}

panic: op(message: str, location: str) -> never
{
	val prefix = "Panic at "
	val separator = ": "
	val newline = "\n"
	fflush(null)
	_write(2, prefix.data, u32(prefix.byteLength))
	_write(2, location.data, u32(location.byteLength))
	_write(2, separator.data, u32(separator.byteLength))
	_write(2, message.data, u32(message.byteLength))
	_write(2, newline.data, u32(newline.byteLength))
	exit(101)
}
