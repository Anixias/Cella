mod test
ext
{
	printf: fun(format: cstr, ...) -> i32
}

Color: enum
{
	red
	green
}
main: fun -> i32
{
	val s = str()
	val i = i32()
	val c = cstr()
	val b = bool()
	val f = f64()
	val p = ptr[u8]()
	val e = Color()
	val a = array[i32, 3]()
	printf("%zu %d %d %d %.1f %d %d %d\n", s.byteLength, i, i32(c == null), i32(b), f, i32(p == null), i32(e), a[2])
	ret 0
}
