mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Buffer: own rec
{
	id: i32

	new: op(id: i32)
	{
		self.id = id
	}

	drop: op
	{
		printf("drop %d\n", self.id)
	}
}

Holder: own rec
{
	buffer: Buffer
	count: i32
}

Effect: own enum
{
	none
	owned(buffer: Buffer)
}

same: fun(imm buffer: Buffer, address: ptr[Buffer]) -> bool => @buffer == address
keep: fun(count: i32) -> i32 => count
take: fun(buffer: Buffer) -> i32 => buffer.id
give: fun(buffer: Buffer) -> Buffer => buffer
flag: fun(value: bool) -> i32 => i32(value)

main: fun -> i32
{
	var count = 6
	val moved = count
	var other = 7
	val wide: i64 = other
	var third = 8
	printf("%d %lld %d\n", moved, wide, keep(third))

	var d = Buffer(9)
	val address = @d
	printf("%d %d\n", flag(same(imm d, address)), flag(same(imm give(d), address)))

	var values = [Buffer(10), Buffer(11)]
	val p = @values[0]
	val first = own *p
	var holder = Holder(Buffer(12), 13)
	val h = @holder
	val inner = own h.buffer
	printf("%d %d\n", first.id, inner.id)
	own *p = Buffer(30)
	own h.buffer = Buffer(31)

	val effect = Effect.owned(Buffer(14))
	if effect is owned(val buffer)
		printf("%d\n", buffer.id)

	var next = Effect.owned(Buffer(15))
	match next
	{
		owned(val buffer) => printf("%d\n", buffer.id)
		else => {}
	}

	var e = Buffer(16)
	val f = e
	var g = Buffer(17)
	val wrapped = Holder(g, 18)
	var k = Buffer(19)
	printf("%d %d %d %d\n", f.id, wrapped.buffer.id, take(k), give(Buffer(20)).id)

	var status = 0
	ret status
}
