mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Name: rec
{
	id: i32

	drop: op
	{
	}
}

Bag: rec
{
	items: array[Name, 3]

	in: op(imm self) -> BagCursor => BagCursor(imm self, 0, 0)
}

BagCursor: ref rec
{
	bag: imm[Bag]
	current: usize
	next: usize

	for: op(mut self) -> bool
	{
		self.current = self.next
		self.next += 1
		ret self.current < 3
	}

	*: op(self) -> imm[Name] => imm self.bag.items[self.current]
}

largest: fun(imm bag: Bag) -> i32
{
	var best: imm[Name] = bag.items[0]
	for imm name in bag
	{
		if name.id > best.id
			best = name
	}

	ret best.id
}

first: fun(imm bag: Bag) -> imm[Name]
{
	for imm name in bag
		ret name

	ret bag.items[0]
}

main: fun -> i32
{
	val bag = Bag([Name(4), Name(9), Name(2)])
	printf("%d %d\n", largest(imm bag), first(imm bag).id)
	ret 0
}
