mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

apply: fun(f: fun[-> i32]) -> i32 = f()

main: fun -> i32
{
	var values = [10, 20, 30]
	var total = 0
	for mut v in values
	{
		val get = fun -> i32 = v
		total += get() + apply(fun -> i32 = v)
		printf("%d\n", get())
	}

	printf("total %d\n", total)
	ret 0
}
