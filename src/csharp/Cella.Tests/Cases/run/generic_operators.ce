mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Counted[T]: rec
{
	value: T
	count: i32

	<: op(imm a: Counted[T], imm b: Counted[T]) -> bool => a.count < b.count
	+: op(a: Counted[T], extra: i32) -> Counted[T] => Counted(a.value, a.count + extra)
}

main: fun -> i32
{
	val a = Counted(1.5, 3)
	val b = Counted(2.5, 7)
	val c = a + 10
	printf("%d %d %d\n", i32(a < b), i32(b < a), c.count)
	ret 0
}
