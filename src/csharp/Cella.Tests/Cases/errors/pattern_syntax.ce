mod test

Option[T]: enum { none, some(value: T) }

E: enum { a, hit(n: i32) }

takes: fun(o: Option[i32]) -> i32 => 0

qualified: fun -> i32
{
	val o: Option[i32] = Option.some(1)
	if o is Option[i32].some(x)
		ret x

	ret 0
}

named: fun -> i32 => takes(Option[i32].none)

nested: fun -> i32
{
	val o: Option[Option[i32]] = Option.some(Option.some(1))
	if o is some(some(val v))
		ret v

	ret 0
}

ownMut: fun -> i32
{
	var e = E.hit(1)
	match own mut e
	{
		hit(n) => n += 5
		a => {}
	}

	ret 0
}

main: fun -> i32 => 0
