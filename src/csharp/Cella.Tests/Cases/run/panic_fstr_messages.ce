mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	exit: fun(code: i32) -> never
}

Display: trait
{
	print: fun(imm self)
}

str: impl Display
{
	print: fun(self) = printf("%.*s", i32(self.byteLength), self.data)
}

usize: impl Display
{
	print: fun(self) = printf("%zu", self)
}

panic: op(message: fstr[Display], location: str) -> never
{
	printf("Panic at %.*s: ", i32(location.byteLength), location.data)
	var i: usize = 0
	while i < message.holes
	{
		message.piece(i).print()
		message.value(i).print()
		i += 1
	}

	message.piece(message.holes).print()
	printf("\n")
	exit(3)
}

fetch: fun(i: usize) -> i32
{
	val a = [1, 2, 3]
	if i > 4
		panic "index {i} is too large"

	ret a[i]
}

main: fun -> i32
{
	printf("%d\n", fetch(1))
	ret fetch(9)
}
