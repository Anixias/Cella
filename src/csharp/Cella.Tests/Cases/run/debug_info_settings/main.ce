mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	strrchr: fun(text: ptr, character: i32) -> ptr
}

ext("kernel32")
{
	GetCurrentProcess: fun -> ptr
	GetModuleFileNameA: fun(module: ptr, path: ptr, size: u32) -> u32
	RtlCaptureStackBackTrace: fun(skip: u32, count: u32, frames: ptr, hash: ptr) -> u16
}

ext("dbghelp")
{
	SymInitialize: fun(process: ptr, path: ptr, invade: i32) -> i32
	SymFromAddr: fun(process: ptr, address: u64, displacement: ptr, symbol: ptr) -> i32
}

Path: rec
{
	text: array[u8, 520]
}

SymbolInfo: rec
{
	sizeOfStruct: u32
	typeIndex: u32
	reserved: array[u64, 2]
	index: u32
	size: u32
	modBase: u64
	flags: u32
	value: u64
	address: u64
	register: u32
	scope: u32
	tag: u32
	nameLength: u32
	maxNameLength: u32
	name: array[u8, 256]
}

main: fun -> i32
{
	val process = GetCurrentProcess()
	var path = Path()
	GetModuleFileNameA(null, @path, 520)
	*ptr[u8](strrchr(@path, 92)) = 0
	SymInitialize(process, @path, 1)

	var frame: u64 = 0
	RtlCaptureStackBackTrace(0, 1, @frame, null)
	var symbol = SymbolInfo()
	symbol.sizeOfStruct = 88
	symbol.maxNameLength = 255
	if SymFromAddr(process, frame, null, @symbol) == 0
	{
		printf("unnamed\n")
	}
	else
	{
		printf("%s\n", @symbol.name)
	}

	ret 0
}
