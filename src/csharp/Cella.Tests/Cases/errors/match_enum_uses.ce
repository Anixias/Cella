mod test

Nullable[T: null]: enum match T
{
	none = null
	some(value) = else
}

Socket: enum match i32
{
	invalid = -1
	valid(handle) = else
}

Point: rec
{
	x: i32
}

wrap[T: null]: fun(value: T) -> Nullable[T] => some(value)

unwrap[T: null]: fun(imm n: Nullable[T]) -> T => T(n)

describe: fun(s: Socket) -> i32 => match s { valid(val h) => h }

main: fun -> i32
{
	val a = wrap(5)
	val b = wrap[Point](Point(1))
	var s = Socket(3)
	match mut s
	{
		valid(val h) => h = 4
		invalid => s = invalid
	}

	val raw = f32(s)
	ret 0
}
