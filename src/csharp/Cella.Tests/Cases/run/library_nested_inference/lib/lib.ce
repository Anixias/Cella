mod lib

Box[T]: pub rec
{
	value: T
}

Pair[A, B]: pub rec
{
	a: A
	b: B
}

Option[T]: pub enum
{
	none
	some(value: T)
}

wrap[T]: pub fun(value: T) -> Box[T] => Box(value)

both[T: copy]: pub fun(p: Pair[T, T]) -> T => p.a

total: pub fun(b: Box[i64]) -> i64 => b.value

pick: pub fun(o: Option[Box[i64]]) -> i64 => match o
{
	some(val b) => b.value
	none => -1
}
