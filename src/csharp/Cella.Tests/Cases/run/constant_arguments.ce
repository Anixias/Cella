mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

Buffer: rec
{
	data: req ptr
	size: usize

	new: op(size: usize)
	{
		self.data = malloc(size)
		self.size = size
	}

	grow: fun(mut self, extra: usize)
	{
		self.size += extra
	}

	+=: op(mut self, extra: usize)
	{
		self.size += extra
	}

	drop: op
	{
		free(self.data)
	}
}

Shape: enum
{
	circle(radius: usize)
	square(side: f32)
}

area: fun(width: f32) -> f32 = width * width
area: fun(width: f32, height: f32) -> f32 = width * height

pick: fun(value: i64) -> i32 = 64
pick: fun(value: usize) -> i32 = 1

takesSize: fun(value: usize) -> usize = value
takesU8: fun(value: u8) -> u8 = value
takesI64: fun(value: i64) -> i64 = value
takesIsize: fun(value: isize) -> isize = value

identity[T]: fun(own value: T) -> T = value

main: fun -> i32
{
	val first = malloc(4 * 2)
	val second = malloc(sizeOf(i32) * 2 + alignOf(i64))
	free(first)
	free(second)

	var buffer = Buffer(16 * 4)
	buffer.grow(1 << 3)
	buffer += 2 * 3
	printf("%llu\n", buffer.size)

	val sized: fun[usize -> usize] = takesSize
	printf("%llu %llu\n", sized(1 << 40), takesSize((3 + 4) * 2 - 1))
	printf("%.2f %.2f\n", area(1.5 * 2.0), area(0.5 * 3.0, 2.0 / 4.0))
	printf("%d %d %lld %lld\n", takesU8(~5), takesU8(+7), takesI64(2147483647 + 1), takesIsize(-(4 * 2)))
	printf("%d %d %d\n", identity(4 * 2), pick(4 * 2), 3 + 4 * 5)

	val shape = Shape.circle(3 * 3)
	if shape is circle(radius)
		printf("%llu\n", radius)

	val total: usize = (3 + 4) * 2
	val mixed: u8 = takesU8(1) + (2 + 3)
	printf("%llu %d\n", total, mixed)
	ret 0
}
