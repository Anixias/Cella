mod test

empty: fun -> str
{
	ret "x{}y"
}

extra: fun -> str
{
	ret "x{"a" "b"}y"
}

operand: fun -> str
{
	ret "x{"a" +}y"
}

unterminated: fun -> str
{
	ret "x{"a"
}

missingValue: fun -> str
{
	ret "x{:spec}y"
}

badSpec: fun -> str
{
	ret "x{"a":\q}y"
}

openSpec: fun -> str
{
	ret "x{"a":spec
}

main: fun -> i32
{
	ret 0
}
