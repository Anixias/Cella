mod test

Cell[Element: noref]: rec
{
	value: Element
}

Wrap[T]: rec
{
	value: T
}

Wrap[T: noref]: impl
{
	size: fun(imm self) -> i32 => 1
}

Token: ref rec
{
	text: imm[i32]
}

keep[T: noref]: fun(value: T) -> T => value

main: fun -> i32
{
	val tokens: Cell[Token] = undef
	val kept = keep("lit")
	val n = 5
	val w = Wrap(Token(imm n))
	val size = w.size()
	ret 0
}
