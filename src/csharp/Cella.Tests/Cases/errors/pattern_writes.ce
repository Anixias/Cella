mod test

Effect: enum
{
	none
	hit(amount: i32)
}

make: fun -> Effect = Effect.hit(1)

readOnly: fun(e: Effect)
{
	if mut e is hit(n)
		n = 1
}

main: fun -> i32
{
	val fixed = Effect.hit(1)
	match mut fixed
	{
		hit(n) => n += 1
		else => {}
	}

	if fixed is hit(mut n)
		n = 2

	match mut make()
	{
		hit(n) => n += 1
		else => {}
	}

	var e = Effect.hit(1)
	if e is hit(n)
		n = 5

	ret 0
}
