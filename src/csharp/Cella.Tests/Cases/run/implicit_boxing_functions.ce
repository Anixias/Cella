mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

Boxed[K: trait]: own rec
{
	object: pvt ptr[dyn[K]]

	of[T: K + noref]: fun(value: T) -> Boxed[K]
	{
		val memory = ptr[T](malloc(sizeOf(T)))
		own *memory = value
		ret Boxed[K](memory)
	}

	as[T: K + noref]: op(value: T) -> Boxed[K] => Boxed[K].of(value)

	*: op(imm self) -> imm[dyn[K]] => imm *self.object

	drop: op
	{
		drop *self.object
		free(self.object)
	}
}

twice: fun(x: i32) -> i32 => x * 2

run: fun(f: Boxed[fun[i32 -> i32]], x: i32) -> i32 => f(x)

main: fun -> i32
{
	val step = 3
	val named: Boxed[fun[i32 -> i32]] = twice
	val plain: Boxed[fun[i32 -> i32]] = fun(x: i32) -> i32 => x + 1
	val captured: Boxed[fun[i32 -> i32]] = own fun(x: i32) -> i32 => x + step
	printf("%d %d %d %d %d\n", named(5), plain(5), captured(5), run(twice, 4), run(fun(x: i32) -> i32 => x - 1, 4))
	ret 0
}
