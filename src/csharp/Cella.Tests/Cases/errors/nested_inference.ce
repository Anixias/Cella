mod test

Box[T]: rec
{
	value: T
}

Pair[A, B]: rec
{
	a: A
	b: B
}

Option[T]: enum
{
	none
	some(value: T)
}

Wide: rec
{
	kind: i32

	new: op(p: Pair[i64, f64])
	{
		self.kind = 1
	}

	new: op(p: Pair[f64, i64])
	{
		self.kind = 2
	}
}

wrap[T]: fun(value: T) -> Box[T] => Box(value)
takesBox64: fun(b: Box[i64]) -> i64 => b.value
take: fun(p: Pair[i64, f64]) -> i32 => 1
take: fun(p: Pair[f64, i64]) -> i32 => 2
both[T: copy]: fun(p: Pair[T, T]) -> T => p.a

main: fun -> i32
{
	val small: i32 = 1
	val a = take(Pair(1, 2))
	val b = Wide(Pair(1, 2))
	val c = takesBox64(Box("a"))
	val d = takesBox64(wrap(small))
	val e = takesBox64(Box(small))
	val f = both(Pair(1, "s"))
	val g = Box(none)
	ret 0
}
