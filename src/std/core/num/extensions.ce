mod std.num

use std.cmp.[Eq, Ord, Ordering]
use std.mem.Bitcast

Additive: pub trait req copy
{
	+: op(left: Self, right: Self) -> Self
	-: op(left: Self, right: Self) -> Self
}

Multiplicative: pub trait req copy
{
	*: op(left: Self, right: Self) -> Self
	/: op(left: Self, right: Self) -> Self
	%: op(left: Self, right: Self) -> Self
}

WrappedAdditive: pub trait req copy
{
	+%: op(left: Self, right: Self) -> Self
	-%: op(left: Self, right: Self) -> Self
}

WrappedMultiplicative: pub trait req copy
{
	*%: op(left: Self, right: Self) -> Self
}

Number: pub trait req Additive + Multiplicative + Ord
{
	minValue: const Self
	maxValue: const Self
	zero: const Self
	one: const Self
	
	compare: fun(imm left: Self, imm right: Self) -> Ordering
	{
		if (left == right)
			ret equal
		
		if (left < right)
			ret less
		
		ret greater
	}
}

Integer: pub trait req Number + WrappedAdditive + WrappedMultiplicative

Float: pub trait req Number
{
	posInf: const Self
	negInf: const Self
	nan: const Self
	epsilon: const Self
	subnormal: const Self
	normal: const Self
	
	approxEq: fun(imm left: Self, imm right: Self) -> bool
	max: fun(imm left: Self, imm right: Self) -> Self
	min: fun(imm left: Self, imm right: Self) -> Self
	abs: fun(imm value: Self) -> Self
}

i8: impl Integer
{
	minValue: const i8 = -0x80
	maxValue: const i8 =  0x7F
	zero: const i8 = 0
	one: const i8 = 1
}

u8: impl Integer
{
	minValue: const u8 = 0
	maxValue: const u8 = 0xFF
	zero: const u8 = 0
	one: const u8 = 1
}

i16: impl Integer
{
	minValue: const i16 = -0x8000
	maxValue: const i16 =  0x7FFF
	zero: const i16 = 0
	one: const i16 = 1
}

u16: impl Integer
{
	minValue: const u16 = 0
	maxValue: const u16 = 0xFFFF
	zero: const u16 = 0
	one: const u16 = 1
}

i32: impl Integer
{
	minValue: const i32 = -0x80000000
	maxValue: const i32 =  0x7FFFFFFF
	zero: const i32 = 0
	one: const i32 = 1
}

u32: impl Integer
{
	minValue: const u32 = 0
	maxValue: const u32 = 0xFFFFFFFF
	zero: const u32 = 0
	one: const u32 = 1
}

i64: impl Integer
{
	minValue: const i64 = -0x80000000_00000000
	maxValue: const i64 =  0x7FFFFFFF_FFFFFFFF
	zero: const i64 = 0
	one: const i64 = 1
}

u64: impl Integer
{
	minValue: const u64 = 0
	maxValue: const u64 = 0xFFFFFFFF_FFFFFFFF
	zero: const u64 = 0
	one: const u64 = 1
}

i128: impl Integer
{
	minValue: const i128 = -0x80000000_00000000_00000000_00000000
	maxValue: const i128 =  0x7FFFFFFF_FFFFFFFF_FFFFFFFF_FFFFFFFF
	zero: const i128 = 0
	one: const i128 = 1
}

u128: impl Integer
{
	minValue: const u128 = 0
	maxValue: const u128 = 0xFFFFFFFF_FFFFFFFF_FFFFFFFF_FFFFFFFF
	zero: const u128 = 0
	one: const u128 = 1
}

isize: impl Integer
{
	minValue: const isize = -isize.maxValue - 1
	maxValue: const isize = isize(usize.maxValue >> 1)
	zero: const isize = 0
	one: const isize = 1
}

usize: impl Integer
{
	minValue: const usize = 0
	maxValue: const usize = ~0
	zero: const usize = 0
	one: const usize = 1
}

f32: impl Float
{
	minValue: const f32 = Bitcast[u32, f32](0xFF7FFFFFu32).to
	maxValue: const f32 = Bitcast[u32, f32](0x7F7FFFFFu32).to
	zero: const f32 = 0
	one: const f32 = 1
	posInf: const f32 = Bitcast[u32, f32](0x7F800000u32).to
	negInf: const f32 = Bitcast[u32, f32](0xFF800000u32).to
	nan: const f32 = Bitcast[u32, f32](0x7FC00000u32).to
	epsilon: const f32 = Bitcast[u32, f32](0x34000000u32).to
	subnormal: const f32 = Bitcast[u32, f32](0x00000001u32).to
	normal: const f32 = Bitcast[u32, f32](0x00800000u32).to

	approxEq: fun(a: f32, b: f32) -> bool => abs(a - b) <= epsilon * max(abs(a), abs(b))

	min: fun(a: f32, b: f32) -> f32 => match a < b { true => a, else => b }
	max: fun(a: f32, b: f32) -> f32 => match a > b { true => a, else => b }
	abs: fun(x: f32) -> f32 => max(x, -x)
}

f64: impl Float
{
	minValue: const f64 = Bitcast[u64, f64](0xFFEFFFFFFFFFFFFFu64).to
	maxValue: const f64 = Bitcast[u64, f64](0x7FEFFFFFFFFFFFFFu64).to
	zero: const f64 = 0
	one: const f64 = 1
	posInf: const f64 = Bitcast[u64, f64](0x7FF0000000000000u64).to
	negInf: const f64 = Bitcast[u64, f64](0xFFF0000000000000u64).to
	nan: const f64 = Bitcast[u64, f64](0x7FF8000000000000u64).to
	epsilon: const f64 = Bitcast[u64, f64](0x3CB0000000000000u64).to
	subnormal: const f64 = Bitcast[u64, f64](0x0000000000000001u64).to
	normal: const f64 = Bitcast[u64, f64](0x0010000000000000u64).to

	approxEq: fun(a: f64, b: f64) -> bool => abs(a - b) <= epsilon * max(abs(a), abs(b))

	min: fun(a: f64, b: f64) -> f64 => match a < b { true => a, else => b }
	max: fun(a: f64, b: f64) -> f64 => match a > b { true => a, else => b }
	abs: fun(x: f64) -> f64 => max(x, -x)
}