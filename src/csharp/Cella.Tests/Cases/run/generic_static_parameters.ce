mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Ring[T, const N: usize]: rec
{
	items: array[T, N]

	capacity: const usize = N
	elementSize: const usize = sizeOf(T)
	alignment: val usize = alignOf(T)
	bytes: const usize = capacity * elementSize
	made: var usize = N * 2

	total: fun(imm self) -> usize => capacity + made
}

main: fun -> i32
{
	printf("%zu %zu %zu\n", Ring[i32, 4].capacity, Ring[i64, 8].elementSize, Ring[i16, 3].bytes)
	Ring[i32, 4].made += 1
	printf("%zu %zu\n", Ring[i32, 4].made, Ring[i32, 5].made)
	val r = Ring[u8, 2]([1u8, 2u8])
	printf("%zu\n", r.total())
	val arr: array[i32, Ring[i32, 6].capacity] = [1, 2, 3, 4, 5, 6]
	printf("%d %zu\n", arr[5], Ring[i64, 1].alignment)
	ret 0
}
