mod game

step: mod fun(value: i32) -> i32 => value + 1

Counter[T]: rec
{
	value: T
	steps: i32
	created: var i32 = 0

	bump: fun(mut self)
	{
		self.steps = step(self.steps)
		created += 1
	}
}

Pair[A, B]: rec
{
	first: A
	second: B
	id: pvt i32

	new: op(own first: A, own second: B, id: i32)
	{
		self.first = own first
		self.second = own second
		self.id = id
	}

	sameId: fun(imm self, imm other: Pair[A, B]) -> bool => self.id == other.id

	flippedId: fun(imm self, imm other: Pair[B, A]) -> bool => self.id == other.id
}

Wrapper[T: noref]: rec
{
	inner: util.Cell[T]

	new: op(own value: T)
	{
		self.inner = util.Cell[T](own value)
	}

	hits: fun(imm self) -> i32 => self.inner.hits
}

peek: fun -> i32
{
	var local = Counter[i64](2, 0)
	local.bump()
	ret local.steps
}
