mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Show: trait
{
	show: fun(imm self) -> i32
}

pick[T]: fun(imm x: T, imm y: T) -> i32 = 2
pick[T]: fun(imm x: T) -> i32 = 1

pair[T, U]: fun(imm x: T, imm y: U) -> i32 = 3
pair[T]: fun(imm x: T, imm y: T, imm z: T) -> i32 = 4

shown[T: Show]: fun(imm x: T) -> i32 = 5
shown[T]: fun(imm x: T, y: i32) -> i32 = 6

main: fun -> i32
{
	printf("%d %d %d %d %d\n", pick(1), pick(1, 2), pair(1, 2.0), pair(1, 2, 3), shown(1, 2))
	ret 0
}
