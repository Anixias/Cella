mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Counted[T]: rec
{
	value: T
	made: var i32 = 0
	limit: val i32 = 3
	none: val ptr[T] = null
	seed: pvt var i32 = 7

	new: op(value: T)
	{
		self.value = value
		made += 1
	}

	total: get -> i32 => made

	reseed: fun -> i32
	{
		seed += 1
		ret seed
	}

	isEmpty: fun -> bool => none == null
}

main: fun -> i32
{
	val a = Counted[i32](1)
	val b = Counted[i32](2)
	val c = Counted[i64](3)
	Counted[bool].made = 10
	Counted[i32].reseed()
	printf("%d %d %d %d %d %d\n", Counted[i32].made, Counted[i64].made, Counted[bool].total, Counted[i8].limit,
		Counted[i32].reseed(), Counted[i64].reseed())
	if Counted[i16].isEmpty() && Counted[i32].none == null
		printf("empty\n")

	ret 0
}
