mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Box[T]: rec
{
	value: T
}

Pair[A, B]: rec
{
	a: A
	b: B
}

Option[T]: enum
{
	none
	some(value: T)
}

Shelf[T: noref]: rec
{
	item: T

	put: fun(mut self, own item: T)
	{
		self.item = own item
	}
}

Holder: rec
{
	b: Box[i64]
}

Pick: rec
{
	kind: i32

	new: op(b: Box[i64])
	{
		self.kind = 64
	}

	new: op(b: Box[str])
	{
		self.kind = 1
	}
}

PairOf[T]: rec
{
	a: Box[T]
	b: Box[T]
}

wrap[T]: fun(own value: T) -> Box[T] => Box(own value)
id[T]: fun(own value: T) -> T => value
sizeOfArg[T]: fun(own value: T) -> usize => sizeOf(T)
takesBox64: fun(b: Box[i64]) -> i64 => b.value
takesI64: fun(value: i64) -> i64 => value

takesOpt64: fun(o: Option[i64]) -> i64 => match o
{
	some(val v) => v
	none => -1
}

take: fun(b: Box[i64]) -> i32 => 64
take: fun(b: Box[str]) -> i32 => 1
twice: fun(value: i32) -> i32 => 32
twice: fun(value: i64) -> i32 => 64
both[T: copy]: fun(p: Pair[T, T]) -> T => p.a
first[T: copy]: fun(b: Box[T]) -> T => b.value
sumAll: fun(values: array[i64, 3]) -> i64 => values[0] + values[1] + values[2]
boxes: fun(values: array[Box[i64], 2]) -> i64 => values[0].value + values[1].value
wideBox: fun(b: Box[i64]) -> i32 => 64
wideBox: fun(b: Box[f64]) -> i32 => 1
smallBox: fun(b: Box[i8]) -> i32 => 8
smallBox: fun(b: Box[u8]) -> i32 => 2
total: fun(values: array[i64, 2]) -> i32 => 64
total: fun(values: array[f64, 2]) -> i32 => 1

unwrapOr[T: copy]: fun(o: Option[T], fallback: T) -> T => match o
{
	some(val v) => v
	none => fallback
}

relay[U: copy]: fun(value: U) -> U
{
	val inner = first(Box(value))
	ret unwrapOr(Option.some(inner), value)
}

lift[U: copy]: fun(value: U) -> Box[Box[U]] => Box(Box(value))

main: fun -> i32
{
	printf("%lld %lld\n", takesBox64(Box(1)), takesBox64(wrap(2)))
	printf("%lld %lld %lld\n", takesOpt64(Option.some(3)), takesOpt64(some(4)), takesOpt64(none))

	var shelf = Shelf[Box[i64]](Box[i64](0))
	shelf.put(Box(5))
	printf("%lld %d %d\n", shelf.item.value, take(Box(6)), take(Box("a")))

	val nested: Box[Option[i64]] = Box(some(7))
	printf("%lld %lld\n", unwrapOr(nested.value, 0), both(Pair(1, i64(2))))

	val y: i64 = first(Box(8))
	val r: Box[i64] = id(Box(9))
	printf("%lld %lld %lld\n", y, r.value, takesBox64(id(Box(10))))
	printf("%lld %lld\n", sumAll([1, 2, 3]), boxes([Box(4), Box(5)]))

	val f: fun[Box[i64] -> i64] = takesBox64
	printf("%lld %zu\n", f(Box(11)), sizeOfArg(1))
	printf("%lld %d\n", Holder(Box(12)).b.value, Pick(Box(13)).kind)

	val p = PairOf(Box(1), Box(i64(2)))
	printf("%zu %d %d\n", sizeOfArg(p.a.value), twice(1), takesI64(twice(1)))
	printf("%lld %d %lld\n", relay(i64(14)), unwrapOr(none, 15), lift(i64(16)).value.value)
	printf("%d %d %d\n", wideBox(Box(17)), smallBox(Box(18)), total([19, 20]))
	ret 0
}
