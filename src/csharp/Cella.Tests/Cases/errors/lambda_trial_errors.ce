mod test

apply: fun(imm f: fun[i32 -> i32]) -> i32 => f(1)
apply: fun(imm f: fun[bool -> i32]) -> i32 => f(true)

Option[T]: enum { none, some(value: T) }

read: fun(o: Option[i32]) -> i32 => 0
read: fun(o: Option[i64]) -> i32 => 1

missingName: fun -> i32 => apply(fun(x) => missing)

wrongResult: fun -> i32 => apply(fun(x) => "s")

wrongPayload: fun -> i32 => read(some("text"))

main: fun -> i32 => 0
