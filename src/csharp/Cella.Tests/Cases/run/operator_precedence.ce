mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Shape: enum { square, circle }

main: fun -> i32
{
	val s = Shape.square
	val a = 1 | 2 == 3
	val b = s is square == true
	val c = 6 & 3 < 4
	val d = 1 + 2 * 3 << 1
	val e = 1 ^ 3 & 2 | 4
	val f = 10 - 4 - 3
	val g = 2 * 3 % 4
	printf("%d %d %d %d %d %d %d\n", i32(a), i32(b), i32(c), d, e, f, g)
	ret 0
}
