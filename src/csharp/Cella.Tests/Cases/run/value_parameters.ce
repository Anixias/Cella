mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

count: const usize = 2

Ring[T: noref, const N: usize]: rec
{
	items: array[T, N]
	used: usize

	push: fun(mut self, value: T)
	{
		self.items[self.used] = value
		self.used += 1
	}

	capacity: get(imm self) -> usize => N
}

Ring[T: noref, const N: u8]: impl
{
	slots: fun(imm self) -> u8 => N
}

Holder[const N: usize]: rec
{
	items: array[i32, N]
}

Slot[const N: u8]: enum
{
	empty
	full(values: array[i32, N])
}

Sized[const N: usize]: trait
{
	size: fun(imm self) -> usize
}

Crate: rec impl Sized[3]
{
	value: i32

	size: fun(self) -> usize => 3
}

sum[const N: usize]: fun(values: array[i32, N]) -> i32
{
	var total = 0
	for value in values
		total += value

	ret total + i32(N)
}

echo[const N: usize]: fun(values: array[i32, N]) -> array[i32, N] => values

zeros[const N: usize]: fun -> array[i32, N] => Holder[N]().items

scaled[const N: usize]: fun(values: array[i32, N]) -> usize => N * 10

first[T: copy, const N: usize]: fun(values: array[T, N]) -> T => values[0]

make[const N: usize]: fun -> Ring[i32, N] => Ring[i32, N]()

wrap[const N: usize]: fun(values: array[i32, N]) -> Ring[i32, N]
{
	var result = make[N]()
	for value in values
		result.push(value)

	ret result
}

measure[T: Sized[3]]: fun(imm item: T) -> usize => item.size()

records: fun
{
	var small = Ring[i32, 4]()
	small.items[3] = 7
	val other = Ring[u8, count * 2]()
	printf("ring %d %d %d %d %d\n", i32(small.capacity), small.items[3], i32(other.items.length),
		i32(sizeOf(Ring[i64, 3])), i32(small.slots()))
}

functions: fun
{
	val three = [1, 2, 3]
	val five = [1, 2, 3, 4, 5]
	val made: array[i32, 4] = zeros()
	val explicit = zeros[2]()
	val echoed = echo[3](three)
	printf("functions %d %d %d %d %d %d %d\n", sum(three), sum(five), i32(made.length), i32(explicit.length),
		first(five), i32(scaled(three)), echoed[2])
}

nested: fun
{
	val built = wrap([5, 6, 7])
	val slot = Slot[2].full([8, 9])
	val second = match slot
	{
		full(val values) => values[1]
		empty => 0
	}

	printf("nested %d %d %d %d %d\n", i32(built.capacity), built.items[2], i32(built.used), second,
		i32(measure(Crate(1))))
}

main: fun -> i32
{
	records()
	functions()
	nested()
	ret 0
}
