mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

identity[T]: fun(own value: T) -> T = value

score[T]: fun(value: T) -> i32 = 7

apply: fun(value: i32, change: fun[own i32 -> i32]) -> i32 = change(value)

applyTwice[T]: fun(own value: T, change: fun[own T -> T]) -> T = change(change(value))

call: fun(callback: ext fun[i32 -> i32], value: i32) -> i32 = callback(value)

triple: fun(own value: i32) -> i32 = value * 3

main: fun -> i32
{
	val wide: fun[own i64 -> i64] = identity
	val narrow = identity[i16]
	val callback: ext fun[i32 -> i32] = score
	printf("%lld %d %d %d %d | ", wide(1), narrow(2), apply(3, identity), applyTwice(4, triple), applyTwice(5, identity))
	printf("%d %d\n", callback(6), call(score, 7))
	ret 0
}
