mod test

Buffer: own rec
{
	id: i32

	drop: op
	{
	}
}

Effect: own enum
{
	none
	hold(buffer: Buffer)
}

make: fun(id: i32) -> Effect => Effect.hold(Buffer(id))
take: fun(buffer: Buffer) -> i32 => buffer.id
touch: fun(mut buffer: Buffer)
{
}

used: fun -> i32
{
	val effect = make(1)
	match effect
	{
		hold(val buffer) => take(buffer)
		else => {}
	}

	match effect
	{
		hold(val buffer) => ret buffer.id
		else => ret 0
	}
}

parameter: fun(imm effect: Effect) -> i32
{
	match effect
	{
		hold(val buffer) => ret take(buffer)
		else => ret 0
	}
}

main: fun -> i32 => 0
