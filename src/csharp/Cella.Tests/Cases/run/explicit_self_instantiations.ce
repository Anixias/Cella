mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

identity[T]: fun(value: T, depth: i32) -> T
{
	if depth == 0
		ret value

	val f = identity[T]
	ret f(value, depth - 1)
}

first[A, B]: fun(a: A, b: B, depth: i32) -> A
{
	if depth == 0
		ret a

	val g = first[A, i32]
	ret g(a, 7, depth - 1)
}

other[U]: fun(value: U) -> U
{
	val h = identity[U]
	ret h(value, 2)
}

main: fun -> i32
{
	printf("%d %d %d\n", identity(5, 3), first(6, true, 2), other(8))
	ret 0
}
