mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Shape: enum
{
	circle(radius: i32)
	square(side: i32)
	empty

	==: op(a: Shape, b: Shape) -> bool => area(a) == area(b)
	<: op(a: Shape, b: Shape) -> bool => area(a) < area(b)
}

area: fun(s: Shape) -> i32 => match s { circle(val r) => 3 * r * r, square(val side) => side * side, empty => 0 }

main: fun -> i32
{
	val a: Shape = circle(2)
	val b: Shape = square(4)
	val c: Shape = square(3)
	printf("%d %d %d %d\n", i32(a == c), i32(a == b), i32(a < b), i32(c == empty))
	ret 0
}
