mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Empty: rec
{
}

count[T]: fun(begin: ptr[T], end: ptr[T]) -> isize => end - begin

guarded[T]: fun(begin: ptr[T], end: ptr[T]) -> isize
{
	if sizeOf(T) == 0
		ret 0

	ret end - begin
}

main: fun -> i32
{
	var numbers: array[i32, 4]
	var marks: array[Empty, 3]
	var raw = ptr(@numbers[0])
	printf("%lld %lld %lld %lld\n", count(@numbers[0], @numbers[3]), guarded(@numbers[1], @numbers[3]),
		guarded(@marks[0], @marks[2]), (raw + 8) - raw)
	printf("%lld\n", count(@marks[0], @marks[2]))
	ret 0
}

ext
{
	fflush: fun(stream: ptr) -> i32
	exit: fun(code: i32) -> never
}

when windows
{
	ext
	{
		write: ext("_write") fun(fd: i32, data: ptr, count: u32) -> i32
	}
}
else
{
	ext
	{
		write: fun(fd: i32, data: ptr, count: u32) -> i32
	}
}

panic: op(message: str, location: str) -> never
{
	val prefix = "Panic at "
	val separator = ": "
	val newline = "\n"
	fflush(null)
	write(2, prefix.data, u32(prefix.byteLength))
	write(2, location.data, u32(location.byteLength))
	write(2, separator.data, u32(separator.byteLength))
	write(2, message.data, u32(message.byteLength))
	write(2, newline.data, u32(newline.byteLength))
	exit(101)
}
