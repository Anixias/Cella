mod std.fs

use std.[Result, Span, View]
use std.containers.List
use std.io.[IoError, Read, Seek, SeekFrom, Write, readToEnd]

FileMode: pub enum
{
	open
	openOrCreate
	create
	createNew
	truncate
	append
}

FileAccess: pub enum
{
	read
	write
	readWrite
}

File: pub own rec impl Read + Write + Seek
{
	native: pvt NativeFile
	access: pvt FileAccess
	
	new: pvt op(native: NativeFile, access: FileAccess)
	{
		self.native = native
		self.access = access
	}
	
	drop: op
	{
		self.native.close()
	}
	
	open: fun(path: str, mode: FileMode = open, access: FileAccess = read) -> Result[File, IoError]
	{
		val changesFile = match mode
		{
			open, openOrCreate => false
			else => true
		}
		
		if changesFile && access is read
			ret err(IoError(invalidInput, 0))
		
		ret ok(File(NativeFile.open(path, mode, access)?, access))
	}
	
	read: fun(mut self, destination: Span[u8]) -> Result[usize, IoError]
	{
		if self.access is write
			ret err(IoError(permissionDenied, 0))
		
		ret self.native.read(destination)
	}
	
	write: fun(mut self, data: View[u8]) -> Result[usize, IoError]
	{
		if self.access is read
			ret err(IoError(permissionDenied, 0))
		
		ret self.native.write(data)
	}
	
	seek: fun(mut self, target: SeekFrom) -> Result[u64, IoError]
	{
		if target is start(val offset) && offset > u64(i64.maxValue)
			ret err(IoError(invalidInput, 0))
		
		ret self.native.seek(target)
	}
	
	size: fun(imm self) -> Result[u64, IoError] => self.native.size()
	
	sync: fun(mut self) -> Result[IoError]
	{
		if self.access is read
			ret ok
		
		ret self.native.sync()
	}
}

readBytes: pub fun(path: str) -> Result[List[u8], IoError]
{
	var file = File.open(path)?
	var bytes = List[u8]()
	bytes.reserve(usize(file.size()?))
	readToEnd(mut file, mut bytes)?
	ret ok(bytes)
}

writeBytes: pub fun(path: str, data: View[u8]) -> Result[IoError]
{
	var file = File.open(path, create, write)?
	ret file.writeAll(data)
}

appendBytes: pub fun(path: str, data: View[u8]) -> Result[IoError]
{
	var file = File.open(path, append, write)?
	ret file.writeAll(data)
}