mod test

N: rec
{
	id: i32

	drop: op
	{
	}
}

P: rec
{
	left: N
	right: N
}

take: fun(own n: N) -> i32 = n.id
show: fun(imm n: N) -> i32 = n.id
showP: fun(imm p: P) -> i32 = 0

loopUse: fun -> i32
{
	val a = N(1)
	for i in 0..3
	{
		show(imm a)
		take(own a)
	}

	ret 0
}

branches: fun(flag: bool) -> i32
{
	val p = P(N(1), N(2))
	if flag
		take(own p.left)
	else
		take(own p.right)

	ret showP(imm p)
}

maybe: fun(flag: bool) -> i32
{
	val a = N(1)
	if flag
		take(own a)

	ret show(imm a)
}

main: fun -> i32 = 0
