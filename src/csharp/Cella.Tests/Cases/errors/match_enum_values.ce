mod test

Nullable[T: null]: enum match T
{
	none = null
	some(value) = else
}

Socket: enum match i32
{
	invalid = -1
	valid(handle) = else
}

Parity: enum match u8
{
	even = 0, 2
	odd(value) = 1, 3, 5
	other(value) = else
}

checked: val Socket = valid(-1)
nothing: val Nullable[ptr] = some(null)
oddly: val Parity = odd(2)
evenly: val Parity = other(2)
fine: val Parity = odd(3)
spare: val Parity = other(4)

main: fun -> i32
{
	val local: Socket = valid(-1)
	ret 0
}
