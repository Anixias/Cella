mod lib

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: pub enum
{
	none
	some(value: T)

	made: var i32 = 0

	wrap: fun(value: T) -> Option[T]
	{
		made += 1
		ret Option.some(value)
	}

	orElse: fun(self, fallback: T) -> T
	{
		match self
		{
			some(val v) => ret v
			none => ret fallback
		}
	}

	isSome: get(imm self) -> bool => self is some(_)
}

Token: pub own rec
{
	id: i32

	drop: op
	{
		printf("drop %d ", self.id)
	}
}

first[T]: pub fun(a: Option[T], b: Option[T]) -> Option[T]
{
	if a.isSome
		ret a

	ret b
}

libraryCount: pub fun -> i32
{
	val item = Option[i32].wrap(1)
	ret Option[i32].made
}
