mod test

View[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}
}

Name: rec
{
	id: i32

	drop: op
	{
	}
}

take: fun(...names: View[Name]) {}

first: fun(...values: View[i32]) -> View[i32] => values

main: fun -> i32
{
	val name = Name(1)
	take(name)
	val kept = first(1, 2)
	ret 0
}
