mod test

Display: trait
{
	print: fun(self)
}

i32: impl Display
{
	print: fun(self)
	{
	}
}

Token: rec
{
	id: i32

	drop: op
	{
	}
}

Bundle: rec
{
	token: Token
}

call[T: ext]: fun(f: ext fun[T -> i32], value: T) -> i32 = f(value)

visit[T: ext]: fun(f: ext fun[ptr[T] -> i32], items: ptr[T]) -> i32 = f(items)

same: fun(t: Token) -> i32 = t.id

outer[U]: fun(f: ext fun[i32 -> i32], value: U) -> i32 = visit[U](undef, null)

local[T]: fun(value: T) -> i32
{
	var f: ext fun[array[T, 2] -> i32]
	val g = fun(x: T) -> ext fun[T -> i32] = undef
	ret 0
}

main: fun -> i32
{
	call(same, Token(4))
	call[Bundle](undef, Bundle(Token(1)))
	call[fun[i32 -> i32]](undef, fun(n: i32) -> i32 = n)
	visit[fstr[Display]](undef, null)
	ret 0
}
