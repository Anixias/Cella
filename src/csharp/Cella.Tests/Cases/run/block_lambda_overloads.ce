mod test

Option[T]: enum { none, some(value: T) }

pick: fun(imm f: fun[i32 -> i32], o: Option[i32]) -> i32 => 1
pick: fun(imm f: fun[i64 -> i64], o: Option[i64]) -> i32 => 2

exprBody: fun -> i32 => pick(fun(x) => x, some(2))

blockBody: fun -> i32 => pick(fun(x) { ret x }, some(2))

main: fun -> i32 => exprBody() + blockBody()
