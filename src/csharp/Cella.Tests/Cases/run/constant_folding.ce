mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

maxI32: val i32 = 2147483647
wrapAdd: val i32 = i32(i64(maxI32) + 1)
wrapMul: val u8 = u8(200 * 3)
divTrunc: val i32 = i32(-7) / 2
remSign: val i32 = i32(-7) % 3
minRem: val i32 = i32(-2147483648) % -1
shl: val i32 = 1 << 31
sarNeg: val i32 = i32(-16) >> 2
shrU: val u32 = u32(4000000000) >> 3
rotl: val u8 = u8(129) <<< 1
rotr: val u16 = u16(1) >>> 1
notU: val u16 = ~u16(0)
mixed: val bool = i32(-1) < u32(1)
chain: val bool = i32(1) < 3 < 2
hugeU: val u128 = u128(18446744073709551615) * u128(18446744073709551615)
highWord: val u64 = u64(hugeU >> 64)

sum32: val f32 = f32(0.1) + 0.2
sum64: val f64 = f64(0.1) + 0.2
quot32: val f32 = f32(1) / f32(3)
rem64: val f64 = f64(-7.5) % 2.0
big: val i32 = i32(3.9e10)
small: val i32 = i32(-3.9e10)
notANumber: val i32 = i32(0.0 / 0.0)
truncated: val i64 = i64(-2.9)
rounded: val f32 = f32(16777217)
wide: val f64 = f64(9007199254740993)
unsignedBig: val u8 = u8(300.0)
nanCompare: val bool = (0.0 / 0.0) != (0.0 / 0.0)

main: fun -> i32
{
	var a: i32 = 2147483647
	var b: u8 = 200
	var c: i32 = -7
	var d: i32 = -2147483648
	var e: i32 = 1
	var f: i32 = -16
	var g: u32 = 4000000000
	var h: u8 = 129
	var k: u16 = 1
	var m: u16 = 0
	var n: i32 = -1
	var p: u32 = 1
	var q: u128 = 18446744073709551615
	printf("%d %d|%d %d|%d %d|%d %d|%d %d|%d %d|%d %d|%u %u\n", wrapAdd, a +% 1, wrapMul, b *% u8(3), divTrunc, c / 2,
		remSign, c % 3, minRem, d % -1, shl, e << 31, sarNeg, f >> 2, shrU, g >> 3)
	printf("%d %d|%d %d|%d %d|%d %d|%d|%llu %llu\n", rotl, h <<< 1, rotr, k >>> 1, notU, ~m, mixed, n < p, chain,
		highWord, u64((q * q) >> 64))

	var x: f32 = 0.1
	var y: f32 = 0.2
	var u: f64 = 0.1
	var v: f64 = 0.2
	var one: f32 = 1
	var three: f32 = 3
	var r: f64 = -7.5
	var two: f64 = 2.0
	var hugeValue: f64 = 3.9e10
	var zero: f64 = 0.0
	var neg: f64 = -2.9
	var odd: i64 = 16777217
	var odd64: i64 = 9007199254740993
	var over: f64 = 300.0
	printf("%.9g %.9g|%.17g %.17g|%.9g %.9g|%.17g %.17g|%d %d|%d %d|%d %d|%lld %lld\n", sum32, x + y, sum64, u + v,
		quot32, one / three, rem64, r % two, big, i32(hugeValue), small, i32(-hugeValue), notANumber,
		i32(zero / zero), truncated, i64(neg))
	printf("%.9g %.9g|%.17g %.17g|%u %u|%d %d\n", rounded, f32(odd), wide, f64(odd64), unsignedBig, u8(over),
		nanCompare, (zero / zero) != (zero / zero))
	ret 0
}
