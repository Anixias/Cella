mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Hash: trait
{
	hash: fun(imm self) -> u64
}

Mapper: trait
{
	apply[U]: fun(imm self, imm change: fun[i32 -> U]) -> U
}

Point: rec impl Hash
{
	x: i32

	hash: fun(self) -> u64 => u64(self.x)
}

Box[T]: rec
{
	value: T
}

Box[T: Hash]: impl Hash
{
	hash: fun(imm self) -> u64 => self.value.hash() + 1
}

Pair[A, B]: rec impl Hash
{
	first: A
	second: B

	hash: fun(imm self) -> u64 => 2
}

Holder[T: Hash]: rec
{
	value: T

	digest: fun(imm self) -> u64 => self.value.hash() * 10
}

Cell: rec impl Mapper
{
	value: i32

	apply[V]: fun(self, imm change: fun[i32 -> V]) -> V => change(self.value)
}

describe[T: Hash]: fun(imm value: T) -> u64 => value.hash()

triple: fun(value: i32) -> i64 => value * 3

run[T: Mapper]: fun(imm item: T) -> i64 => item.apply(triple)

main: fun -> i32
{
	val b = Box(Point(3))
	printf("%llu %llu %llu %llu\n", b.hash(), describe(imm b), describe(Box(b)), Holder(Point(4)).digest())
	printf("%llu %lld %lld\n", describe(Pair(1, 2.5)), run(Cell(5)), Cell(2).apply[i64](triple))
	ret 0
}
