mod test

ext
{
	abs: fun(value: i32) -> i32
	printf: fun(format: cstr, ...) -> i32
	qsort: fun(items: ptr, count: usize, size: usize, compare: ext fun[ptr, ptr -> i32])
}

Pair: rec
{
	x: i32
	y: i32
}

Quad: rec
{
	a: i32
	b: i32
	c: i32
	d: i32
}

Handler: rec
{
	callback: ext fun[i32 -> i32]
	scale: i32
}

descending: ext fun(left: ptr, right: ptr) -> i32
{
	var a = *ptr[i32](left)
	var b = *ptr[i32](right)
	if a < b
		ret 1
	if a > b
		ret -1
	ret 0
}

twice: ext fun(value: i32) -> i32 = value * 2
add: ext fun(a: i32, b: i32) -> i32 = a + b
sub: ext fun(a: i32, b: i32) -> i32 = a - b
mul: ext fun(a: i32, b: i32) -> i32 = a * b
answer: ext fun -> i32 = 42
swap: ext fun(pair: Pair) -> Pair = Pair(pair.y, pair.x)
spread: ext fun(quad: Quad, scale: i32) -> Quad = Quad(quad.a * scale, quad.b * scale, quad.c * scale, quad.d * scale)

log: ext fun(value: i32)
{
	printf("logged %d\n", value)
}

apply: fun(f: ext fun[i32 -> i32], value: i32) -> i32 = f(value)

pick: fun(which: i32) -> ext fun[i32, i32 -> i32]
{
	if which == 0
		ret add
	ret mul
}

main: fun -> i32
{
	var values = [5, 3, 9, 1, 7]
	qsort(@values, 5, sizeOf(i32), descending)
	printf("%d %d %d %d %d\n", values[0], values[1], values[2], values[3], values[4])

	var f = twice
	var g: ext fun[i32 -> i32] = abs
	printf("%d %d %d %d\n", f(21), g(-5), apply(twice, 4), apply(abs, -9))
	f = abs
	printf("%d %d %d\n", f(-3), pick(0)(6, 3), pick(1)(6, 3))

	var table = [add, sub, mul]
	var i: usize = 0
	while i < 3
	{
		printf("%d ", table[i](6, 3))
		i += 1
	}

	var handler = Handler(twice, 5)
	var callback = handler.callback
	var constant: ext fun[-> i32] = answer
	printf("%d %d\n", callback(handler.scale), constant())

	var logger = log
	logger(7)

	var swapper = swap
	var spreader = spread
	var s = swap(Pair(1, 2))
	var s2 = swapper(Pair(5, 6))
	var q = spread(Quad(1, 2, 3, 4), 10)
	var q2 = spreader(Quad(5, 6, 7, 8), 2)
	printf("%d %d %d %d %d %d %d %d\n", s.x, s.y, s2.x, s2.y, q.a, q.d, q2.b, q2.c)
	ret 0
}
