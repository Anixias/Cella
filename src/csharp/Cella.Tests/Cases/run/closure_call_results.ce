mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Text: rec
{
	id: i32

	drop: op
	{
		printf("drop %d\n", self.id)
	}
}

call: fun(f: fun[-> imm[Text]]) -> imm[Text] = f()

main: fun -> i32
{
	var t = Text(1)
	val r = call(fun -> imm[Text] = t)
	printf("%d\n", r.id)
	val g = fun -> i32 = t.id
	t = Text(2)
	printf("%d\n", g())
	val s = call(fun -> imm[Text] = t)
	printf("%d\n", s.id)
	ret 0
}
