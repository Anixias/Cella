mod test

Eq: trait
{
	==: op(imm a: Self, imm b: Self) -> bool
}

Dup: trait
{
	dup: fun(imm self) -> Self
}

i32: impl Eq

Text: rec
{
	id: i32

	drop: op
	{
	}
}

box[T]: rec
{
	value: T
}

box[T: Eq]: impl
{
	same: fun(imm self, imm other: box[T]) -> bool => self.value == other.value
	helper: pvt fun(imm self) -> i32 => 3
	size: get(imm self) -> i32 => 4
}

box[T: copy]: impl Dup
{
	dup: fun(self) -> box[T] => box(self.value)
}

check[T]: fun(imm a: box[T]) -> bool => a.same(a)

copies[T: Dup]: fun(imm value: T) -> T => value.dup()

main: fun -> i32
{
	box(Text(1)).same(box(Text(2)))
	box(3).helper()
	box(Text(1)).size
	copies(box(Text(1)))
	ret 0
}
