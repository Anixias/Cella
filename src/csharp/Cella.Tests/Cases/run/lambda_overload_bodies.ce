mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

run: fun(imm f: fun[-> i32]) -> i32 => f()
run: fun(imm f: fun[-> str]) -> i32 => 0

pick: fun(f: fun[i32 -> i32]) -> i32 => 1
pick: fun(imm f: fun[i64 -> i64]) -> i32 => i32(f(10))

width: fun(imm f: fun[-> i32]) -> i32 => 1
width: fun(imm f: fun[-> i64]) -> i32 => 2

unsigned: fun(imm f: fun[-> u32]) -> i32 => 1
unsigned: fun(imm f: fun[-> u64]) -> i32 => 2

wide: fun(imm f: fun[-> i64]) -> i32 => 1
wide: fun(imm f: fun[-> f64]) -> i32 => 2

main: fun -> i32
{
	val base = 3
	printf("%d %d\n", run(fun => 5), run(fun => "x"))
	printf("%d %d\n", run(fun { ret 6 }), run(fun { ret "y" }))
	printf("%d\n", pick(fun(x) => x + base))
	printf("%d %d %d %d\n", width(fun => 5), unsigned(fun => 5u), wide(fun => 5), wide(fun => 2.5))
	ret 0
}
