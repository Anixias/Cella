mod test

Point: rec
{
	x: i32

	make[T, U]: fun(imm value: T) -> i32 = 1
	make[T, U, V]: fun(imm value: T, imm other: U) -> i32 = 2
}

make[T, U]: fun(imm value: T) -> i32 = 1
make[T, U, V]: fun(imm value: T, imm other: U) -> i32 = 2

main: fun -> i32
{
	val f = Point.make[i32]
	val g = make[i32, i64, u8, u16]
	ret Point.make[i32](1) + make[i32](1)
}
