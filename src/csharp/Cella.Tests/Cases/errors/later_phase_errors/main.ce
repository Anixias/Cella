mod test

use broken

Shape: rec
{
	width: Missing
	height: i32

	area: fun(imm self) -> i32 = self.width * self.height
	perimeter: fun(imm self) -> i32 = self.height + false
}

describe: fun(shape: Unknown) -> i32 = shape.size + 1

leak: fun -> i32
{
	val x: i32
	ret x
}

i32: rec { value: u8 }

count: fun -> i32 = 3

main: fun -> i32 = broken.half(4) + count()
