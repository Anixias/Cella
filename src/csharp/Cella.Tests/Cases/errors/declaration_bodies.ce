mod test

Team: enum
{
	red
	blue
}

main: fun -> i32
{
	var ready = true
	if ready
		var first = 1
	else
		val second = 2

	while ready
		var third = 3

	do
		var fourth = 4
	while ready

	for _ in 0..2
		var fifth = 5

	loop
		val sixth = 6

	match Team.red
	{
		red => var seventh = 7
