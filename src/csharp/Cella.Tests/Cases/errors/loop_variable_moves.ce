mod test

Name: own rec
{
	id: i32

	drop: op
	{
	}
}

Countdown: own rec
{
	left: i32

	for: op(mut self) -> bool
	{
		self.left -= 1
		ret self.left >= 0
	}

	*: op(imm self) -> imm[i32] => imm self.left

	drop: op
	{
	}
}

take: fun(name: Name)
{
}

takeAll: fun(names: array[Name, 2])
{
}

finish: fun(countdown: Countdown)
{
}

walk: fun(imm countdown: Countdown) -> i32
{
	var total = 0
	for x in countdown
		total += x

	ret total
}

main: fun -> i32
{
	var names = [Name(1), Name(2)]
	for imm name in names
		take(name)

	for mut name in names
	{
		val copy: Name = name
	}

	var group = [Name(3), Name(4)]
	for imm name in group
		takeAll(group)

	var c = Countdown(3)
	for x in c
	{
	}

	finish(c)
	var d = Countdown(3)
	for x in mut d
		finish(d)

	ret 0
}
