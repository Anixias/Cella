mod test

Buffer: own rec
{
	id: i32

	drop: op
	{
	}
}

Pair: own rec
{
	left: Buffer
	right: Buffer
}

make: fun(id: i32) -> Buffer => Buffer(id)
show: fun(imm pair: Pair) -> i32 => pair.left.id

whole: fun -> Pair
{
	val pair = Pair(make(1), make(2))
	val left = pair.left
	val total = show(imm pair) + pair.right.id + left.id
	ret pair
}

refilled: fun -> Pair
{
	var pair = Pair(make(1), make(2))
	val left = pair.left
	pair.left = make(left.id + 1)
	ret pair
}

elements: fun(i: usize) -> i32
{
	var items = [make(1), make(2)]
	val first = items[0]
	ret items[i].id + items[1].id + first.id
}

constant: fun -> i32
{
	val pair = Pair(Buffer(1), Buffer(2))
	val left = pair.left
	ret pair.left.id + pair.right.id + left.id
}

main: fun -> i32 => 0
