mod std.process

when windows
{
	ext
	{
		write: ext("_write") fun(fd: i32, data: ptr, count: u32) -> i32
		failFast: ext("RaiseFailFastException") fun(record: ptr, context: ptr, flags: u32) -> never
	}
	
	writeError: fun(text: str)
	{
		var data = text.data
		var remaining = text.byteLength
		while remaining > 0
		{
			var count = remaining
			if count > 2147483647
				count = 2147483647
			
			write(2, data, u32(count))
			data += count
			remaining -= count
		}
	}
	
	crash: fun -> never => failFast(null, null, 0)
}
else
{
	ext
	{
		write: fun(fd: i32, data: ptr, count: usize) -> isize
		abort: fun -> never
	}
	
	writeError: fun(text: str) => write(2, text.data, text.byteLength)
	crash: fun -> never => abort()
}

ext
{
	fflush: fun(stream: ptr) -> i32
}

panicHook: pub ext("cellaStdPanic") fun(locData: ptr[u8], locLength: usize) -> never
{
	val location = str(locData, locLength)
	
	fflush(null)
	writeError("Panic at ")
	writeError(location)
	writeError("\n")
	crash()
}

panicMessageHook: pub ext("cellaStdPanicMsg") fun(msgData: ptr[u8], msgLength: usize, locData: ptr[u8],
	locLength: usize) -> never
{
	val location = str(locData, locLength)
	val message = str(msgData, msgLength)
	
	fflush(null)
	writeError("Panic at ")
	writeError(location)
	writeError(": ")
	writeError(message)
	writeError("\n")
	crash()
}