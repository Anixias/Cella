mod std.containers

use std.[Option, Span, View]
use std.cmp.Eq
use std.mem.[Allocator, Heap, Layout, swap]

List[T: noref, A: Allocator = Heap]: pub own rec
{
	data: pvt req ptr[T]
	count: pvt set usize
	capacity: pvt set usize
	alloc: pvt req A
	
	isEmpty: get(imm self) -> bool => self.count == 0
	
	new: op(alloc: A)
	{
		self.alloc = alloc
		
		val layout = Layout.arrayOf[T](0)
		self.data = ptr[T](self.alloc.allocate(layout))
	}
	
	drop: op
	{
		for i in 0..self.count
			drop self.data[i]
		
		val layout = Layout.arrayOf[T](self.capacity)
		self.alloc.release(self.data, layout)
	}
	
	grow: pvt fun(mut self)
	{
		val newCapacity = match self.capacity
		{
			< 4 => 4
			else => self.capacity * 2
		}
		
		val oldLayout = Layout.arrayOf[T](self.capacity)
		val newLayout = Layout.arrayOf[T](newCapacity)
		self.data = ptr[T](self.alloc.resize(self.data, oldLayout, newLayout.size))
		self.capacity = newCapacity
	}
	
	growIfNeeded: pvt fun(mut self)
	{
		if self.count == self.capacity
			self.grow()
	}
	
	add: fun(mut self, value: T)
	{
		self.growIfNeeded()
		own self.data[self.count] = value
		self.count += 1
	}
	
	insert: fun(mut self, value: T, index: usize)
	{
		if index > self.count
			panic "index out of bounds"
			
		if index == self.count
		{
			self.add(value)
			ret
		}
		
		self.growIfNeeded()
		
		// Shift all succeeding elements up by 1
		for i in 1..=(self.count - index)
			own self.data[self.count - i + 1] = own self.data[self.count - i]
		
		// Write new element
		own self.data[index] = value
		
		self.count += 1
	}
	
	removeAt: fun(mut self, index: usize) -> T
	{
		if index >= self.count
			panic "index out of bounds"
		
		val value = own self.data[index]
		for i in index..(self.count - 1)
			own self.data[i] = own self.data[i + 1]
		
		self.count -= 1
		ret value
	}
	
	replaceAt: fun(mut self, value: T, index: usize) -> T
	{
		if index >= self.count
			panic "index out of bounds"
		
		val oldValue = own self.data[index]
		own self.data[index] = value
		ret oldValue
	}
	
	reverse: fun(mut self)
	{
		val count = self.count
		for i in 0..count / 2
			swap(mut self[i], mut self[count - 1 - i])
	}
	
	in: op(imm self) -> ListCursor[T] => ListCursor[T](self.data, self.count)
	in: op(mut self) -> ListEditor[T] => ListEditor[T](self.data, self.count)
	
	as: op(imm self) -> View[T] => View[T](self.data, self.count)
	as: op(mut self) -> Span[T] => Span[T](self.data, self.count)
	
	[]: op(mut self, index: usize) -> mut[T]
	{
		if (index >= self.count)
			panic "index out of bounds"
		
		ret mut self.data[index]
	}
}

List[T: noref, A: Allocator + new]: impl
{
	new: op
	{
		self = List[T, A](A())
	}
}

List[T: noref + Eq, A: Allocator]: impl
{
	remove: fun(mut self, value: T) -> Option[T]
	{
		for v, i in self
			if v == value
				ret self.removeAt(i)
		
		ret none
	}
}

ListCursor[T: noref]: pub ref rec
{
	data: pvt ptr[T]
	length: pvt usize
	position: pvt usize
	
	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
		self.position = 0
	}
	
	for: op(mut self) -> bool
	{
		self.position += 1
		ret self.position <= self.length
	}
	
	*: op(self) -> imm[T] => imm self.data[self.position - 1]
}

ListEditor[T: noref]: pub ref rec
{
	data: pvt ptr[T]
	length: pvt usize
	position: pvt usize
	
	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
		self.position = 0
	}
	
	for: op(mut self) -> bool
	{
		self.position += 1
		ret self.position <= self.length
	}
	
	*: op(self) -> imm[T] => imm self.data[self.position - 1]
	*: op(mut self) -> mut[T] => mut self.data[self.position - 1]
}