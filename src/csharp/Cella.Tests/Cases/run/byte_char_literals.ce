mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

main: fun -> i32
{
	val text: str = "a7b"
	var count = 0
	for i in 0..text.byteLength
	{
		if text[i] == 'b'u8 || 'a'u8 == text[i]
			count += 1
	}

	val digit = text[1] - '0'u8
	var b: u8 = 1
	b += 'a'u8
	val lower = text[0] >= 'a'u8 && text[0] <= 'z'u8
	val kind = match text[2]
	{
		'a'u8..='z'u8 => 1
		else => 0
	}

	val bytes: array[u8, 2] = ['h'u8, 'i'u8]
	val wide = '€'u16
	printf("%d %d %d %d %d %d %d\n", count, digit, b, lower, kind, bytes[1], wide)
	ret 0
}
