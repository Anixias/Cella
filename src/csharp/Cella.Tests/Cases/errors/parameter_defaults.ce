mod test

view[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}
}

Logger: trait
{
	log: fun(imm self, level: i32 = 0)
	new: op(size: i32 = 0)
}

Box: rec
{
	value: i32

	*: op(self, other: i32 = 0) -> i32 = 0
}

make: fun -> i32 = 4

order: fun(first: i32 = 0, second: i32) {}
writes: fun(mut value: i32 = 0) {}
packs: fun(...values: view[i32] = view[i32](null, 0)) {}
called: fun(value: i32 = make()) {}
wrong: fun(value: i32 = "text") {}
generic[T]: fun(imm value: T = 5) {}

main: fun -> i32 = 0
