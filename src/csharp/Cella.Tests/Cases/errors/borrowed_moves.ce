mod test

Buffer: own rec
{
	id: i32

	drop: op
	{
	}
}

Holder: own rec
{
	buffer: Buffer
}

Effect: own enum
{
	none
	hold(buffer: Buffer)
	count(n: i32)
}

take: fun(buffer: Buffer) -> i32 => buffer.id
takeNumber: fun(n: i32) -> i32 => n

parameters: fun(imm buffer: Buffer, imm holder: Holder, n: i32) -> i32
{
	ret take(buffer) + take(holder.buffer) + takeNumber(n)
}

returned: fun(imm buffer: Buffer) -> Buffer
{
	ret buffer
}

bindings: fun(imm effect: Effect) -> i32
{
	match effect
	{
		hold(val buffer) => ret take(buffer)
		count(val n) => ret takeNumber(n)
		else => ret 0
	}
}

mutBindings: fun(mut effect: Effect) -> i32
{
	match mut effect
	{
		hold(val buffer) => ret take(buffer)
		else => ret 0
	}
}

main: fun -> i32 => 0
