mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

A: trait
{
	size: get(imm self) -> i32
	count: prop i32
	{
		get(imm self)
		set(mut self, value)
	}
	total: get -> i32
}

B: trait
{
	size: get(imm self) -> i32
	count: prop i32
	{
		get(imm self)
		set(mut self, value)
	}
	total: get -> i32
}

P: rec
{
	x: i32
}

P: impl B
{
	size: get(self) -> i32 => 2
	count: prop i32
	{
		get(self) => 2
		set(mut self, value)
		{
		}
	}
	total: get -> i32 => 2
}

P: impl A
{
	size: get(self) -> i32 => 1
	count: prop i32
	{
		get(self) => 1
		set(mut self, value)
		{
		}
	}
	total: get -> i32 => 1
}

g[T: A + B]: fun(imm value: T) -> i32 => value.size

main: fun -> i32
{
	var p = P(0)
	printf("%d %d %d\n", p.size, p.count, P.total)
	p.count = 5
	printf("%d %d\n", A(p).size, B(p).count)
	ret 0
}
