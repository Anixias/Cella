mod test

Shape: trait
{
	area: fun(imm self) -> i32
}

Holder: rec
{
	p: ptr[dyn[Shape]]
}

Wrap: ext enum
{
	one(p: ptr[dyn[Shape]])
}

View: ref rec
{
	p: ptr[i32]
}

Outer: rec
{
	inner: array[Holder, 2]
}

Callbacks: rec
{
	list: array[fun[], 2]
}

ext
{
	puts: fun(text: str) -> i32
	take: fun(h: Holder) -> i32
	takeWrap: fun(w: Wrap)
	getenv: fun(name: cstr) -> imm[u8]
	look: fun(v: View)
	numbers: fun(list: array[i32, 2])
	make: fun -> array[u8, 4]
	read: fun(imm data: array[u8, 8]) -> usize
	outer: fun(o: Outer)
	calls: fun(c: Callbacks)
	keep: fun(p: ptr[Holder])
}

visit: ext fun(v: View) -> i32 = 0

main: fun -> i32 = 0
