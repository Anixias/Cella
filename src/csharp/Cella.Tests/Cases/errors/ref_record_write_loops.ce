mod test

View[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	in: op(self) -> ViewCursor[T] => ViewCursor[T](self.data, self.length)
}

ViewCursor[T]: ref rec
{
	data: pvt ptr[T]
	left: pvt usize

	new: op(data: ptr[T], left: usize)
	{
		self.data = data
		self.left = left
	}

	for: op(mut self) -> bool => self.left > 0

	*: op(self) -> imm[T] => imm *self.data
}

main: fun -> i32
{
	val four = [1, 2, 3, 4]
	val v = View[i32](@four, 4)
	for mut x in v
		x = 0

	ret 0
}
