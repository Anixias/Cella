mod std.mem

when windows
{
	ext
	{
		alignedAlloc: ext("_aligned_malloc") fun(size: usize, alignment: usize) -> ptr
		alignedResize: ext("_aligned_realloc") fun(memory: ptr, size: usize, alignment: usize) -> ptr
		alignedFree: ext("_aligned_free") fun(memory: ptr)
	}
	
	allocateHook: pub ext("cellaStdAllocate") fun(size: usize, alignment: usize) -> ptr =>
		alignedAlloc(size, alignment)
	
	resizeHook: pub ext("cellaStdResize") fun(memory: ptr, size: usize, alignment: usize, newSize: usize) -> ptr =>
		alignedResize(memory, newSize, alignment)
	
	releaseHook: pub ext("cellaStdRelease") fun(memory: ptr, size: usize, alignment: usize) =>
		alignedFree(memory)
}
else
{
	ext
	{
		malloc: fun(size: usize) -> ptr
		alignedAllocate: ext("aligned_alloc") fun(alignment: usize, size: usize) -> ptr
		realloc: fun(memory: ptr, size: usize) -> ptr
		free: fun(memory: ptr)
		memcpy: fun(target: ptr, source: ptr, count: usize) -> ptr
	}
	
	allocateHook: pub ext("cellaStdAllocate") fun(size: usize, alignment: usize) -> ptr
	{
		if alignment <= 16
			ret malloc(size)
		
		ret alignedAllocate(alignment, (size + alignment - 1) / alignment * alignment)
	}
	
	resizeHook: pub ext("cellaStdResize") fun(memory: ptr, size: usize, alignment: usize, newSize: usize) -> ptr
	{
		if alignment <= 16
			ret realloc(memory, newSize)
		
		val result = allocateHook(newSize, alignment)
		if result == null
			ret null
		
		var count = size
		if newSize < count
			count = newSize
		
		memcpy(result, memory, count)
		free(memory)
		ret result
	}
	
	releaseHook: pub ext("cellaStdRelease") fun(memory: ptr, size: usize, alignment: usize) =>
		free(memory)
}