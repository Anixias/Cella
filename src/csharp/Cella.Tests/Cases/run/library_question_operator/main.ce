mod test

use lib.Result

parse: fun(n: i32) -> Result[i32, i32]
{
	if n < 0
		ret Result.err(n)

	ret Result.ok(n)
}

twice: fun(n: i32) -> Result[i32, i32] => Result.ok(parse(n)? * 2)

main: fun -> i32
{
	val a = match twice(-3)
	{
		ok(val v) => v
		err(val e) => e
	}

	val b = match twice(5)
	{
		ok(val v) => v
		err(val e) => e
	}

	ret a + b
}
