mod test

Eq: trait
{
	==: op(imm a: Self, imm b: Self) -> bool
}

Hash: trait
{
	hash: fun(imm self) -> u64
}

Ord: trait req Eq
{
	<: op(imm a: Self, imm b: Self) -> bool
}

Plain: rec impl Ord
{
	n: i32

	<: op(a: Plain, b: Plain) -> bool => a.n < b.n
}

f64: impl Ord

box[T]: rec
{
	value: T
}

box[T: Ord]: impl Ord
{
	<: op(imm a: box[T], imm b: box[T]) -> bool => a.value < b.value
}

box[T: Hash]: impl Eq
{
	==: op(imm a: box[T], imm b: box[T]) -> bool => true
}

Even: trait req Odd
Odd: trait req Even
Selfish: trait req Selfish

Shown: pub trait req Eq

Twice: trait req Eq + Eq

twice[T: Eq + Eq]: fun(imm a: T, imm b: T) -> bool => a == b

Missing: trait req Unknown
NotTrait: trait req i32

list[T: Ord]: rec
{
	value: T
}

list[T: Eq + Ord]: impl
{
	same: fun(imm self, imm other: T) -> bool => self.value == other
}

main: fun -> i32 => 0
