mod test

Words: ref rec
{
	items: array[str, 2]

	fill: fun(mut self, other: str)
	{
		for mut w in self.items
			w = other
	}
}

Slot: ref enum
{
	none
	text(s: str)
}

replaceAll: fun(mut words: array[str, 2], other: str)
{
	for mut w in words
		w = other
}

replaceFirst: fun(mut words: array[str, 2], other: str)
{
	var i = 0
	while i < 2
	{
		words[0] = other
		i += 1
	}
}

fillSlots: fun(mut slots: array[Slot, 2], other: str)
{
	for mut slot in slots
	{
		match mut slot
		{
			text(val s) => s = other
			else => {}
		}
	}
}

fillStatic: fun(mut words: array[str, 2])
{
	for mut w in words
		w = "q"
}

main: fun -> i32 => 0
