mod std.extensions

use std.View
use std.cmp.Eq
use std.text.[CharCursor, Text, Utf8]

str: pub impl
{
	refEq: fun(imm left: str, imm right: str) -> bool => left.data == right.data
	
	as: op(imm self) -> View[u8] => View[u8](self.data, self.byteLength)
	as: op(imm self) -> Text[Utf8] => Text[Utf8](View[u8](self.data, self.byteLength))
	
	chars: fun(imm self) -> CharCursor[Utf8] => CharCursor[Utf8](self)
}

str: impl Eq
{
	==: op(imm left: str, imm right: str) -> bool
	{
		if left.byteLength != right.byteLength
			ret false
		
		for i in 0..left.byteLength
		{
			if left[i] != right[i]
				ret false
		}
		
		ret true
	}
	
	!=: op(imm left: str, imm right: str) -> bool => !(left == right)
}