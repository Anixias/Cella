mod std.fs

use std.[Result, Span, View]
use std.cmp.Eq
use std.io.IoError
use std.mem.[Allocator, Heap]
use std.text.[Encoding, Malformed, String, Text, Utf16Be, Utf16Le, Utf8, findMalformed, transcode]

FileEncoding: pub enum
{
	detect
	utf8
	utf16LittleEndian
	utf16BigEndian
}

readText[E: Encoding[T: copy + Eq + default] = Utf8, A: Allocator + noref + default = Heap]: pub fun(path: str,
	source: FileEncoding = detect, malformed: Malformed = stop) -> Result[String[E, A], IoError] =>
	decodeFile[E, A](path, A(), source, malformed)

readText[E: Encoding[T: copy + Eq + default] = Utf8, A: Allocator + noref = Heap]: pub fun(path: str, alloc: A,
	source: FileEncoding = detect, malformed: Malformed = stop) -> Result[String[E, A], IoError] =>
	decodeFile[E, A](path, alloc, source, malformed)

decodeFile[E: Encoding[T: copy + Eq + default], A: Allocator + noref]: pvt fun(path: str, alloc: A,
	source: FileEncoding, malformed: Malformed) -> Result[String[E, A], IoError]
{
	val bytes = readBytes(path)?
	val all: View[u8] = bytes
	val hasUtf8Mark = all.length >= 3 && all[0] == 0xEF && all[1] == 0xBB && all[2] == 0xBF
	val hasLittleMark = all.length >= 2 && all[0] == 0xFF && all[1] == 0xFE
	val hasBigMark = all.length >= 2 && all[0] == 0xFE && all[1] == 0xFF
	
	var encoding = source
	if encoding is detect
		encoding = markedEncoding(all)
	
	ret match encoding
	{
		utf16LittleEndian => decodeAs[Utf16Le, E, A](all.slice(skipOf(hasLittleMark, 2), all.length), alloc, malformed)
		utf16BigEndian => decodeAs[Utf16Be, E, A](all.slice(skipOf(hasBigMark, 2), all.length), alloc, malformed)
		else => decodeAs[Utf8, E, A](all.slice(skipOf(hasUtf8Mark, 3), all.length), alloc, malformed)
	}
}

markedEncoding: pvt fun(start: View[u8]) -> FileEncoding
{
	if start.length >= 2 && start[0] == 0xFF && start[1] == 0xFE
		ret utf16LittleEndian
	
	if start.length >= 2 && start[0] == 0xFE && start[1] == 0xFF
		ret utf16BigEndian
	
	ret utf8
}

skipOf: pvt fun(hasMark: bool, markLength: usize) -> usize
{
	if hasMark
		ret markLength
	
	ret 0
}

decodeAs[F: Encoding[u8], E: Encoding[T: copy + Eq + default], A: Allocator + noref]: pvt fun(bytes: View[u8], alloc: A,
	malformed: Malformed) -> Result[String[E, A], IoError]
{
	if malformed is stop && findMalformed[F](bytes) is some(_)
		ret err(IoError(invalidData, 0))
	
	ret ok(String[E, A].from(Text[F](bytes), alloc))
}

writeText[To: Encoding[u8] = Utf8, F: Encoding[U] = Utf8]: pub fun(path: str, text: Text[F],
	byteOrderMark: bool = false) -> Result[usize, IoError]
{
	var file = File.open(path, create, write)?
	var total = 0
	if byteOrderMark
	{
		var mark: array[u8, 4]
		val count = To.encode('\uFEFF', mut mark)
		total += file.write(View[u8](@mark, count))?
	}
	
	ret ok(total + writeEncoded[To, F](mut file, text)?)
}

appendText[F: Encoding[U] = Utf8]: pub fun(path: str, text: Text[F], target: FileEncoding = detect)
	-> Result[usize, IoError]
{
	var file = File.open(path, append, readWrite)?
	var encoding = target
	if encoding is detect
	{
		var start: array[u8, 3]
		var count = 0
		while count < 3
		{
			val read = file.read(Span[u8](@start, 3).slice(count, 3))?
			if read == 0
				break
			
			count += read
		}
		
		encoding = markedEncoding(View[u8](@start, count))
	}
	
	ret match encoding
	{
		utf16LittleEndian => writeEncoded[Utf16Le, F](mut file, text)
		utf16BigEndian => writeEncoded[Utf16Be, F](mut file, text)
		else => writeEncoded[Utf8, F](mut file, text)
	}
}

writeEncoded[To: Encoding[u8], F: Encoding[U]]: pvt fun(mut file: File, text: Text[F]) -> Result[usize, IoError]
{
	var chunk: array[u8, 4096]
	var total = 0
	var rest: View[U] = text
	while !rest.isEmpty
	{
		val result = transcode[F, To](rest, mut chunk)
		total += file.write(View[u8](@chunk, result.written))?
		rest = rest.slice(result.read, rest.length)
	}
	
	ret ok(total)
}