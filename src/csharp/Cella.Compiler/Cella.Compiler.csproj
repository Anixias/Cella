<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <AssemblyName>cella</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  
  <PropertyGroup>
    <CreateHardLinksForAdditionalFilesIfPossible>true</CreateHardLinksForAdditionalFilesIfPossible>
  </PropertyGroup>

  <Target Name="AddCellaComponents" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveCellaComponents"
          Condition="'$(UsesCellaComponents)' == 'true'">
    <ItemGroup>
      <None Include="@(CellaComponentFile)" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\..\std\**\*" Exclude="..\..\std\tests\**;..\..\std\**\bin\**;..\..\std\**\obj\**"
          Link="lib\std\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\debug\natvis\cella.natvis" LogicalName="cella.natvis"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cella.Core\Cella.Core.csproj"/>
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Cella.Tests"/>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="CsToml" Version="1.8.2"/>
    <PackageReference Include="CsToml.Generator" Version="1.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
