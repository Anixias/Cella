mod test

use util.none

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: enum
{
	none
	some(value: T)

	map[U]: fun(own self, change: fun[own T -> U]) -> Option[U]
	{
		match own self
		{
			some(own v) => ret some(change(own v))
			none => ret none
		}
	}
}

Team: enum
{
	red
	blue
}

Mode: enum
{
	idle
	running(speed: i32)
}

Effect: enum
{
	calm
	strike(damage: i32)
}

Holder: rec
{
	item: Option[i32]
	count: i32
}

Box: rec
{
	item: Option[i32]

	new: op(own item: Option[i32])
	{
		self.item = item
	}
}

Pair[T]: rec
{
	item: Option[T]
	count: T
}

seven: val Option[i32] = some(7)

read: fun(o: Option[i32]) -> i32 => match o { some(val v) => v, none => -1 }
readWide: fun(o: Option[i64]) -> i64 => match o { some(val v) => v, none => -1 }
speed: fun(m: Mode) -> i32 => match m { running(val s) => s, idle => 0 }
damage: fun(e: Effect) -> i32 => match e { strike(val d) => d, calm => 0 }
show: fun(o: Option[i32]) -> i32 => 1
show: fun(t: Team) -> i32 => 2
both[T]: fun(imm o: Option[T], own fallback: T) -> T => fallback
double: fun(own n: i32) -> i64 => i64(n) * 2
some: fun(value: i32) -> i32 => value * 100

half: fun(n: i32) -> Option[i32]
{
	if n % 2 != 0
		ret none

	ret some(n / 2)
}

keep[T]: fun(own value: T, kept: bool) -> Option[T]
{
	if kept
		ret some(own value)

	ret none
}

main: fun -> i32
{
	val a: Option[i32] = none
	var b: Option[i32] = some(3)
	printf("%d %d %d %d %d ", read(a), read(b), read(seven), read(half(8)), read(half(3)))
	b = none
	printf("%d %d %d\n", read(b), read(keep(4, true)), read(keep(4, false)))

	val modes: array[Mode, 2] = [idle, running(4)]
	val nested: Option[Option[i32]] = some(none)
	printf("%d %d %d\n", speed(modes[0]), speed(modes[1]), match nested { some(val inner) => read(inner), none => -2 })

	val held = Holder(some(9), 1)
	val box = Box(some(10))
	val reader: fun[Option[i32] -> i32] = read
	val counted = Pair(none, 3)
	printf("%d %d %d %d %d ", read(held.item), read(box.item), reader(some(11)), both(none, 12),
		match counted.item { some(val v) => v, none => counted.count })

	printf("%d %d %lld\n", show(none), show(blue), readWide(Option.some(21).map(double)))

	val team = Team.blue
	printf("%d %d %d\n", i32(team == blue), i32(red == team), i32(team != blue))

	val none = 3
	val strike = Effect.strike(5)
	val imported = util.none
	printf("%d %d %d %d\n", read(none) + none, damage(strike), read(some(2)), read(imported))
	ret 0
}
