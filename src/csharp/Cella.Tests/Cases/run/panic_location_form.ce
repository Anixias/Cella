mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	exit: fun(code: i32) -> never
}

panic: op(location: str) -> never
{
	printf("Panic at %.*s\n", i32(location.byteLength), location.data)
	exit(8)
}

pick: fun(n: i32) -> i32 => match n
{
	0 => 10
	else => panic
}

main: fun -> i32
{
	printf("%d\n", pick(0))
	val values = [1, 2, 3]
	var i: usize = 3
	i += 0
	ret values[i]
}
