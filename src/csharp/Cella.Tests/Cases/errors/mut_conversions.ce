mod test

Span[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[const N: usize]: op(mut values: array[T, N]) -> Span[T] => Span[T](@values, N)
}

View[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[const N: usize]: op(imm values: array[T, N]) -> View[T] => View[T](@values, N)
}

fill: fun(values: Span[i32], value: i32) {}

read: fun(values: View[i32]) {}

grow: fun(mut values: Span[i32]) {}

main: fun -> i32
{
	var three: array[i32, 3] = [1, 2, 3]
	var four: array[i32, 4] = [1, 2, 3, 4]
	fill(three, 7)
	val s = Span[i32](four)
	val t: Span[i32] = four
	read(mut four)
	grow(mut three)
	ret 0
}
