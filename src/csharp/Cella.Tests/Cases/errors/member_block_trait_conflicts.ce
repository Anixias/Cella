}

Digest: trait
{
	hash: fun(imm self, seed: u64) -> u64
}

i32: impl Hash
{
	hash: fun(imm self) -> u64 => 0
}

Pair[T]: rec
{
	a: T
}

Pair[T: Hash]: impl
{
	hash: fun(imm self) -> u64 => 1
	size: fun(imm self) -> u64 => 2
}

Pair[T: Hash]: impl Hash
{
	hash: fun(imm self) -> u64 => 2
}

Pair[T]: impl Digest
{
	hash: fun(imm self, seed: u64) -> u64 => seed
}

main: fun -> i32 => 0
