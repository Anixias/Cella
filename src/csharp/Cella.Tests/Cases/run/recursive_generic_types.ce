mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Node[T]: rec
{
	value: T
	next: ptr[Node[T]]
}

First[T]: rec
{
	b: ptr[Second[T]]
	v: T
}

Second[T]: rec
{
	a: ptr[First[T]]
}

Swap[A, B]: rec
{
	next: ptr[Swap[B, A]]
	a: A
}

Box[T]: rec
{
	value: T

	wrap: fun(imm self) -> Box[ptr[T]] => Box[ptr[T]](null)

	drop: op
	{
	}
}

Tree[T]: enum
{
	leaf(value: T)
	node(left: ptr[Tree[T]], right: ptr[Tree[T]])
}

main: fun -> i32
{
	var first = Node(1, null)
	var second = Node(2, @first)
	var x: First[i64]
	var s: Swap[i32, f64]
	val b = Box(1)
	val w = b.wrap()
	val t = Tree[i32].leaf(3)
	printf("%d %d\n", second.value, (*second.next).value)
	ret 0
}
