mod std.fs

use std.[Result, View]
use std.io.IoError
use std.text.[Text, Utf8]

remove: pub fun(path: str) -> Result[IoError] => removePath(path)

copy: pub fun(from: str, to: str, replace: bool = false) -> Result[IoError]
{
	if isDirectoryAt(from) || isDirectoryAt(to)
		ret err(IoError(isDirectory, 0))
	
	ret copyPath(from, to, replace)
}

move: pub fun(from: str, to: str, replace: bool = false) -> Result[IoError]
{
	if replace && isDirectoryAt(to)
		ret err(IoError(isDirectory, 0))
	
	ret movePath(from, to, replace)
}

createDirectory: pub fun(path: str) -> Result[IoError] => createPath(path)

createDirectories: pub fun(path: str) -> Result[IoError]
{
	val result = createDirectory(path)
	if result is ok || isDirectoryAt(path)
		ret ok
	
	if result is err(val error) && !(error.kind is notFound)
		ret result
	
	val parent = parentOf(path)
	if parent.byteLength == 0
		ret result
	
	createDirectories(parent)?
	val retry = createDirectory(path)
	if retry is err(_) && isDirectoryAt(path)
		ret ok
	
	ret retry
}

removeDirectory: pub fun(path: str, recursive: bool = false) -> Result[IoError]
{
	if recursive
	{
		var listing = NativeListing.open(path, false)?
		val result = removeContents(mut listing)
		listing.close()
		result?
	}
	
	ret removeDirectoryPath(path)
}

parentOf: mod fun(path: str) -> str
{
	var end = path.byteLength
	while end > 0 && isSeparator(path[end - 1])
		end -= 1
	
	while end > 0 && !isSeparator(path[end - 1])
		end -= 1
	
	while end > 1 && isSeparator(path[end - 1])
		end -= 1
	
	ret Text[Utf8](View[u8](path.data, end))
}

isSeparator: mod fun(byte: u8) -> bool
{
	when windows
	{
		if byte == 0x5C
			ret true
	}
	
	ret byte == 0x2F
}

isDirectoryAt: mod fun(path: str) -> bool => metadata(path) is ok(val data) && data.kind is directory