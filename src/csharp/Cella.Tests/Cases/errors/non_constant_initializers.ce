mod test

ext
{
	rand: fun -> i32
}

counter: var i32 = 0
limit: const i32 = 5
random: const i32 = rand()
copied: const i32 = counter
address: const ptr[i32] = @counter
quotient: const i32 = 1 / (limit - 5)
dependent: const i32 = random + 1
fine: const i32 = limit * 2

Mode: enum
{
	fast
	slow(factor: i32)
}

chosen: const i32 = match Mode.slow(3) { fast => 4, slow(val factor) => rand() + factor }

main: fun -> i32
{
	ret fine
}
