mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Token: rec
{
	id: i32

	drop: op
	{
		printf("token %d ", self.id)
	}
}

main: fun -> i32
{
	var counts = lib.make[i64](5)
	counts.bump()
	counts.bump()
	val boxed = lib.box(Token(7))
	val outer = lib.Outer.make(3)
	printf("%lld %d %d %d %d | ", counts.value, counts.steps, boxed.id, lib.selfCheck(), lib.totalBumps())
	ret 0
}
