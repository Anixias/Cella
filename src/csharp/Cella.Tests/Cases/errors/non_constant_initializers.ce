mod test

ext
{
	rand: fun -> i32
}

counter: var i32 = 0
limit: val i32 = 5
random: val i32 = rand()
copied: val i32 = counter
address: val ptr[i32] = @counter
quotient: val i32 = 1 / (limit - 5)
dependent: val i32 = random + 1
fine: val i32 = limit * 2

Mode: enum
{
	fast
	slow(factor: i32)
}

chosen: val i32 = match Mode.slow(3) { fast => 4  slow(factor) => rand() + factor }

main: fun -> i32
{
	ret fine
}
