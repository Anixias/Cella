mod test

Token: own rec
{
	id: i32

	drop: op
	{
	}
}

take: fun(t: Token)
{
}

takeAll[N: const usize]: fun(values: array[Token, N])
{
}

twice[N: const usize]: fun(values: array[Token, N])
{
	take(values[0])
	take(values[0])
}

peek[N: const usize]: fun(values: array[Token, N]) -> i32
{
	take(values[0])
	ret values[0].id
}

both[N: const usize]: fun(values: array[Token, N])
{
	take(values[0])
	takeAll(values)
}

steal[N: const usize]: fun(mut values: array[Token, N])
{
	take(values[0])
}

main: fun -> i32 => 0
