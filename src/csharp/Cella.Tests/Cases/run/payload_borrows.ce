mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Buffer: own rec
{
	id: i32

	drop: op
	{
	}
}

Effect: own enum
{
	none
	hold(buffer: Buffer)
	count(n: i32)
}

Outer: own enum
{
	empty
	nested(inner: Effect)
}

Holder: own rec
{
	outer: Outer
}

show: fun(imm buffer: Buffer) -> i32 => buffer.id

describe: fun(imm effect: Effect) -> i32
{
	match effect
	{
		hold(val buffer) => ret show(imm buffer) + buffer.id
		count(val n) => ret n
		else => ret 0
	}
}

unwrap: fun(imm outer: Outer) -> i32
{
	match outer
	{
		nested(val inner) =>
		{
			match inner
			{
				hold(val buffer) => ret 100 + buffer.id
				else => ret -1
			}
		}
		else => ret 0
	}
}

aliased: fun -> i32
{
	var effect = Effect.hold(Buffer(1))
	val pointer = @effect
	match imm effect
	{
		hold(val buffer) =>
		{
			*pointer = Effect.hold(Buffer(2))
			ret buffer.id
		}
		else => ret 0
	}
}

copied: fun -> i32
{
	var effect = Effect.count(1)
	val pointer = @effect
	match effect
	{
		count(val n) =>
		{
			*pointer = Effect.count(2)
			ret n
		}
		else => ret 0
	}
}

main: fun -> i32
{
	val holder = Holder(Outer.nested(Effect.hold(Buffer(7))))
	var total = 0
	if imm holder.outer is nested(val inner)
		total = describe(imm inner)

	printf("%d %d %d %d\n", describe(Effect.hold(Buffer(3))), unwrap(imm holder.outer), total, describe(Effect.count(4)))
	printf("%d %d\n", aliased(), copied())
	ret 0
}
