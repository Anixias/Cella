mod test

ext
{
	abs: fun(value: i32) -> i32
	printf: fun(format: cstr, ...) -> i32
}

size: const usize = 3
double: const usize = size * 2

Point: rec
{
	x: i32
	y: i32
}

Buffer: rec
{
	data: array[i32, double]
}

Pair: rec
{
	a: i32
	b: i64
}

pairSize: const usize = sizeOf(Pair)

Holder: rec
{
	bytes: array[u8, pairSize]
}

origin: const Point = Point(3, 4)
zero: const Point = Point()
table: const array[i32, 4] = [10, 20, 30, 40]
corners: const array[Point, 2] = [Point(1, 2), Point(5, 6)]
third: const i32 = table[2]
far: const i32 = corners[1].y

twice: ext fun(value: i32) -> i32 => value * 2
handler: const ext fun[i32 -> i32] = twice
handlers: const array[ext fun[i32 -> i32], 2] = [twice, abs]

sum: fun(values: array[i32, size]) -> i32 => values[0] + values[1] + values[2]
total: fun(values: array[i32, 4]) -> i32 => values[0] + values[1] + values[2] + values[3]

main: fun -> i32
{
	var values: array[i32, size] = [1, 2, 3]
	var buffer = Buffer()
	const count: usize = 2
	var small: array[u8, count + 1]
	printf("%d %d %zu %zu %zu %zu\n", sum(values), buffer.data[5], buffer.data.length, small.length, pairSize,
		sizeOf(Holder))

	var i: usize = 3
	var copy = origin
	printf("%d %d %d %d %d %d %d %d %d\n", origin.x, origin.y, zero.y, table[i], third, far, corners[0].x, copy.y,
		total(table))

	const point = Point(5, 7)
	var grid: array[u8, usize(point.y)]
	printf("%d %d %d %d %zu\n", handler(21), handlers[0](4), handlers[1](-7), point.x, grid.length)
	ret 0
}
