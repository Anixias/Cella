mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

V: rec
{
	x: i32

	<: op(a: V, b: V) -> bool => a.x < b.x
}

W: rec
{
	x: i32

	<: op(imm a: W, imm b: W) -> bool => a.x < b.x

	drop: op
	{
		printf("drop %d ", self.x)
	}
}

O: rec
{
	x: i32

	<: op(own a: O, own b: O) -> bool => a.x < b.x

	drop: op
	{
		printf("drop %d ", self.x)
	}
}

N: rec
{
	n: i32

	as: op(self) -> V
	{
		printf("v ")
		ret V(self.n)
	}

	as: op(self) -> W
	{
		printf("w ")
		ret W(self.n)
	}

	as: op(self) -> O
	{
		printf("o ")
		ret O(self.n)
	}
}

main: fun -> i32
{
	printf("| %d\n", i32(V(1) < N(2) < V(3)))
	printf("| %d\n", i32(W(1) < N(2) < W(3)))
	printf("| %d\n", i32(O(1) < N(2) < O(3)))
	ret 0
}
