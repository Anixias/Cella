mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Holder: rec
{
	buffer: Buffer
}

show: fun(buffer: Buffer) -> i32 = buffer.id
same: fun(buffer: Buffer, address: ptr[Buffer]) -> i32 = i32(@buffer == address)
take: fun(own buffer: Buffer) -> i32 = buffer.id
grow: fun(mut buffer: Buffer) = buffer.id += 10

main: fun -> i32
{
	var b = Buffer(1)
	var holder = Holder(Buffer(2))
	printf("%d %d %d\n", show(b = Buffer(3)), same(b = Buffer(4), @b),
		same(holder.buffer = Buffer(5), @holder.buffer))

	val c = own (b = Buffer(6))
	printf("%d %d %d\n", c.id, (b = Buffer(7)).id, take(own (b = Buffer(8))))

	var a = Buffer(0)
	a = own (b = Buffer(9))
	printf("%d\n", a.id)

	var e = Buffer(13)
	val viewed = (e = Buffer(14))
	printf("%d %d\n", viewed.id, same(viewed, @e))
	val typed: imm[Buffer] = (e = Buffer(15))
	printf("%d\n", typed.id)
	val marked: imm[Buffer] = imm (e = Buffer(16))
	printf("%d\n", marked.id)
	grow(mut (e = Buffer(17)))
	printf("%d\n", e.id)
	val changed = mut (e = Buffer(18))
	changed.id = 19
	printf("%d %d\n", e.id, i32(@(e = Buffer(20)) == @e))

	var x = 0
	var y = 0
	x = y = 10
	var values = [1, 2, 3]
	var i: usize = 0
	printf("%d %d %d %zu %d\n", x, y, values[i] = 11, i = 2, values[0])

	val moved = own (x = 12)
	printf("%d\n", moved)
	ret 0
}
