mod std.text

use std.cmp.Eq

StringComparison: pub enum
{
	exact = 0
	ignoreCase = 1
}

str: impl
{
	refEq: fun(imm left: str, imm right: str) -> bool => left.data == right.data
}

str: impl Eq
{
	
	==: op(imm left: str, imm right: str) -> bool => panic
	!=: op(imm left: str, imm right: str) -> bool => panic
}