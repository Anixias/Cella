mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	exit: fun(code: i32) -> never
}

panic: op(message: str, location: str) -> never
{
	printf("Panic at %.*s: %.*s\n", i32(location.byteLength), location.data, i32(message.byteLength), message.data)
	exit(7)
}

panic: op(location: str) -> never
{
	printf("Panic at %.*s\n", i32(location.byteLength), location.data)
	exit(8)
}

main: fun -> i32
{
	printf("start\n")
	panic
}
