mod lib

ext
{
	printf: fun(format: cstr, ...) -> i32
	exit: fun(code: i32) -> never
}

panic: pub op(message: str, location: str) -> never
{
	printf("lib panic at %.*s: %.*s\n", i32(location.byteLength), location.data, i32(message.byteLength), message.data)
	exit(9)
}

greet: pub fun = printf("hello from the prelude\n")
shout: pub fun = printf("lib shout\n")
