mod lib

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Display: pub trait
{
	print: fun(self)
}

str: impl Display
{
	print: fun(self) = printf("%.*s", i32(self.byteLength), self.data)
}

i32: impl Display
{
	print: fun(self) = printf("%d", self)
}

say: pub fun(text: fstr[Display])
{
	var i: usize = 0
	loop while i < text.holes
	{
		text.piece(i).print()
		text.value(i).print()
		i += 1
	}

	text.piece(text.holes).print()
}

log[T: Display]: pub fun(value: T) = say("log {value}\n")

Note: pub ref rec
{
	text: fstr[Display]
}

read: pub fun(note: Note) = say(note.text)
