mod test

Shape: trait
{
	area: fun(imm self) -> f64
	scale: fun(mut self, factor: f64)
	label: fun -> i32
	same: fun(imm self, imm other: Self) -> bool
	map[T]: fun(imm self, own value: T) -> T
	take: fun(own self) -> i32
	twin: get(imm self) -> Self
	mix: pvt fun(imm self) -> i32 => 1
}

Circle: rec impl Shape
{
	radius: f64

	area: fun(self) -> f64 => self.radius
	scale: fun(mut self, factor: f64)
	{
		self.radius *= factor
	}

	label: fun -> i32 => 1
	same: fun(self, other: Circle) -> bool => true
	map[T]: fun(self, own value: T) -> T => value
	take: fun(own self) -> i32 => 1
	twin: get(self) -> Circle => self
}

Plain: rec
{
	x: i32
}

Box[T]: rec
{
	value: T
}

grow: fun(mut shape: dyn[Shape]) => shape.scale(2.0)

describe: fun(imm shape: dyn[Shape]) -> f64
{
	shape.label()
	shape.same(shape)
	shape.map(1)
	shape.take()
	val t = shape.twin
	shape.mix()
	shape.scale(2.0)
	shape.missing()
	val copy: dyn[Shape] = shape
	val n = sizeOf(dyn[Shape])
	val items = [shape]
	if shape is Plain p
		ret 1.0

	if shape is dyn[Shape] d
		ret 2.0

	ret 0.0
}

main: fun -> i32
{
	val p = Plain(1)
	describe(p)
	describe(dyn[Shape](p))
	val c = Circle(1.0)
	grow(c)
	val m = match dyn[Shape](c)
	{
		Circle => 1
	}

	match dyn[Shape](c)
	{
		Circle => {}
		Circle x => {}
		else => {}
	}

	val b: Box[dyn[Shape]] = Box(c)
	ret 0
}
