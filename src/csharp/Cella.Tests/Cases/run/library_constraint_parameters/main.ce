mod test

use lib

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Cell: rec
{
	value: i32
}

Cell: impl lib.Shows[i32]
{
	show: fun(imm self, imm check: fun[imm i32 -> bool]) -> bool => check(imm self.value)
}

main: fun -> i32
{
	val cells = lib.Pair(Cell(2), Cell(3))
	val numbers = lib.Pair(4, 5)
	printf("%d %d %d %d %d\n", cells.contains(imm 3), cells.contains(imm 4), numbers.contains(imm 5),
		numbers.contains(imm 6), lib.hasSeven())
	val held = lib.Pair(lib.Holder(lib.Holder(Cell(6))), lib.Holder(lib.Holder(Cell(7))))
	printf("%d %d\n", held.contains(imm 7), held.contains(imm 8))
	ret 0
}
