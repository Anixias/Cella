mod lib

Grid: pub rec
{
	cells: array[i32, 4]

	total: fun(self, extra: array[i32, 2]) -> i32 => self.cells[0] + self.cells[3] + extra[1]
}

sum[const N: usize]: pub fun(values: array[i32, N]) -> i32
{
	var total = 0
	for value in values
		total += value

	ret total
}

first: pub fun(p: ptr[array[i32, 2]]) -> i32 => (*p)[0]
