mod test

result[T, E]: enum
{
	ok(value: T)
	err(error: E)

	?: op(own self) -> T = match own self
	{
		ok(own value) => value
		err(own error) => ret result.err(own error)
	}
}

broken[T]: enum
{
	held(value: T)

	?: op(own self) -> T = match own self
	{
		held(own value) => valu
	}
}

parse: fun(n: i32) -> result[i32, i32] = result.ok(n)

plain: fun -> i32 = parse(1)?

nothing: fun
{
	val x = parse(1)?
}

stop: fun -> never
{
	val x = parse(1)?
	while true
	{
	}
}

numbers: fun -> i32
{
	val x = 5
	ret x?
}

unused: fun -> result[i32, i32] = result.ok(broken.held(1)?)

main: fun -> i32 = 0
