mod std

when windows
{
	ext
	{
		write: ext("_write") fun(fd: i32, data: ptr, count: u32) -> i32
	}

	writeError: fun(text: str)
	{
		var data = text.data
		var remaining = text.byteLength
		while remaining > 0
		{
			var count = remaining
			if count > 2147483647
				count = 2147483647

			write(2, data, u32(count))
			data = data + count
			remaining -= count
		}
	}
}
else
{
	ext
	{
		write: fun(fd: i32, data: ptr, count: usize) -> isize
	}

	writeError: fun(text: str) => write(2, text.data, text.byteLength)
}

ext
{
	fflush: fun(stream: ptr) -> i32
	exit: fun(code: i32) -> never
}

panic: pub op(message: str, location: str) -> never
{
	fflush(null)
	writeError("Panic at ")
	writeError(location)
	writeError(": ")
	writeError(message)
	writeError("\n")
	exit(101)
}
