mod test

ext
{
	abs: fun(n: i32) -> i32
}

Effect: enum
{
	hit(amount: i32)
	none
}

Holder: rec
{
	effect: Effect
	count: i32
}

Handler: rec
{
	callback: fun[i32 -> i32]
	scale: i32
}

amount: fun(effect: Effect) -> i32 = match effect { hit(n) => n  none => 0 }

direct: fun -> i32
{
	var effect: Effect
	ret amount(effect)
}

partial: fun(flag: bool) -> i32
{
	var effect: Effect
	if flag
		effect = Effect.none

	ret amount(effect)
}

record: fun -> i32
{
	var holder: Holder
	holder.count = 1
	ret amount(holder.effect) + holder.count
}

array: fun -> i32
{
	var effects: array[Effect, 2]
	effects[0] = Effect.none
	ret amount(effects[1])
}

callback: fun -> i32
{
	var f: fun[i32 -> i32]
	ret f(1)
}

handler: fun -> i32
{
	var handler: Handler
	handler.scale = 3
	ret handler.callback(handler.scale)
}

callbacks: fun -> i32
{
	var callbacks: array[fun[i32 -> i32], 2]
	callbacks[0] = abs
	ret callbacks[1](4)
}

native: fun -> i32
{
	var f: ext fun[i32 -> i32]
	ret f(-6)
}

Pair: rec
{
	first: fun[i32 -> i32]
	second: fun[i32 -> i32]
}

Outer: rec
{
	handler: Handler
	label: i32
}

describe: fun(handler: Handler) -> i32 = handler.scale
describePair: fun(pair: Pair) -> i32 = 0
describeAll: fun(handlers: array[Handler, 2]) -> i32 = 0
describeOuter: fun(outer: Outer) -> i32 = outer.label

wholeHandler: fun -> i32
{
	var handler: Handler
	handler.scale = 3
	ret describe(handler)
}

wholePair: fun -> i32
{
	var pair: Pair
	pair.first = abs
	ret describePair(pair)
}

wholeHandlers: fun -> i32
{
	var handlers: array[Handler, 2]
	handlers[0].callback = abs
	ret describeAll(handlers)
}

wholeOuter: fun -> i32
{
	var outer: Outer
	outer.label = 1
	ret describeOuter(outer)
}

Closer: rec
{
	id: i32

	drop: op
	{
	}
}

Keeper: rec
{
	closer: Closer
	count: i32
}

describeCloser: fun(closer: Closer) -> i32 = closer.id
describeKeeper: fun(keeper: Keeper) -> i32 = keeper.count

closer: fun -> i32
{
	var closer: Closer
	ret describeCloser(closer)
}

closerField: fun -> i32
{
	var closer: Closer
	ret closer.id
}

keeper: fun -> i32
{
	var keeper: Keeper
	keeper.count = 1
	ret describeKeeper(keeper)
}

Code: enum
{
	first = 1
	held(amount: i32) = 0
}

describeCode: fun(code: Code) -> i32 = match code { first => 1  held(n) => n }

zeroCase: fun -> i32
{
	var code: Code
	ret describeCode(code)
}

main: fun -> i32 = 0
