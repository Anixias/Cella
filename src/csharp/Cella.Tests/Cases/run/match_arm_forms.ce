mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Hit: enum { miss, hit(amount: i32) }

score: fun(h: Hit) -> i32 => match h
{
	hit(0) => 1
	hit(val n) if n > 10 => 2
	hit(val n) => 3
	miss => 0
}

option[T]: enum { none, some(value: T) }

depth: fun(o: option[option[i32]]) -> i32 => match o
{
	some(some(1..10)) => 3
	some(some(val v)) => v
	some(none) => 1
	none => 0
}

size: fun(x: i32) -> i32 => match x
{
	0 => 0
	when debug
	{
		1 => 10
	}
	else
	{
		1 => 20
	}
	else => 5
}

main: fun -> i32
{
	printf("%d %d %d %d\n", score(Hit.hit(0)), score(Hit.hit(20)), score(Hit.hit(5)), score(Hit.miss))
	val a: option[option[i32]] = option.some(option.some(5))
	val b: option[option[i32]] = option.some(option.some(42))
	val c: option[option[i32]] = option.some(option.none)
	val d: option[option[i32]] = option.none
	printf("%d %d %d %d\n", depth(a), depth(b), depth(c), depth(d))
	printf("%d %d %d\n", size(0), size(1), size(2))
	var total = 0
	for i in 0..20
	{
		match i
		{
			0, 1 => total += 1
			2..5 => total += 10
			>= 15 => total += 100
			else => {}
		}
	}

	printf("%d\n", total)
	ret 0
}
