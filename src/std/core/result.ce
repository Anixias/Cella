mod std

Result[T, E]: pub enum
{
	ok(value: T)
	err(error: E)
	
	isOk: get(imm self) -> bool => self is ok(_)
	isErr: get(imm self) -> bool => self is err(_)
	
	unwrap: fun(self) -> T => match self
	{
		ok(val value) => value
		err(_) => panic "called '{nameOf(unwrap)}' on '{nameOf(err)}'"
	}
	
	expect: fun(self, message: str) -> T => match self
	{
		ok(val value) => value
		err(_) => panic message
	}
	
	valueOr: fun(self, fallback: T) -> T => match self
	{
		ok(val value) => value
		err(_) => fallback
	}
	
	map[U]: fun(self, imm selector: fun[T -> U]) -> Result[U, E] => match self
	{
		ok(val value) => ok(selector(value))
		err(val error) => err(error)
	}
	
	?: op(self) -> T => match self
	{
		ok(val value) => value
		err(val error) => ret err(error)
	}
}

Result[E]: pub enum
{
	ok
	err(error: E)
	
	isOk: get(imm self) -> bool => self is ok
	isErr: get(imm self) -> bool => self is err(_)
	
	unwrap: fun(self)
	{
		if self is err(_)
			panic "called '{nameOf(unwrap)}' on '{nameOf(err)}'"
	}
	
	expect: fun(self, message: str)
	{
		if self is err(_)
			panic message
	}
	
	?: op(self)
	{
		if self is err(val error)
			ret err(error)
	}
}