mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Ord: trait
{
	>: op(imm left: Self, imm right: Self) -> bool
}

Number: trait req Ord + copy
{
	max: fun(a: Self, b: Self) -> Self
}

Integer: trait req Number
{
	max: fun(a: Self, b: Self) -> Self => match a > b { true => a, else => b }
}

i32: impl const Integer

direct: const i32 = i32.max(10, 20)

wrapped: const fun(a: i32, b: i32) -> i32 => i32.max(a, b)

indirect: const i32 = wrapped(3, 4)

main: fun
{
	printf("%d %d\n", direct, indirect)
}
