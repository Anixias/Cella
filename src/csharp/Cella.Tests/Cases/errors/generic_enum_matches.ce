mod test

Option[T]: enum
{
	none
	some(value: T)
}

Result[T, E]: enum
{
	ok(value: T)
	err(error: E)
}

missing: fun(o: Option[i32]) -> i32 => match o { some(val v) => v }
foreign: fun(o: Option[i32]) -> i32 => match o { Result.ok(val v) => v, else => 0 }
unknown: fun(o: Option[i32]) -> i32 => match o { ok(val v) => v, else => 0 }
counted: fun(o: Option[i32]) -> i32 => match o { some() => 0, none => 1 }

main: fun -> i32 => 0
