mod test

ext
{
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Token: own rec
{
	id: i32

	drop: op
	{
		printf("drop %d\n", self.id)
	}
}

Box[T]: own rec
{
	target: pvt req ptr[T]

	new: op(value: T)
	{
		self.target = ptr[T](malloc(sizeOf(T)))
		own *self.target = value
	}

	unbox: fun(self) -> T
	{
		val target = own self.target
		val value = own *target
		free(target)
		ret value
	}

	drop: op
	{
		printf("drop box\n")
		drop *self.target
		free(self.target)
	}
}

main: fun -> i32
{
	val b = Box(Token(7))
	val t = b.unbox()
	printf("got %d\n", t.id)
	ret 0
}
