{
	hash: mod fun(self) -> u64 = 1
	seed: pvt fun -> u64 = 2
	size: mod prop i32
	{
		get(self) = self.x
		set(mut self, value)
		{
			self.x = value
		}
	}
}

Inner: mod rec impl Hash
{
	x: i32

	hash: fun(self) -> u64 = 1
	seed: mod fun -> u64 = 2
	size: prop i32
	{
		get(self) = self.x
		set(mut self, value)
