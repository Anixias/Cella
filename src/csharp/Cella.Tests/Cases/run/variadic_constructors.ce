mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

View[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	[]: op(self, i: usize) -> imm[T] => imm self.data[i]
}

Totals: rec
{
	sum: i32

	new: op(...values: View[i32])
	{
		for i in 0..values.length
			self.sum += values[i]
	}
}

Bag[T: copy]: rec
{
	count: usize
	first: T

	new: op(first: T, ...rest: View[T])
	{
		self.count = rest.length + 1
		self.first = first
	}
}

Maker: trait
{
	new: op(...values: View[i32])
	total: fun(imm self) -> i32
}

Totals: impl Maker
{
	total: fun(self) -> i32 => self.sum
}

make[T: Maker]: fun -> i32 => T(4, 5, 6).total()

again: fun(...values: View[i32]) -> i32 => Totals(...values).sum

main: fun -> i32
{
	val totals = Totals(1, 2, 3)
	val empty = Totals()
	printf("%d %d\n", totals.sum, empty.sum)

	val numbers = Bag(4, 5, 6)
	val texts = Bag[str]("x")
	val floats = Bag(1.5)
	printf("%zu %d %zu %zu %.1f\n", numbers.count, numbers.first, texts.count, floats.count, floats.first)

	printf("%d %d\n", make[Totals](), again(7, 8))
	ret 0
}
