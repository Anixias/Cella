mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

counter: var i32 = 2147483647

main: fun -> i32
{
	val a = atomic *@counter += 1
	printf("%d\n", a)
	ret 0
}

ext
{
	fflush: fun(stream: ptr) -> i32
	exit: fun(code: i32) -> never
}

when windows
{
	ext
	{
		write: ext("_write") fun(fd: i32, data: ptr, count: u32) -> i32
	}
}
else
{
	ext
	{
		write: fun(fd: i32, data: ptr, count: u32) -> i32
	}
}

panic: op(message: str, location: str) -> never
{
	val prefix = "Panic at "
	val separator = ": "
	val newline = "\n"
	fflush(null)
	write(2, prefix.data, u32(prefix.byteLength))
	write(2, location.data, u32(location.byteLength))
	write(2, separator.data, u32(separator.byteLength))
	write(2, message.data, u32(message.byteLength))
	write(2, newline.data, u32(newline.byteLength))
	exit(101)
}
