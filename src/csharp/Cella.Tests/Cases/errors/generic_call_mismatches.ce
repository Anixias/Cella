mod test

id[T]: fun(own a: T) -> T = own a
pick[T]: fun(own a: T, own b: T) -> T = own a
sum[N: val usize]: fun(values: array[i32, N]) -> i32 = 0

main: fun -> i32
{
	val small: u8 = 1
	val a = sum[4]([1, 2, 3])
	val b = pick(small, 300)
	val c = pick(true, 1)
	val x = 300
	val y: u8 = id(x)
	ret 0
}
