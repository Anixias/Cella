mod test

Text: own rec
{
	id: i32

	drop: op
	{
	}
}

Holder: rec
{
	value: req i32
}

Sized: rec
{
	n: i32

	new: op(n: i32)
	{
		self.n = n
	}
}

Secret: rec
{
	n: i32

	new: pvt op
	{
		self.n = 1
	}
}

Pair[A, B]: rec
{
	a: A
	b: B
}

twin[T: copy]: fun(value: T) -> i32 => 1

hold[T: drop]: fun(value: T) -> i32 => 1

make[T: new]: fun -> T => T()

forward[T]: fun(imm value: T) -> i32 => imm imm imm imm imm imm imm imm imm imm imm twin(value)

relay[T]: fun(value: T) -> i32 => hold(value)

build[T]: fun -> T => make[T]()

blank[T]: fun -> T => T()

main: fun -> i32
{
	imm imm imm imm imm imm imm imm imm imm imm twin(Text(1))
	imm imm imm imm imm imm imm imm imm imm imm twin(Pair(Text(1), 2))
	hold(5)
	hold(Pair(1, 2))
	make[Holder]()
	make[Sized]()
	make[Secret]()
	ret 0
}
