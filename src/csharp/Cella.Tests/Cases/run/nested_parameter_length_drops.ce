mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Token: own rec
{
	id: i32

	drop: op
	{
		printf("drop %d\n", self.id)
	}
}

take: fun(t: Token)
{
}

maybe[const N: usize]: fun(values: array[array[Token, 3], N], deep: bool)
{
	if deep
		take(values[5][0])

	printf("kept\n")
}

main: fun -> i32
{
	maybe([[Token(1), Token(2), Token(3)], [Token(4), Token(5), Token(6)]], false)
	ret 0
}
