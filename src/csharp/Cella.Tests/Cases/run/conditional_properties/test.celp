OutputType = "Executable"
SystemLinkPreference = "Dynamic"

[Flags]
strict = false

[When.debug]
OverflowChecks = false

[When."release || strict"]
OverflowChecks = true

[[When."windows || linux".ProjectReferences]]
Path = 'lib/lib.celp'

[[When.macos.ProjectReferences]]
Path = 'missing/missing.celp'
