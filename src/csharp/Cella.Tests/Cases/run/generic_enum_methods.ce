mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: enum
{
	none
	some(value: T)

	isSome: get(imm self) -> bool => self is some(_)

	orElse: fun(own self, own fallback: T) -> T
	{
		match own self
		{
			some(own v) => ret v
			none => ret fallback
		}
	}

	map[U]: fun(own self, change: fun[own T -> U]) -> Option[U]
	{
		match own self
		{
			some(own v) => ret Option.some(change(own v))
			none => ret Option.none
		}
	}

	empty: fun -> Option[T] => Option[T].none
}

Slot[T: noref]: enum
{
	vacant
	filled(value: T)

	created: var i32 = 0

	put: fun(mut self, own value: T)
	{
		match mut self
		{
			filled(val current) => current = own value
			vacant => self = Slot.filled(own value)
		}
	}

	make: fun(own value: T) -> Slot[T]
	{
		created += 1
		ret Slot.filled(own value)
	}
}

double: fun(own n: i32) -> i64 => i64(n) * 2

find[T]: fun(own value: T, present: bool) -> Option[T]
{
	if present
		ret Option.some(own value)

	ret Option.none
}

either[T]: fun(own first: Option[T], own second: Option[T]) -> Option[T]
{
	if first.isSome
		ret first

	ret second
}

main: fun -> i32
{
	val a = Option.some(21)
	val b = a.map(double)
	printf("%d %lld %d\n", i32(a.isSome), b.orElse(0), i32(Option[i8].empty().isSome))
	printf("%d %d %d\n", find(4, true).orElse(-1), find(4, false).orElse(-1),
		either(Option[i32].none, Option.some(8)).orElse(0))

	var s = Slot[i32].make(1)
	s.put(2)
	val t = Slot[i64].make(3)
	printf("%d %d %d\n", match s { filled(val v) => v, vacant => 0 }, Slot[i32].created, Slot[i64].created)
	ret 0
}
