mod test

Eq: trait
{
	==: op(imm a: Self, imm b: Self) -> bool
}

grow[N: const usize]: fun(values: array[i32, N]) -> array[i32, N + 1] => undef

doubled[N: const usize]: rec
{
	items: array[i32, N * 2]
}

signed[N: const i32]: rec
{
	items: array[i32, N]
}

floaty[N: const f64]: rec
{
	value: i32
}

lettered[N: const char]: rec
{
	value: i32
}

Vector: rec
{
	x: i32

	+[N: const usize]: op(a: Vector, b: Vector) -> Vector => a
	[][N: const usize]: op(self, i: usize) -> i32 => 0
}

array[T]: impl Eq
{
	==: op(imm a: array[T, 1], imm b: array[T, 1]) -> bool => true
}

Sized: trait
{
	size: fun(imm self) -> usize
}

array[N: const usize, T]: impl Sized
{
	size: fun(self) -> usize => 0
}

array[T, N: const i32]: impl Sized
{
	size: fun(self) -> usize => 0
}

ring[T, N: const usize]: rec
{
	items: array[T, N]
}

ring[N: const usize, T]: impl Sized
{
	size: fun(self) -> usize => 0
}

main: fun -> i32 => 0
