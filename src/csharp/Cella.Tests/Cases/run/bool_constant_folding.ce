mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Enabled: const bool = true
Disabled: const bool = !Enabled
Mixed: const bool = Enabled && !Disabled || Disabled
Neither: const bool = Disabled || Disabled && Enabled
Same: const bool = Enabled == !Disabled
Different: const bool = Enabled != Disabled

main: fun -> i32
{
	printf("%d %d %d %d %d\n", i32(Mixed), i32(Neither), i32(Same), i32(Different), i32(Disabled))
	ret 0
}
