mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Ordering: pub enum
{
	less = -1
	equal = 0
	greater = 1
}

Ord: pub trait
{
	compare: fun(imm left: Self, imm right: Self) -> Ordering

	<: op(imm left: Self, imm right: Self) -> bool => match Self.compare(imm left, imm right) { less => true, else => false }
}

Ranked: pub trait req Ord
{
	rank: fun(imm self) -> i32

	compare: fun(imm left: Self, imm right: Self) -> Ordering
	{
		if left.rank() < right.rank()
			ret Ordering.less
		if left.rank() > right.rank()
			ret Ordering.greater
		ret Ordering.equal
	}
}

Card: rec impl Ranked
{
	value: i32

	rank: fun(imm self) -> i32 => self.value
}

Reversed: rec impl Ranked
{
	value: i32

	rank: fun(imm self) -> i32 => self.value

	compare: fun(imm left: Reversed, imm right: Reversed) -> Ordering => Ordering.equal
}

lowest[T: Ranked]: fun(a: T, b: T) -> T
{
	if T.compare(imm b, imm a) == Ordering.less
		ret b
	ret a
}

main: fun -> i32
{
	printf("card %d %d %d\n", i32(Card.compare(imm Card(1), imm Card(2))), i32(Card(5) < Card(3)), lowest(Card(9), Card(4)).value)
	printf("reversed %d\n", i32(Reversed.compare(imm Reversed(1), imm Reversed(2))))
	ret 0
}
