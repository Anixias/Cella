mod test

Buffer: own rec
{
	data: ptr

	drop: op
	{
	}
}

Holder: own rec
{
	buffer: Buffer
	count: i32
}

Packet: ext enum
{
	empty
	full(holder: Holder)
}

Callbacks: rec
{
	onBuffer: ext fun[Buffer -> i32]
	onAddress: ext fun[ptr[Buffer] -> i32]
}

ext
{
	show: fun(buffer: Buffer) -> i32
	keep: fun(buffer: Buffer)
	fill: fun(mut buffer: Buffer)
	make: fun -> Buffer
	hold: fun(holder: Holder)
	send: fun(packet: Packet)
	all: fun(buffers: array[Buffer, 2])
	register: fun(callback: ext fun[Buffer -> i32])
	peek: fun(buffer: ptr[Buffer]) -> i32
}

echo: ext fun(buffer: Buffer) -> Buffer => buffer
forward: fun(imm callback: fun[ext fun[Buffer]]) {}

main: fun -> i32 => 0
