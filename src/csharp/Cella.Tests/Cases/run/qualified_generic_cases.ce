mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: enum
{
	none
	some(value: T)

	==: op(imm a: Option[T], imm b: Option[T]) -> bool => match a
	{
		none => b is none
		else => false
	}
}

read: fun(o: Option[i32]) -> i32 => match o
{
	some(val v) => v
	none => -1
}

both[T]: fun(imm a: Option[T], imm b: Option[T]) -> i32 => 2

Reader: rec
{
	k: i32

	read: fun(self, o: Option[i64]) -> i64 => match o
	{
		some(val v) => v
		none => -2
	}
}

main: fun -> i32
{
	val r = Reader(1)
	val a = Option[i32].none
	printf("%d %lld %d %d %d\n", read(Option.none), r.read(Option.none), both(Option.some(5), Option.none),
		read(Option.some(7)), i32(a == Option.none))
	ret 0
}
