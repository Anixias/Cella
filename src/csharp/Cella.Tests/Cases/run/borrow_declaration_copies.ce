mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Point: rec
{
	x: i32
}

Box: rec
{
	inner: Point

	*: op(imm self) -> imm[Point] = self.inner
}

snapshot: fun(mut p: Point) -> i32
{
	val before = p
	p.x = 9
	ret before.x
}

main: fun -> i32
{
	var x = 1
	val r = imm x
	val c = r
	val kept = imm r
	var p = Point(1)
	val rp = imm p
	val cp = rp
	var b = Box(Point(2))
	val viaDeref = *b
	val m = mut x
	val alias = mut m
	val copied = m
	x = 5
	p.x = 5
	b.inner.x = 6
	alias += 1
	var points = [Point(1), Point(2)]
	var total = 0
	for mut q in points
	{
		val start = q
		q.x += 10
		total += start.x
	}

	printf("%d %d %d %d %d %d %d %d %d\n", r, c, kept, cp.x, viaDeref.x, x, copied, snapshot(mut p), total)
	ret 0
}
