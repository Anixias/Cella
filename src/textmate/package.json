{
	"name": "cella",
	"displayName": "Cella",
	"description": "Cella language support",
	"version": "0.1.0-dev",
	"publisher": "anixias",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Anixias/Cella.git"
	},
	"engines": {
		"vscode": "^1.91.0"
	},
	"categories": [
		"Programming Languages"
	],
	"main": "./extension.js",
	"scripts": {
		"package": "node sync-version.js && vsce package --skip-license"
	},
	"contributes": {
		"languages": [
			{
				"id": "cella",
				"aliases": ["Cella", "cella"],
				"extensions": [".ce"],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/cella.svg",
					"dark": "./icons/cella.svg"
				}
			},
			{
				"id": "cella-project",
				"aliases": ["Cella Project"],
				"extensions": [".celp"],
				"configuration": "./celp-language-configuration.json",
				"icon": {
					"light": "./icons/cella.svg",
					"dark": "./icons/cella.svg"
				}
			}
		],
		"commands": [
			{ "command": "cella.newProject", "title": "New Project", "category": "Cella" },
			{ "command": "cella.editProjectFile", "title": "Edit Project File", "category": "Cella", "icon": "$(edit)" },
			{ "command": "cella.properties", "title": "Properties", "category": "Cella" },
			{ "command": "cella.addReference", "title": "Add Project Reference…", "category": "Cella" },
			{ "command": "cella.removeReference", "title": "Remove Reference", "category": "Cella" },
			{ "command": "cella.buildProject", "title": "Build", "category": "Cella" },
			{ "command": "cella.runProject", "title": "Run", "category": "Cella" },
			{ "command": "cella.debugProject", "title": "Debug", "category": "Cella" },
			{ "command": "cella.newFile", "title": "New Cella File…", "category": "Cella" },
			{ "command": "cella.refreshProjects", "title": "Refresh", "category": "Cella", "icon": "$(refresh)" }
		],
		"views": {
			"explorer": [
				{ "id": "cella.projects", "name": "Cella Projects", "when": "cella.hasProjects" }
			]
		},
		"viewsWelcome": [
			{
				"view": "explorer",
				"contents": "[New Cella Project](command:cella.newProject)",
				"when": "workbenchState == empty"
			}
		],
		"menus": {
			"view/title": [
				{ "command": "cella.refreshProjects", "when": "view == cella.projects", "group": "navigation" }
			],
			"view/item/context": [
				{ "command": "cella.editProjectFile", "when": "view == cella.projects && viewItem =~ /^cellaProject/", "group": "inline" },
				{ "command": "cella.buildProject", "when": "view == cella.projects && viewItem =~ /^cellaProject/", "group": "1_build@1" },
				{ "command": "cella.runProject", "when": "view == cella.projects && viewItem == cellaProjectExecutable", "group": "1_build@2" },
				{ "command": "cella.debugProject", "when": "view == cella.projects && viewItem == cellaProjectExecutable", "group": "1_build@3" },
				{ "command": "cella.newFile", "when": "view == cella.projects && viewItem =~ /^cella(Project|Folder)/", "group": "2_add@1" },
				{ "command": "cella.addReference", "when": "view == cella.projects && viewItem =~ /^cella(Project|References)/", "group": "2_add@2" },
				{ "command": "cella.editProjectFile", "when": "view == cella.projects && viewItem =~ /^cellaProject/", "group": "3_project@1" },
				{ "command": "cella.properties", "when": "view == cella.projects && viewItem =~ /^cellaProject/", "group": "3_project@2" },
				{ "command": "cella.removeReference", "when": "view == cella.projects && viewItem == cellaReference", "group": "3_project@1" }
			],
			"explorer/context": [
				{ "command": "cella.addReference", "when": "resourceExtname == .celp", "group": "7_cella@1" },
				{ "command": "cella.properties", "when": "resourceExtname == .celp", "group": "7_cella@2" }
			],
			"commandPalette": [
				{ "command": "cella.removeReference", "when": "false" },
				{ "command": "cella.editProjectFile", "when": "cella.hasProjects" },
				{ "command": "cella.properties", "when": "cella.hasProjects" },
				{ "command": "cella.addReference", "when": "cella.hasProjects" },
				{ "command": "cella.buildProject", "when": "cella.hasProjects" },
				{ "command": "cella.runProject", "when": "cella.hasProjects" },
				{ "command": "cella.debugProject", "when": "cella.hasProjects" },
				{ "command": "cella.newFile", "when": "cella.hasProjects" },
				{ "command": "cella.refreshProjects", "when": "cella.hasProjects" }
			]
		},
		"customEditors": [
			{
				"viewType": "cella.projectProperties",
				"displayName": "Cella Project Properties",
				"selector": [{ "filenamePattern": "*.celp" }],
				"priority": "option"
			}
		],
		"grammars": [
			{
				"language": "cella",
				"scopeName": "source.cella",
				"path": "./syntaxes/cella.tmLanguage.json"
			},
			{
				"language": "cella-project",
				"scopeName": "source.celp",
				"path": "./syntaxes/celp.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "Cella",
			"properties": {
				"cella.server.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "Path to a `cella-lsp` executable to run instead of the installed Cella's language server."
				},
				"cella.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "Path to the `cella` executable to build with."
				}
			}
		},
		"breakpoints": [
			{
				"language": "cella"
			}
		],
		"debuggers": [
			{
				"type": "cella",
				"label": "Cella",
				"languages": ["cella"],
				"configurationAttributes": {
					"launch": {
						"required": ["project"],
						"properties": {
							"project": {
								"type": "string",
								"description": "The .celp project to build and run."
							},
							"function": {
								"type": "string",
								"description": "A pub function to run instead of main, like app.demo."
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"default": [],
								"description": "Arguments for the program."
							},
							"release": {
								"type": "boolean",
								"default": false,
								"description": "Build in release mode."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "cella",
						"request": "launch",
						"name": "Run",
						"project": "${workspaceFolder}/app.celp"
					}
				],
				"configurationSnippets": [
					{
						"label": "Cella: Launch",
						"body": {
							"type": "cella",
							"request": "launch",
							"name": "Run",
							"project": "^\"\\${workspaceFolder}/app.celp\""
						}
					}
				]
			}
		],
		"taskDefinitions": [
			{
				"type": "cella",
				"required": ["project"],
				"properties": {
					"project": {
						"type": "string",
						"description": "The .celp project to build."
					},
					"release": {
						"type": "boolean",
						"description": "Build in release mode."
					}
				}
			}
		]
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.2"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.9.2"
	},
	"activationEvents": ["workspaceContains:**/*.celp"]
}
