mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

maxI32: const i32 = 2147483647
wrapAdd: const i32 = maxI32 +% 1
wrapMul: const u8 = u8(200) *% 3
divTrunc: const i32 = i32(-7) / 2
remSign: const i32 = i32(-7) % 3
minRem: const i32 = i32(-2147483648) % -1
shl: const i32 = 1 << 31
sarNeg: const i32 = i32(-16) >> 2
shrU: const u32 = u32(4000000000) >> 3
rotl: const u8 = u8(129) <<< 1
rotr: const u16 = u16(1) >>> 1
notU: const u16 = ~u16(0)
mixed: const bool = i32(-1) < u32(1)
chain: const bool = i32(1) < 3 < 2
hugeU: const u128 = u128(18446744073709551615) * u128(18446744073709551615)
highWord: const u64 = u64(hugeU >> 64)

sum32: const f32 = f32(0.1) + 0.2
sum64: const f64 = f64(0.1) + 0.2
quot32: const f32 = f32(1) / f32(3)
rem64: const f64 = f64(-7.5) % 2.0
truncated: const i64 = i64(-2.9)
rounded: const f32 = f32(16777217)
wide: const f64 = f64(9007199254740993)
nanCompare: const bool = (0.0 / 0.0) != (0.0 / 0.0)

main: fun -> i32
{
	var a: i32 = 2147483647
	var b: u8 = 200
	var c: i32 = -7
	var d: i32 = -2147483648
	var e: i32 = 1
	var f: i32 = -16
	var g: u32 = 4000000000
	var h: u8 = 129
	var k: u16 = 1
	var m: u16 = 0
	var n: i32 = -1
	var p: u32 = 1
	var q: u128 = 18446744073709551615
	printf("%d %d|%d %d|%d %d|%d %d|%d %d|%d %d|%d %d|%u %u\n", wrapAdd, a +% 1, wrapMul, b *% u8(3), divTrunc, c / 2,
		remSign, c % 3, minRem, d % -1, shl, e << 31, sarNeg, f >> 2, shrU, g >> 3)
	printf("%d %d|%d %d|%d %d|%d %d|%d|%llu %llu\n", rotl, h <<< 1, rotr, k >>> 1, notU, ~m, mixed, n < p, chain,
		highWord, u64((q * q) >> 64))

	var x: f32 = 0.1
	var y: f32 = 0.2
	var u: f64 = 0.1
	var v: f64 = 0.2
	var one: f32 = 1
	var three: f32 = 3
	var r: f64 = -7.5
	var two: f64 = 2.0
	var zero: f64 = 0.0
	var neg: f64 = -2.9
	var odd: i64 = 16777217
	var odd64: i64 = 9007199254740993
	printf("%.9g %.9g|%.17g %.17g|%.9g %.9g|%.17g %.17g|%lld %lld\n", sum32, x + y, sum64, u + v, quot32,
		one / three, rem64, r % two, truncated, i64(neg))
	printf("%.9g %.9g|%.17g %.17g|%d %d\n", rounded, f32(odd), wide, f64(odd64), nanCompare,
		(zero / zero) != (zero / zero))
	ret 0
}
