mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Point: rec
{
	x: i32

	len: fun(self) -> i32 => self.x

	name: fun(self) -> cstr => nameOf(self)

	field: fun(self) -> cstr => nameOf(self.x)

	make: fun -> Point => Point(0)
}

main: fun -> i32
{
	val p = Point(1)
	val a: cstr = nameOf(p.len)
	val b: cstr = nameOf(Point.len)
	val c: cstr = nameOf(Point.make)
	printf("%s %s %s %s %s\n", a, b, p.name(), p.field(), c)
	ret 0
}
