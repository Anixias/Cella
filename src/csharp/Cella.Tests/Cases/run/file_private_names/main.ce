mod test

ext
{
	printf: pvt fun(format: cstr, ...) -> i32
}

Node: pvt rec
{
	value: i32

	new: op(value: i32)
	{
		self.value = value
	}

	describe: fun(self) -> i32 = self.value + 1

	drop: op
	{
		printf("main node %d\n", self.value)
	}
}

limit: pvt val i32 = 10

helper: pvt fun(value: i32) -> i32 = value + limit

main: fun -> i32
{
	val node = Node(1)
	printf("%d %d %d\n", helper(1), node.describe(), other())
	ret 0
}
