mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

Texture: rec
{
	id: i32

	drop: op
	{
	}
}

TextureBox: rec
{
	pointer: pvt ptr[Texture]

	new: op(own texture: Texture)
	{
		self.pointer = ptr[Texture](malloc(sizeOf(Texture)))
		own *self.pointer = own texture
	}

	*: op(self) -> imm[Texture] = imm *self.pointer

	drop: op
	{
		drop *self.pointer
		free(self.pointer)
	}
}

keep: fun(own box: TextureBox)
{
}

typed: fun(texture: Texture)
{
	val same: Texture = texture
	val moved = own texture
}

reassigned: fun -> i32
{
	var texture = Texture(3)
	val viewed = (texture = Texture(4))
	texture = Texture(5)
	ret viewed.id
}

leak: fun -> imm[Texture]
{
	val held = TextureBox(Texture(1))
	val inside = *held
	ret inside
}

main: fun -> i32
{
	val held = TextureBox(Texture(2))
	val inside = *held
	keep(own held)
	printf("%d\n", inside.id)
	ret 0
}
