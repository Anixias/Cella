mod test

nullable[T: null]: enum match T
{
	none = null
	some(value) = else
}

socket: enum match i32
{
	invalid = -1
	valid(handle) = else
}

Point: rec
{
	x: i32
}

wrap[T: null]: fun(own value: T) -> nullable[T] = some(value)

unwrap[T: null]: fun(n: nullable[T]) -> T = T(n)

describe: fun(s: socket) -> i32 = match s { valid(h) => h }

main: fun -> i32
{
	val a = wrap(5)
	val b = wrap[Point](Point(1))
	var s = socket(3)
	match mut s
	{
		valid(h) => h = 4
		invalid => s = invalid
	}

	val raw = f32(s)
	ret 0
}
