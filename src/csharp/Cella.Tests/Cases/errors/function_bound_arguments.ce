mod test

ext
{
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

Boxed[K: trait]: rec
{
	object: pvt ptr[dyn[K]]

	of[T: K + noref]: fun(own value: T) -> Boxed[K]
	{
		val memory = ptr[T](malloc(sizeOf(T)))
		own *memory = value
		ret Boxed[K](memory)
	}

	*: op(imm self) -> imm[dyn[K]] => imm *self.object

	drop: op
	{
		drop *self.object
		free(self.object)
	}
}

twice[F: fun[i32 -> i32]]: fun(imm f: F, x: i32) -> i32 => f(f(x))

misuse[F: fun[i32 -> i32]]: fun(imm f: F) -> i32 => f(true)

Holder[K: trait]: rec
{
	value: i32
}

answer: fun -> i32 => 42

main: fun -> i32
{
	val wrong = twice(5, 1)
	val fewer = twice(fun => 4, 1)
	val bad = Holder[ref fun[-> i32]](1)
	var count = 0
	val borrowing = Boxed[fun[-> i32]].of(fun -> i32 => count)
	val next = Boxed[fun[-> i32]].of(answer)
	next(5)
	val n: i32 = *next
	ret 0
}
