mod test

Point: rec
{
	x: i32
}

make: fun -> Point
{
	var point: Point
	ret point
}

check: fun -> i32
{
	var count = 3
	if @make().x == null
		ret 1

	while count / 0 > 0
		count -= 1

	do
	{
		count += 1
	} while @make().x == null

	for _ in 0..count % 0
	{
	}

	ret undef
}

main: fun -> i32
{
	ret 0
}
