mod lib

ext
{
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

Boxed[K: trait]: pub own rec
{
	object: pvt ptr[dyn[K]]

	of[T: K + noref]: fun(value: T) -> Boxed[K]
	{
		val memory = ptr[T](malloc(sizeOf(T)))
		own *memory = value
		ret Boxed[K](memory)
	}

	*: op(imm self) -> imm[dyn[K]] => imm *self.object

	drop: op
	{
		drop *self.object
		free(self.object)
	}
}

Counter[F: fun[-> i32]]: pub rec
{
	f: F

	get: fun(imm self) -> i32 => self.f()
}
