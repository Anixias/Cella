mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Countdown: own rec
{
	left: i32

	for: op(mut self) -> bool
	{
		self.left -= 1
		ret self.left >= 0
	}

	*: op(imm self) -> imm[i32] => imm self.left
}

Ticket: own enum
{
	open(id: i32)
	closed
}

finish: fun(c: Countdown) -> i32 => c.left
peek: fun(imm c: Countdown) -> i32 => c.left

main: fun -> i32
{
	var c = Countdown(4)
	for x in mut c
	{
		if x == 2
			break
	}

	printf("%d %d\n", peek(imm c), c.left)
	val d = c
	for x in d
		printf("%d ", x)

	val t = Ticket.open(3)
	val u = t
	printf("| %d\n", finish(Countdown(9)))
	ret 0
}
