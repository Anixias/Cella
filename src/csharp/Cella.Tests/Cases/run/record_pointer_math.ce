mod test

Wide: rec
{
	flag: bool
	big: i64
	small: i16
}

Node: rec
{
	value: i32
	next: ptr[Node]
}

main: fun -> i32
{
	var wide: Wide
	var first = @wide
	var fourth = first + 3

	var bytes = usize(fourth) - usize(first)
	var expected: usize = 3 * sizeOf(Wide)
	if bytes != expected
		ret 1

	var count: isize = 3
	if fourth - first != count
		ret 2

	var node: Node
	var head = @node
	if head + 3 - head != count
		ret 3

	var target: ptr[i32]
	var slot = @target
	if slot + 3 - slot != count
		ret 4

	ret 0
}
