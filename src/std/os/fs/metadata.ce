mod std.fs

use std.Result
use std.io.IoError
use std.path.Path

EntryKind: pub enum
{
	file
	directory
	symbolicLink
	other
}

Metadata: pub rec
{
	kind: pvt set EntryKind
	size: pvt set u64
	attributes: pvt set Attributes
	device: pvt u64
	node: pvt u64
	// TODO: creation, modification and access times, once std has a date-time type
	
	new: mod op(kind: EntryKind, size: u64, attributes: Attributes, device: u64, node: u64)
	{
		self.kind = kind
		self.size = size
		self.attributes = attributes
		self.device = device
		self.node = node
	}
	
	sameEntry: mod fun(imm self, other: Metadata) -> bool => self.device == other.device && self.node == other.node
}

metadata: pub fun(path: Path, followLinks: bool = true) -> Result[Metadata, IoError] => pathMetadata(path, followLinks)

setAttributes: pub fun(path: Path, attributes: Attributes) -> Result[IoError] => setPathAttributes(path, attributes)

exists: pub fun(path: Path) -> bool => metadata(path) is ok(_)