mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Point: rec
{
	x: i32
	y: i32

	snapshot: fun(self, mut x: i32) -> i32
	{
		x = 99
		ret self.x
	}

	live: fun(imm self, mut x: i32) -> i32
	{
		x = 99
		ret self.x
	}
}

Slots: rec
{
	values: array[i32, 3]

	[]: op(imm self, i: usize) -> imm[i32] = imm self.values[i]
}

Holder[T]: rec
{
	value: T

	*: op(imm self) -> imm[T] = imm self.value
}

Shape: trait
{
	area: fun(imm self) -> i32
}

Square: rec impl Shape
{
	side: i32

	area: fun(self) -> i32 = self.side * self.side
}

measure[T: Shape]: fun(imm value: T) -> i32 = value.area()

total: fun(imm shape: dyn[Shape]) -> i32 = shape.area()

main: fun -> i32
{
	var p = Point(1, 2)
	val first = p.snapshot(mut p.x)
	p.x = 1
	val second = p.live(mut p.x)
	val slots = Slots([4, 5, 6])
	val holder = Holder(7)
	printf("%d %d %d %d %d %d %d\n", first, second, slots[1], *holder, measure(Square(3)), total(Square(4)),
		Square(5).area())
	ret 0
}
