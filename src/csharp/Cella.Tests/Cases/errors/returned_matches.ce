mod test

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Stats: rec
{
	kills: i32
}

Effect: enum
{
	none
	hold(buffer: Buffer)
	count(value: i32)
}

Slot: enum
{
	empty
	held(buffer: Buffer)

	orElse: fun(imm self, imm fallback: Buffer) -> imm[Buffer] => match self
	{
		held(val buffer) => buffer
		empty => fallback
	}
}

kills: fun(mut stats: Stats) -> mut[i32] => mut stats.kills

make: fun -> Effect => Effect.hold(Buffer(1))

pick: fun(imm effect: Effect, own fallback: Buffer) -> imm[Buffer] => match effect
{
	hold(val buffer) => buffer
	else => imm fallback
}

every: fun(imm effect: Effect, own a: Buffer, own b: Buffer) -> imm[Buffer] => match effect
{
	hold(val buffer) => imm a
	else => imm b
}

nested: fun(imm outer: Effect, imm inner: Effect, own fallback: Buffer) -> imm[Buffer] => match outer
{
	hold(val buffer) => buffer
	else => match inner
	{
		hold(val buffer) => buffer
		else => imm fallback
	}
}

called: fun(imm effect: Effect) -> mut[i32]
{
	var stats = Stats(1)
	ret match effect
	{
		count(val value) => kills(mut stats)
		else => kills(mut stats)
	}
}

copied: fun(imm effect: Effect, x: i32) -> imm[i32] => match effect
{
	count(val value) => imm value
	else => imm x
}

owned: fun(imm fallback: Buffer) -> imm[Buffer] => match make()
{
	hold(val buffer) => buffer
	else => imm fallback
}

stored: fun(imm effect: Effect, own fallback: Buffer) -> imm[Buffer]
{
	val result: imm[Buffer] = match effect
	{
		hold(val buffer) => buffer
		else => imm fallback
	}
	ret result
}

main: fun -> i32 => 0
