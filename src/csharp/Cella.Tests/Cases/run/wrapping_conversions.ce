mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

wrapped: val u8 = u8((200 + 100) & 0xFF)
shifted: val i32 = 1 << 31
remainder: val i32 = -2147483648 % -1

main: fun -> i32
{
	var runtime: u8 = 200
	val sum = runtime +% 100
	val widened = i32(2147483647) +% 1
	val fits: u8 = 200 + 55
	val lowest: i8 = -100 - 28
	val wide: i64 = 2147483647 * 4
	printf("%d %d %d %d %d %d %d %lld\n", wrapped, shifted, remainder, sum, widened, fits, lowest, wide)
	ret 0
}
