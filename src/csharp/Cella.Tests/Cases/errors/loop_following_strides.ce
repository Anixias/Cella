mod test

down: fun -> i32
{
	var buf: array[u8, 200000] = undef
	var i: usize = 200000
	while i > 1
	{
		i -= 1
		buf[i] = 1
	}

	ret i32(buf[0])
}

short: fun -> i32
{
	var buf: array[u8, 200000] = undef
	var i: usize = 0
	while i < 199998
	{
		buf[i] = 1
		buf[i + 1] = 2
		i += 2
	}

	ret i32(buf[199998])
}

main: fun -> i32 => down() + short()
