mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Box[T]: rec
{
	value: T

	map[U]: fun(self, imm change: fun[T -> U]) -> Box[U] => Box(change(self.value))

	twice: fun(self, imm change: fun[T -> T]) -> T => change(change(self.value))

	same: fun(self) -> Box[T] => self.map(fun(x) => x)
}

Scored: trait
{
	score: fun(imm self) -> i32

	bonus: fun(imm self) -> i32 => apply(fun(x) => x + 100, self.score())
}

Player: rec impl Scored
{
	points: i32

	score: fun(self) -> i32 => self.points
}

apply: fun(imm f: fun[i32 -> i32], x: i32) -> i32 => f(x)

pass[T]: fun(imm f: fun[T -> T], x: T) -> T => f(x)

call[T]: fun(imm f: fun[-> T]) -> T => f()

same[T]: fun(x: T) -> T => pass(fun(y) => y, x)

last[T]: fun(x: T, y: T) -> T => pass(fun(z: T) -> T
{
	val w: T = z
	ret w
}, y)

deep[T]: fun(x: T) -> T => pass(fun(y) => pass(fun(z) => z, y), x)

both[T]: fun(x: T, y: T) -> T
{
	val a = pass(fun(v) => v, x)
	val b = pass(fun(v) => v, y)
	if call(fun -> i32 => 7) == 7
		ret b

	ret a
}

main: fun -> i32
{
	printf("%d %f %d %d %f\n", same(3), same(1.5), last(1, 2), deep(9), deep(0.5))
	printf("%d %f\n", both(1, 2), both(0.5, 1.5))

	val doubled = Box(21).map(fun(x) => x * 2)
	val scaled = Box(1.5).map(fun(x) => i32(x * 4.0))
	printf("%d %d %d %f\n", doubled.value, scaled.value, Box(3).twice(fun(x) => x * x), Box(0.25).same().value)
	printf("%d\n", Player(5).bonus())
	ret 0
}
