mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

main: fun -> i32
{
	val a = lib.Option[i32].wrap(5)
	val b = lib.Option.some(lib.Token(7))
	val c: lib.Option[lib.Token] = lib.Option.none
	val d = lib.first(c, b)
	printf("%d %d %d ", a.orElse(0), i32(d.isSome), lib.libraryCount())
	printf("%d %d | ", lib.Option[i32].made, lib.Option[i64].made)
	ret 0
}
