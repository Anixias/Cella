mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Make: trait
{
	new: op(value: i32)
}

Empty: trait
{
	new: op
}

Cell: rec impl Make + Empty
{
	n: i32

	new: op(value: i32)
	{
		self.n = value + 1
	}

	new: op
	{
		self.n = 77
	}
}

First: trait
{
	new: op(value: i32)
}

Second: trait
{
	new: op(value: i32)
}

i32: impl First + Second
{
}

Slot: rec
{
	size: usize

	new: op(size: usize)
	{
		self.size = size * 2
	}
}

Pool[T: new(usize)]: rec
{
	first: T

	new: op(size: usize)
	{
		self.first = T(size)
	}

	grow: fun(imm self, size: usize) -> T => T(size + 1)
}

Box[T]: rec
{
	value: T
}

Box[T: new(i32)]: impl
{
	fresh: fun(imm self) -> T => T(3)
}

Wrapper[T]: rec
{
	n: i32

	new: op(value: i32)
	{
		self.n = value + 40
	}
}

Holder[E]: rec
{
	value: E

	make[T: new(E)]: fun(imm self) -> T => T(self.value)
}

Wrapped: rec
{
	n: i32

	new: op(value: i32)
	{
		self.n = value
	}

	new: op(value: Box[Wrapped])
	{
		self.n = value.value.n + 1
	}
}

Shape: trait
{
	area: fun(imm self) -> i32
}

Square: rec impl Shape
{
	side: i32

	area: fun(self) -> i32 => self.side * self.side
}

Report: rec
{
	value: i32

	new: op(shape: ptr[dyn[Shape]])
	{
		self.value = shape.area()
	}
}

make[T: new(i32)]: fun -> T => T(5)

blank[T: new]: fun -> T => T()

forward[T: new(i32)]: fun -> T => make[T]()

viaTrait[T: Make]: fun -> T => make[T]()

viaEmpty[T: Empty]: fun -> T => blank[T]()

both[T: Make + new(i32)]: fun -> T => T(9)

twoTraits[T: First + Second]: fun -> T => T(6)

nested[T: noref + new(i32) + new(Box[T])]: fun -> T => T(Box[T](T(4)))

measure[K: trait, T: new(ptr[dyn[K]])]: fun(shape: ptr[dyn[K]]) -> T => T(shape)

main: fun -> i32
{
	printf("%d %d %d %d %d\n", forward[Cell]().n, viaTrait[Cell]().n, viaEmpty[Cell]().n, both[Cell]().n,
		twoTraits[i32]())
	val p = Pool[Slot](4)
	val b = Box[i64](1)
	printf("%llu %llu %lld %d\n", p.first.size, p.grow(5).size, b.fresh(), make[Wrapper[str]]().n)
	var s = Square(3)
	val shape: ptr[dyn[Shape]] = @s
	val h = Holder[i32](8)
	printf("%.1f %d %d\n", h.make[f64](), nested[Wrapped]().n, measure[Shape, Report](shape).value)
	ret 0
}
