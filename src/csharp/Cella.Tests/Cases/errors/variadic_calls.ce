mod test

ext
{
	strlen: fun(text: cstr) -> usize
}

view[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}
}

all: fun(...values: view[i32]) {}
fixed: fun(first: i32, ...rest: view[i32]) {}
bytes: fun(...values: view[u8]) {}

main: fun -> i32
{
	val v = view[i32](null, 0)
	var n = 1
	all(1, ...v)
	all(...v, 1)
	all(...v, ...v)
	fixed(...v)
	strlen(...v)
	val w = view[i32](...v)
	all(mut n)
	all(v)
	bytes(1, 300)
	ret 0
}
