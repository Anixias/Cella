mod test

Ord: trait
{
	<: op(imm a: Self, imm b: Self) -> bool
}

Pair[A: noref, B]: rec
{
	a: A
	b: B
}

Copier[Element: copy]: rec
{
	value: Element
}

Dropper[Element: drop]: rec
{
	value: Element
}

Nullable[Element: null]: rec
{
	value: Element
}

Guard: own rec
{
	id: i32

	drop: op
	{
	}
}

Token: ref rec
{
	text: imm[i32]
}

Point: rec
{
	x: i32

	new: op(x: i32)
	{
		self.x = x
	}
}

make[T: new]: fun -> T => T()

build[T: new(i32)]: fun -> T => T(1)

smallest[T: Ord + copy]: fun(a: T, b: T) -> T => a

main: fun -> i32
{
	val p: Pair[Token, Token] = undef
	val q: Pair[i32, Token] = undef
	val c: Copier[Guard] = undef
	val d: Dropper[i32] = undef
	val n: Nullable[i32] = undef
	val m = make[Point]()
	val b = build[bool]()
	val s = smallest(Point(1), Point(2))
	ret 0
}
