mod test
ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: enum { none, some(value: T) }
Wrap[T]: rec { value: T }
pick: fun(imm o: Option[u16]) -> i32 => 16
pick: fun(imm o: Option[i64]) -> i32 => 64
wrap: fun(w: Wrap[i8]) -> i32 => 8
wrap: fun(w: Wrap[u8]) -> i32 => 9
main: fun -> i32
{
	printf("%d %d %d\n", pick(Option.some(5)), pick(some(5)), wrap(Wrap(5)))
	ret 0
}
