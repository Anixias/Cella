mod test

Box[T]: rec
{
	value: T

	deeper: fun(self, depth: i32) -> i32
	{
		if depth == 0
			ret 0

		ret Box(self).deeper(depth - 1)
	}
}

add[T]: fun(imm value: T) -> T => value + 1

grow[T]: fun(value: T, depth: i32) -> i32
{
	if depth == 0
		ret 0

	ret grow(Box(value), depth - 1)
}

first[T]: fun(value: T, depth: i32) -> i32
{
	if depth == 0
		ret 0

	ret second(Box(value), depth - 1)
}

second[U]: fun(value: U, depth: i32) -> i32 => first(value, depth)

main: fun -> i32 => grow(1, 3) + Box(2).deeper(1) + first(3, 2)
