mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Raw: rec
{
	p: ptr[u8]
}

sliceData: fun -> str
{
	var buffer = [u8(65), u8(66), u8(67)]
	val whole = str(@buffer[0], 3)
	ret str(whole.data + 1, 2)
}

prefixData: fun -> str
{
	var buffer = [u8(65), u8(66), u8(67)]
	val whole = str(@buffer[0], 3)
	ret str(whole.data, 2)
}

offsetLocal: fun -> str
{
	var buffer = [u8(65), u8(66), u8(67)]
	val p = @buffer[0]
	val q = p + 1
	ret str(q, 1)
}

offsetAddress: fun -> str
{
	var buffer = [u8(65), u8(66), u8(67)]
	ret str(@buffer[0] + 1, 2)
}

reassigned: fun -> str
{
	var buffer = [u8(65), u8(66), u8(67)]
	var p: ptr[u8] = null
	p = @buffer[0]
	ret str(p, 1)
}

recordField: fun -> str
{
	var buffer = [u8(65), u8(66), u8(67)]
	val r = Raw(@buffer[0])
	ret str(r.p, 2)
}

main: fun -> i32
{
	var s: str = ""
	{
		var buffer = [u8(65), u8(66), u8(67)]
		val whole = str(@buffer[0], 3)
		s = str(whole.data + 1, 2)
	}

	printf("%.*s\n", i32(s.byteLength), s.data)
	ret 0
}
