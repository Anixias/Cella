mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Option[T]: enum
{
	none
	some(value: T)

	clear: fun(mut self)
	{
		self = Option[T].none
	}
}

Token: own rec
{
	id: i32

	drop: op
	{
		printf("drop %d ", self.id)
	}
}

Holder[T]: rec
{
	item: Option[T]
	count: i32
}

make: fun(id: i32) -> Option[Token]
{
	if id > 0
		ret Option.some(Token(id))

	ret Option.none
}

main: fun -> i32
{
	val a = make(1)
	val b = make(0)
	var c = make(2)
	c = make(3)
	match make(4)
	{
		some(val t) => printf("got %d ", t.id)
		none => printf("none ")
	}

	var held = Holder(Option.some(Token(5)), 1)
	held.item.clear()
	val empty = Holder[Token]()
	printf("%d | ", i32(empty.item is none))
	ret 0
}
