mod test

Floats: enum match f32
{
	zero(value) = else
}

Texts: enum match str
{
	any(value) = else
}

Nulls: enum match i32
{
	none = null
	some(value) = else
}

Pointers: enum match ptr
{
	zero = 0
	other(value) = else
}

Repeats: enum match u8
{
	low = 1, 2
	high = 2, 3
	rest(value) = else
}

Ranged: enum match u8
{
	low = 256
	high = 3, limit()
	rest(value) = else
}

Elses: enum match u8
{
	first(value) = else
	second(value) = else
}

Missing: enum match u16
{
	low = 1
}

Flags: enum match bool
{
	on = true
}

Bare: enum match i32
{
	zero = 0
	rest = else
}

Unvalued: enum match i32
{
	zero
	rest(value) = else
}

Open[T]: enum match T
{
	none = null
	some(value) = else
}

Plain: enum
{
	low = 0, 1
	high = else
}

Borrowed: enum match imm[i32]
{
	none = null
	some(value) = else
}

Nullable[T: null]: enum match T
{
	none = null
	some(value) = else
}

Cell[T]: rec
{
	value: Nullable[T]
}

limit: fun -> u8 => 3

first[T]: fun(own value: T) -> Nullable[T] => some(value)

count: fun(numbers: Nullable[i32]) -> i32 => 0

main: fun -> i32 => 0
