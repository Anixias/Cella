mod test

Span[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[const N: usize]: op(mut values: array[T, N]) -> Span[T] => Span[T](@values, N)
}

fill: fun(values: Span[i32], value: i32) {}

keep: fun(values: Span[i32]) -> Span[i32] => values

local: fun -> Span[i32]
{
	var items = [1, 2]
	ret keep(mut items)
}

main: fun -> i32 => 0
