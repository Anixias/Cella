mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Name: own rec
{
	id: i32

	drop: op { printf("drop %d\n", self.id) }
}

Slot: own enum { empty, full(pair: Pair) }

make: fun -> Pair => Pair(Name(3), Name(4))

makeSlot: fun -> Slot => Slot.full(Pair(Name(5), Name(6)))

Pair: own rec
{
	first: Name
	second: Name
}

stored: fun
{
	var p = Pair(Name(1), Name(2))
	match imm p
	{
		Pair(first: Name(id: 1), val second) => printf("borrowed %d\n", second.id)
		else => {}
	}

	match p
	{
		Pair(val first) => printf("moved %d\n", first.id)
	}

	printf("end\n")
}

temporary: fun
{
	match make()
	{
		Pair(val first, second: Name(val id)) => printf("temp %d %d\n", first.id, id)
	}

	printf("end\n")
}

payload: fun
{
	match makeSlot()
	{
		full(Pair(val first)) => printf("got %d\n", first.id)
		empty => {}
	}

	printf("end\n")
}

main: fun -> i32
{
	stored()
	temporary()
	payload()
	ret 0
}
