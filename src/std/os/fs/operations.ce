mod std.fs

use std.Result
use std.io.IoError
use std.mem.[Allocator, Heap]
use std.path.[Path, PathBuffer]

remove: pub fun(path: Path) -> Result[IoError] => removePath(path)

copy: pub fun(from: Path, to: Path, replace: bool = false) -> Result[IoError]
{
	if isDirectoryAt(from) || isDirectoryAt(to)
		ret err(IoError(isDirectory, 0))
	
	ret copyPath(from, to, replace)
}

move: pub fun(from: Path, to: Path, replace: bool = false) -> Result[IoError]
{
	if replace && isDirectoryAt(to)
		ret err(IoError(isDirectory, 0))
	
	ret movePath(from, to, replace)
}

createDirectory: pub fun(path: Path) -> Result[IoError] => createPath(path)

createDirectories: pub fun(path: Path) -> Result[IoError]
{
	val result = createDirectory(path)
	if result is ok || isDirectoryAt(path)
		ret ok
	
	if result is err(val error) && !(error.kind is notFound)
		ret result
	
	val above = path.parent.valueOr(Path(""))
	if above.isEmpty
		ret result
	
	createDirectories(above)?
	val retry = createDirectory(path)
	if retry is err(_) && isDirectoryAt(path)
		ret ok
	
	ret retry
}

removeDirectory: pub fun(path: Path, recursive: bool = false) -> Result[IoError]
{
	if recursive
	{
		var listing = NativeListing.open(path, false)?
		val result = removeContents(mut listing)
		listing.close()
		result?
	}
	
	ret removeDirectoryPath(path)
}

canonical: pub fun(path: Path) -> Result[PathBuffer, IoError] => canonicalPath(path, Heap())

canonical[A: Allocator + noref]: pub fun(path: Path, alloc: A) -> Result[PathBuffer[A], IoError] =>
	canonicalPath(path, alloc)

tempDirectory: pub fun -> Result[PathBuffer, IoError] => tempDirectory(Heap())

tempDirectory[A: Allocator + noref]: pub fun(alloc: A) -> Result[PathBuffer[A], IoError]
{
	val found = tempDirectoryPath()?
	ret ok(withoutTrailingSeparator(found, alloc))
}

homeDirectory: pub fun -> Result[PathBuffer, IoError] => homeDirectory(Heap())

homeDirectory[A: Allocator + noref]: pub fun(alloc: A) -> Result[PathBuffer[A], IoError]
{
	val found = homeDirectoryPath()?
	ret ok(withoutTrailingSeparator(found, alloc))
}

withoutTrailingSeparator[A: Allocator + noref]: pvt fun(path: Path, alloc: A) -> PathBuffer[A]
{
	var bytes = path.bytes
	while bytes.length > 1 && isSeparator(bytes[bytes.length - 1]) && Path(bytes).parent is some(_)
		bytes = bytes.slice(0, bytes.length - 1)
	
	ret PathBuffer[A](Path(bytes), alloc)
}

isSeparator: mod fun(byte: u8) -> bool
{
	when windows
	{
		if byte == 0x5C
			ret true
	}
	
	ret byte == 0x2F
}

isDirectoryAt: mod fun(path: Path) -> bool => metadata(path) is ok(val data) && data.kind is directory