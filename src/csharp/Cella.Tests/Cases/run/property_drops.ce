mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Token: own rec
{
	id: i32

	drop: op
	{
		printf("drop %d ", self.id)
	}
}

Slot: own rec
{
	held: Token

	new: op(token: Token)
	{
		self.held = token
	}

	token: prop Token
	{
		get(imm self) => Token(self.held.id + 100)
		set(mut self, value)
		{
			self.held = value
		}
	}

	copy: set(mut self, imm value: Token)
	{
		self.held = Token(value.id + 10)
	}

	id: get(imm self) -> i32 => self.held.id
}

main: fun -> i32
{
	var slot = Slot(Token(1))
	slot.token = Token(2)
	printf("| %d ", slot.id)
	val copy = slot.token
	printf("| %d | %d ", copy.id, slot.token.id)
	val kept = Token(3)
	slot.copy = kept
	printf("| %d %d |", slot.id, kept.id)
	ret 0
}
