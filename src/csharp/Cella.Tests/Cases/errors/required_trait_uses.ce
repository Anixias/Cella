mod test

Named: trait
{
	name: fun(imm self) -> i32
}

Shape: trait req Named
{
	name: fun(imm self) -> i32
	area: fun(imm self) -> f64
}

Compare[T]: trait
{
	compare: fun(imm self, imm other: T) -> i32
}

Sortable: trait req Compare[Self]
{
	rank: fun(imm self) -> i32
}

show[T: Shape]: fun(imm value: T) -> i32 = value.name()

pick[T: Shape]: fun(imm value: T) -> i32 = Named(value).name() + Shape(value).name()

needsShape[T: Shape]: fun(imm value: T) -> f64 = value.area()

fromNamed[T: Named]: fun(imm value: T) -> f64 = needsShape(value)

narrow: fun(imm item: dyn[Named]) -> f64 = dyn[Shape](item).area()

compareAll: fun(imm item: dyn[Sortable], imm other: dyn[Sortable]) -> i32 = item.compare(other)

main: fun -> i32 = 0
