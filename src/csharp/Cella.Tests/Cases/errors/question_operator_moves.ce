mod test

Texture: rec
{
	id: i32

	drop: op
	{
	}
}

result[T, E]: enum
{
	ok(value: T)
	err(error: E)

	?: op(own self) -> T = match own self
	{
		ok(own value) => value
		err(own error) => ret result.err(own error)
	}
}

load: fun(id: i32) -> result[Texture, i32] = result.ok(Texture(id))

twice: fun -> result[i32, i32]
{
	val r = load(2)
	val a = r?
	val b = r?
	ret result.ok(a.id + b.id)
}

main: fun -> i32 = 0
