mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

Shape: trait
{
	area: fun(imm self) -> i32
}

Square: rec impl Shape
{
	side: i32

	area: fun(self) -> i32 => self.side * self.side
}

Boxed[K: trait]: own rec
{
	object: pvt ptr[dyn[K]]

	of[T: K + noref]: fun(value: T) -> Boxed[K]
	{
		val memory = ptr[T](malloc(sizeOf(T)))
		own *memory = value
		ret Boxed[K](memory)
	}

	*: op(imm self) -> imm[dyn[K]] => imm *self.object

	drop: op
	{
		drop *self.object
		free(self.object)
	}
}

keep: fun(box: Boxed[Shape]) => printf("kept\n")

leak: fun -> imm[dyn[Shape]]
{
	val box = Boxed[Shape].of(Square(3))
	val shape = *box
	ret shape
}

main: fun -> i32
{
	val box = Boxed[Shape].of(Square(3))
	val shape = *box
	keep(box)
	printf("%d\n", shape.area())
	ret 0
}
