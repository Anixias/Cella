mod std.cmp

Ordering: pub enum
{
	less = -1
	equal = 0
	greater = 1
}

Ord: pub trait req Eq
{
	compare: fun(imm left: Self, imm right: Self) -> Ordering
	{
		if (left == right)
			ret equal
		
		if (left < right)
			ret less
		
		ret greater
	}
	
	<: op(imm left: Self, imm right: Self) -> bool =>
		match compare(imm left, imm right) { less => true, else => false }
	
	<=: op(imm left: Self, imm right: Self) -> bool =>
		match compare(imm left, imm right) { greater => false, else => true }
	
	>: op(imm left: Self, imm right: Self) -> bool =>
		match compare(imm left, imm right) { greater => true, else => false }
	
	>=: op(imm left: Self, imm right: Self) -> bool =>
		match compare(imm left, imm right) { less => false, else => true }
}