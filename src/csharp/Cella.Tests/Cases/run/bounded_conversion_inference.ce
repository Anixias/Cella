mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Spannable[T]: trait
{
	spanned: fun(mut self) -> Span[T]
}

Span[T]: ref rec
{
	data: ptr[T]
	length: usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[N: const usize]: op(mut values: array[T, N]) -> Span[T] => Span[T](ptr[T](ptr(@values)), N)

	as[C: Spannable[T]]: op(mut values: C) -> Span[T] => values.spanned()
}

Bag: rec
{
	items: array[i32, 2]
}

Bag: impl Spannable[i32]
{
	spanned: fun(mut self) -> Span[i32] => Span[i32](ptr[i32](ptr(@self.items)), 2)
}

check[T: copy]: fun(values: Span[T], imm test: fun[T -> bool]) -> bool => test(values.data[0])

main: fun -> i32
{
	var numbers: array[i32, 4] = [1, 2, 3, 4]
	var bag = Bag([5, 6])
	var loose = [7, 8, 9]
	printf("%d %d %d\n", i32(check(mut numbers, fun(a) => a > 0)), i32(check(mut bag, fun(a) => a > 5)),
		i32(check(mut loose, fun(a) => a > 7)))
	ret 0
}
