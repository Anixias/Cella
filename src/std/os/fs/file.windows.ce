mod std.fs

use when windows

use std.[Option, Result, Span, View]
use std.io.[IoError, SeekFrom]
use std.mem.[Allocator, BitSet, Heap, Layout]
use std.path.[Path, PathBuffer]

pvt ext
{
	// https://learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-createfilew
	CreateFileW: fun(path: ptr[u16], access: Access, share: Share, security: ptr, disposition: Disposition,
		flags: Flags, template: ptr) -> ptr
	
	ReadFile: fun(file: ptr, buffer: ptr, count: u32, read: ptr[u32], overlapped: ptr) -> i32
	WriteFile: fun(file: ptr, buffer: ptr, count: u32, written: ptr[u32], overlapped: ptr) -> i32
	GetFileSizeEx: fun(file: ptr, size: ptr[i64]) -> i32
	SetFilePointerEx: fun(file: ptr, distance: i64, position: ptr[i64], method: MoveMethod) -> i32
	GetFileInformationByHandle: fun(file: ptr, information: ptr[FileInformation]) -> i32
	GetFileInformationByHandleEx: fun(file: ptr, kind: u32, information: ptr, size: u32) -> i32
	FlushFileBuffers: fun(file: ptr) -> i32
	GetFileAttributesW: fun(path: ptr[u16]) -> u32
	SetFileAttributesW: fun(path: ptr[u16], attributes: u32) -> i32
	SetFileInformationByHandle: fun(file: ptr, kind: u32, information: ptr, size: u32) -> i32
	CopyFileW: fun(from: ptr[u16], to: ptr[u16], failIfExists: i32) -> i32
	MoveFileExW: fun(from: ptr[u16], to: ptr[u16], flags: MoveFlags) -> i32
	CreateDirectoryW: fun(path: ptr[u16], security: ptr) -> i32
	CloseHandle: fun(handle: ptr) -> i32
	GetLastError: fun -> u32
	GetFinalPathNameByHandleW: fun(file: ptr, path: ptr[u16], length: u32, flags: u32) -> u32
	DeviceIoControl: fun(device: ptr, code: u32, input: ptr, inputSize: u32, output: ptr, outputSize: u32,
		returned: ptr[u32], overlapped: ptr) -> i32
	
	CreateSymbolicLinkW: fun(link: ptr[u16], target: ptr[u16], flags: u32) -> u8
	CreateHardLinkW: fun(link: ptr[u16], existing: ptr[u16], security: ptr) -> i32
	GetTempPath2W: fun(length: u32, buffer: ptr[u16]) -> u32
	GetEnvironmentVariableW: fun(name: ptr[u16], buffer: ptr[u16], size: u32) -> u32
}

pvt ext("userenv")
{
	GetUserProfileDirectoryW: fun(token: ptr, directory: ptr[u16], size: ptr[u32]) -> i32
}

pvt ext("ntdll")
{
	NtOpenFile: fun(handle: ptr[ptr], access: Access, attributes: ptr[ObjectAttributes], status: ptr[IoStatus],
		share: Share, options: u32) -> i32
	
	RtlNtStatusToDosError: fun(status: i32) -> u32
}

Access: pvt ext enum(u32) impl BitSet
{
	listDirectory = 0x00000001
	appendData = 0x00000004
	writeExtendedAttributes = 0x00000010
	readAttributes = 0x00000080
	writeAttributes = 0x00000100
	delete = 0x00010000
	readControl = 0x00020000
	synchronize = 0x00100000
	genericAll = 0x10000000
	genericExecute = 0x20000000
	genericWrite = 0x40000000
	genericRead = 0x80000000
}

Share: pvt ext enum(u32) impl BitSet
{
	none = 0x00000000
	read = 0x00000001
	write = 0x00000002
	delete = 0x00000004
}

Disposition: pvt ext enum(u32)
{
	createNew = 1
	createAlways = 2
	openExisting = 3
	openAlways = 4
	truncateExisting = 5
}

MoveFlags: pvt ext enum(u32) impl BitSet
{
	replaceExisting = 0x1
	copyAllowed = 0x2
}

MoveMethod: pvt ext enum(u32)
{
	begin = 0
	current = 1
	end = 2
}

Flags: pvt ext enum(u32) impl BitSet
{
	// Attributes
	readonly = 0x0001
	hidden = 0x0002
	system = 0x0004
	archive = 0x0020
	normal = 0x0080
	temporary = 0x0100
	offline = 0x1000
	encrypted = 0x4000
	
	// Flags
	openNoRecall = 0x00100000
	openReparsePoint = 0x00200000
	sessionAware = 0x00800000
	posixSemantics = 0x01000000
	backupSemantics = 0x02000000
	deleteOnClose = 0x04000000
	sequentialScan = 0x08000000
	randomAccess = 0x10000000
	noBuffering = 0x20000000
	overlapped = 0x40000000
	writeThrough = 0x80000000
}

FileInformation: pvt rec
{
	attributes: u32
	created: array[u32, 2]
	accessed: array[u32, 2]
	written: array[u32, 2]
	volumeSerial: u32
	sizeHigh: u32
	sizeLow: u32
	links: u32
	indexHigh: u32
	indexLow: u32
}

AttributeTag: pvt rec
{
	attributes: u32
	tag: u32
}

invalidFunction: pvt const u32 = 1
fileNotFound: pvt const u32 = 2
pathNotFound: pvt const u32 = 3
writeProtect: pvt const u32 = 19
accessDenied: pvt const u32 = 5
notSameDevice: pvt const u32 = 17
handleDiskFull: pvt const u32 = 39
notSupported: pvt const u32 = 50
fileExists: pvt const u32 = 80
diskFull: pvt const u32 = 112
alreadyExistsError: pvt const u32 = 183
handleEndOfFile: pvt const u32 = 38
invalidParameter: pvt const u32 = 87
brokenPipe: pvt const u32 = 109
insufficientBuffer: pvt const u32 = 122
invalidName: pvt const u32 = 123
negativeSeek: pvt const u32 = 131
directoryNotEmptyError: pvt const u32 = 145
badPathName: pvt const u32 = 161
fileNameTooLong: pvt const u32 = 206
privilegeNotHeld: pvt const u32 = 1314
cantResolveFilename: pvt const u32 = 1921
notAReparsePoint: pvt const u32 = 4390
invalidAttributes: pvt const u32 = 0xFFFFFFFF
readOnlyAttribute: pvt const u32 = 0x1
hiddenAttribute: pvt const u32 = 0x2
systemAttribute: pvt const u32 = 0x4
archiveAttribute: pvt const u32 = 0x20
temporaryAttribute: pvt const u32 = 0x100
sparseAttribute: pvt const u32 = 0x200
compressedAttribute: pvt const u32 = 0x800
offlineAttribute: pvt const u32 = 0x1000
notContentIndexedAttribute: pvt const u32 = 0x2000
encryptedAttribute: pvt const u32 = 0x4000
directoryAttribute: pvt const u32 = 0x10
reparsePointAttribute: pvt const u32 = 0x400
nameSurrogateTag: pvt const u32 = 0x20000000
settableAttributes: pvt const u32 = 0x3127
normalAttribute: pvt const u32 = 0x80
attributeTagInfo: pvt const u32 = 9
dispositionInfo: pvt const u32 = 4
dispositionInfoEx: pvt const u32 = 21
deleteDisposition: pvt const u32 = 0x1
posixSemantics: pvt const u32 = 0x2
ignoreReadOnly: pvt const u32 = 0x10
largestTransfer: pvt const usize = 0xFFFFFFFF
stackPathLength: pvt const usize = 512
shortPathLimit: pvt const usize = 260
volumeNameDos: pvt const u32 = 0x0
volumeNameGuid: pvt const u32 = 0x1
listingBufferSize: pvt const usize = 16384
reparseBufferSize: pvt const usize = 16384
getReparsePoint: pvt const u32 = 0x900A8
setReparsePoint: pvt const u32 = 0x900A4
mountPointTag: pvt const u32 = 0xA0000003
symlinkTag: pvt const u32 = 0xA000000C
directoryLink: pvt const u32 = 0x1
allowUnprivilegedLink: pvt const u32 = 0x2
relativeLink: pvt const u32 = 0x1
basicInfo: pvt const u32 = 0
endOfFileInfo: pvt const u32 = 6
fullDirectoryInfo: pvt const u32 = 14
noMoreFiles: pvt const u32 = 18
directoryOption: pvt const u32 = 0x1
synchronousOption: pvt const u32 = 0x20
backupIntentOption: pvt const u32 = 0x4000
reparsePointOption: pvt const u32 = 0x200000
attributesOffset: pvt const usize = 56
nameLengthOffset: pvt const usize = 60
tagOffset: pvt const usize = 64
nameOffset: pvt const usize = 68
separator: mod const u8 = 0x5C

errorFrom: pvt fun(code: u32) -> IoError => match code
{
	fileNotFound, pathNotFound => IoError(notFound, code)
	accessDenied, writeProtect, privilegeNotHeld => IoError(permissionDenied, code)
	fileExists, alreadyExistsError => IoError(alreadyExists, code)
	diskFull, handleDiskFull => IoError(storageFull, code)
	notSameDevice => IoError(crossesDevices, code)
	directoryNotEmptyError => IoError(directoryNotEmpty, code)
	cantResolveFilename => IoError(linkLoop, code)
	invalidName, badPathName, fileNameTooLong, invalidParameter, negativeSeek, notAReparsePoint => IoError(invalidInput, code)
	else => IoError(other, code)
}

desiredAccess: pvt fun(mode: FileMode, access: FileAccess) -> Access
{
	val appending = Access.appendData | Access.writeAttributes | Access.writeExtendedAttributes | Access.readControl |
		Access.synchronize | Access.readAttributes
	
	if access is read
		ret Access.genericRead
	
	var result = Access.genericWrite
	if mode is append
		result = appending
	
	if access is readWrite
		result |= Access.genericRead
	
	ret result
}

dispositionOf: pvt fun(mode: FileMode) -> Disposition => match mode
{
	open => Disposition.openExisting
	openOrCreate, append => Disposition.openAlways
	create => Disposition.createAlways
	createNew => Disposition.createNew
	truncate => Disposition.truncateExisting
}

checkPath: pvt fun(path: Path) -> Result[IoError]
{
	if wideLength(path.bytes) is none
		ret err(IoError(invalidInput, invalidName))
	
	ret ok
}

withWidePath[R: noref]: pvt fun(path: Path, imm action: fun[ptr[u16] -> R]) -> R
{
	val length = wideLength(path.bytes).valueOr(0)
	if length < stackPathLength
	{
		var buffer: array[u16, stackPathLength]
		bytesToWide(path.bytes, @buffer)
		ret action(@buffer)
	}
	
	var heap = Heap()
	val layout = Layout.arrayOf[u16](length + 1)
	val wide = ptr[u16](heap.allocate(layout))
	if wide == null
		panic "out of memory"
	
	bytesToWide(path.bytes, wide)
	val result = action(wide)
	heap.release(wide, layout)
	ret result
}

Decoded: pvt rec
{
	code: u32
	length: usize
}

decodeAt: pvt fun(bytes: View[u8], index: usize) -> Decoded
{
	val first = bytes[index]
	if first == 0
		ret Decoded(0, 0)
	
	if first <= 0x7F
		ret Decoded(u32(first), 1)
	
	var length: usize = 0
	var code: u32 = 0
	var lowest: u8 = 0x80
	var highest: u8 = 0xBF
	match first
	{
		0xC2..=0xDF =>
		{
			length = 2
			code = u32(first & 0x1F)
		}
		0xE0 =>
		{
			length = 3
			lowest = 0xA0
		}
		0xE1..=0xEF =>
		{
			length = 3
			code = u32(first & 0x0F)
		}
		0xF0 =>
		{
			length = 4
			lowest = 0x90
		}
		0xF1..=0xF3 =>
		{
			length = 4
			code = u32(first & 0x07)
		}
		0xF4 =>
		{
			length = 4
			code = 0x4
			highest = 0x8F
		}
		else => ret Decoded(0, 0)
	}
	
	if index + length > bytes.length
		ret Decoded(0, 0)
	
	for i in 1..length
	{
		val next = bytes[index + i]
		if !(lowest <= next <= highest)
			ret Decoded(0, 0)
		
		code = (code << 6) | u32(next & 0x3F)
		lowest = 0x80
		highest = 0xBF
	}
	
	ret Decoded(code, length)
}

wideLength: pvt fun(bytes: View[u8]) -> Option[usize]
{
	var length: usize = 0
	var index: usize = 0
	while index < bytes.length
	{
		val decoded = decodeAt(bytes, index)
		if decoded.length == 0
			ret none
		
		index += decoded.length
		length += 1
		if decoded.code >= 0x10000
			length += 1
	}
	
	ret length
}

bytesToWide: pvt fun(bytes: View[u8], wide: ptr[u16])
{
	var index: usize = 0
	var written: usize = 0
	while index < bytes.length
	{
		val decoded = decodeAt(bytes, index)
		if decoded.length == 0
			break
		
		index += decoded.length
		if decoded.code >= 0x10000
		{
			val value = decoded.code - 0x10000
			wide[written] = u16(0xD800 | (value >> 10))
			wide[written + 1] = u16(0xDC00 | (value & 0x3FF))
			written += 2
		}
		else
		{
			wide[written] = u16(decoded.code)
			written += 1
		}
	}
	
	wide[written] = 0
}

wideToBytes: pvt fun(units: View[u16], bytes: ptr[u8]) -> usize
{
	var written: usize = 0
	var index: usize = 0
	while index < units.length
	{
		var code = u32(units[index])
		index += 1
		if 0xD800 <= code <= 0xDBFF && index < units.length && 0xDC00 <= units[index] <= 0xDFFF
		{
			code = 0x10000 + ((code - 0xD800) << 10) + (u32(units[index]) - 0xDC00)
			index += 1
		}
		
		match code
		{
			<= 0x7F =>
			{
				bytes[written] = u8(code)
				written += 1
			}
			<= 0x7FF =>
			{
				bytes[written] = u8(0xC0 | (code >> 6))
				bytes[written + 1] = u8(0x80 | (code & 0x3F))
				written += 2
			}
			<= 0xFFFF =>
			{
				bytes[written] = u8(0xE0 | (code >> 12))
				bytes[written + 1] = u8(0x80 | ((code >> 6) & 0x3F))
				bytes[written + 2] = u8(0x80 | (code & 0x3F))
				written += 3
			}
			else =>
			{
				bytes[written] = u8(0xF0 | (code >> 18))
				bytes[written + 1] = u8(0x80 | ((code >> 12) & 0x3F))
				bytes[written + 2] = u8(0x80 | ((code >> 6) & 0x3F))
				bytes[written + 3] = u8(0x80 | (code & 0x3F))
				written += 4
			}
		}
	}
	
	ret written
}

canonicalPath[A: Allocator + noref]: mod fun(path: Path, alloc: A) -> Result[PathBuffer[A], IoError]
{
	checkPath(path)?
	val handle = withWidePath(path, fun(wide) => CreateFileW(wide, Access.readAttributes,
		Share.read | Share.write | Share.delete, null, Disposition.openExisting, Flags.backupSemantics, null))
	
	if handle == ptr(usize.maxValue)
		ret err(errorFrom(GetLastError()))
	
	var heap = Heap()
	var buffer: array[u16, stackPathLength]
	var units = ptr[u16](@buffer)
	var onHeap = false
	var capacity = stackPathLength
	var flags = volumeNameDos
	var length = GetFinalPathNameByHandleW(handle, units, u32(capacity), flags)
	if length == 0 && GetLastError() == pathNotFound
	{
		flags = volumeNameGuid
		length = GetFinalPathNameByHandleW(handle, units, u32(capacity), flags)
	}
	
	while usize(length) >= capacity
	{
		if onHeap
			heap.release(units, Layout.arrayOf[u16](capacity))
		
		capacity = usize(length)
		units = ptr[u16](heap.allocate(Layout.arrayOf[u16](capacity)))
		if units == null
			panic "out of memory"
		
		onHeap = true
		length = GetFinalPathNameByHandleW(handle, units, u32(capacity), flags)
	}
	
	val code = GetLastError()
	CloseHandle(handle)
	if length == 0
	{
		if onHeap
			heap.release(units, Layout.arrayOf[u16](capacity))
		
		ret err(errorFrom(code))
	}
	
	val result = pathFromWide(shortened(Span[u16](units, usize(length))), alloc)
	if onHeap
		heap.release(units, Layout.arrayOf[u16](capacity))
	
	ret ok(result)
}

tempDirectoryPath: mod fun -> Result[PathBuffer, IoError] =>
	queryWide(fun(units, capacity) => GetTempPath2W(capacity, units))

homeDirectoryPath: mod fun -> Result[PathBuffer, IoError]
{
	// TODO: read USERPROFILE through std.process once it has environment variables
	val variable: Path = "USERPROFILE"
	val profile = withWidePath(variable, fun(name) =>
		queryWide(fun(units, capacity) => GetEnvironmentVariableW(name, units, capacity)))
	
	if profile is ok(_)
		ret profile
	
	ret queryWide(fun(units, capacity)
	{
		var size = capacity
		if GetUserProfileDirectoryW(ptr(usize.maxValue - 3), units, @size) != 0
			ret size - 1
		
		if GetLastError() == insufficientBuffer
			ret size
		
		ret 0
	})
}

queryWide: pvt fun(imm query: fun[ptr[u16], u32 -> u32]) -> Result[PathBuffer, IoError]
{
	var heap = Heap()
	var buffer: array[u16, stackPathLength]
	var units = ptr[u16](@buffer)
	var onHeap = false
	var capacity = stackPathLength
	var length = query(units, u32(capacity))
	while usize(length) >= capacity
	{
		if onHeap
			heap.release(units, Layout.arrayOf[u16](capacity))
		
		capacity = usize(length) + 1
		units = ptr[u16](heap.allocate(Layout.arrayOf[u16](capacity)))
		if units == null
			panic "out of memory"
		
		onHeap = true
		length = query(units, u32(capacity))
	}
	
	val code = GetLastError()
	if length == 0
	{
		if onHeap
			heap.release(units, Layout.arrayOf[u16](capacity))
		
		ret err(errorFrom(code))
	}
	
	val path = pathFromWide(View[u16](units, usize(length)), Heap())
	if onHeap
		heap.release(units, Layout.arrayOf[u16](capacity))
	
	ret ok(path)
}

pathFromWide[A: Allocator + noref]: pvt fun(units: View[u16], alloc: A) -> PathBuffer[A]
{
	var heap = Heap()
	val layout = Layout.arrayOf[u8](units.length * 3)
	val bytes = ptr[u8](heap.allocate(layout))
	if bytes == null
		panic "out of memory"
	
	val length = wideToBytes(units, bytes)
	val result = PathBuffer[A](Path(View[u8](bytes, length)), alloc)
	heap.release(bytes, layout)
	ret result
}

shortened: pvt fun(units: Span[u16]) -> Span[u16]
{
	var start: usize = 0
	var names: usize = 0
	if units.length >= 7 && matchesName(units.slice(0, 4), "\\\\?\\") && isWideLetter(units[4]) && units[5] == 0x3A &&
		units[6] == 0x5C
	{
		start = 4
		names = 7
	}
	else if units.length >= 8 && matchesName(units.slice(0, 8), "\\\\?\\UNC\\")
	{
		start = 6
		names = 8
	}
	else
		ret units
	
	if units.length - start >= shortPathLimit || !plainNames(units.slice(names, units.length))
		ret units
	
	if start == 6
		units[start] = 0x5C
	
	ret units.slice(start, units.length)
}

plainNames: pvt fun(units: View[u16]) -> bool
{
	var start: usize = 0
	while start < units.length
	{
		var end = start
		while end < units.length && units[end] != 0x5C
			end += 1
		
		if !plainName(units.slice(start, end))
			ret false
		
		start = end + 1
	}
	
	ret true
}

plainName: pvt fun(name: View[u16]) -> bool
{
	if name.isEmpty
		ret false
	
	val last = name[name.length - 1]
	if last == 0x2E || last == 0x20
		ret false
	
	for unit in name
	{
		if forbiddenUnit(unit)
			ret false
	}
	
	ret !deviceName(name)
}

forbiddenUnit: pvt fun(unit: u16) -> bool => match unit
{
	< 0x20 => true
	0x22, 0x2A, 0x2F, 0x3A, 0x3C, 0x3E, 0x3F, 0x7C => true
	else => false
}

deviceName: pvt fun(name: View[u16]) -> bool
{
	var length: usize = 0
	while length < name.length && name[length] != 0x2E
		length += 1
	
	while length > 0 && name[length - 1] == 0x20
		length -= 1
	
	val stem = name.slice(0, length)
	if length == 3
		ret matchesName(stem, "CON") || matchesName(stem, "PRN") || matchesName(stem, "AUX") || matchesName(stem, "NUL")
	
	if length == 4 && (matchesName(stem.slice(0, 3), "COM") || matchesName(stem.slice(0, 3), "LPT"))
		ret deviceDigit(stem[3])
	
	ret matchesName(stem, "CONIN$") || matchesName(stem, "CONOUT$")
}

deviceDigit: pvt fun(unit: u16) -> bool => match unit
{
	0x30..=0x39 => true
	0xB9, 0xB2, 0xB3 => true
	else => false
}

matchesName: pvt fun(name: View[u16], upper: str) -> bool
{
	if name.length != upper.byteLength
		ret false
	
	for i in 0..name.length
	{
		var unit = name[i]
		if 0x61 <= unit <= 0x7A
			unit -= 0x20
		
		if unit != u16(upper[i])
			ret false
	}
	
	ret true
}

isWideLetter: pvt fun(unit: u16) -> bool => 0x41 <= unit <= 0x5A || 0x61 <= unit <= 0x7A

pathMetadata: mod fun(path: Path, followLinks: bool) -> Result[Metadata, IoError]
{
	checkPath(path)?
	ret withWidePath(path, fun(wide) => metadataOfPath(wide, followLinks))
}

metadataOfPath: pvt fun(wide: ptr[u16], followLinks: bool) -> Result[Metadata, IoError]
{
	var flags = Flags.backupSemantics
	if !followLinks
		flags |= Flags.openReparsePoint
	
	val handle = CreateFileW(wide, Access.readAttributes, Share.read | Share.write | Share.delete, null,
		Disposition.openExisting, flags, null)
	
	if handle == ptr(usize.maxValue)
		ret err(errorFrom(GetLastError()))
	
	val result = metadataOfHandle(handle, followLinks)
	CloseHandle(handle)
	ret result
}

metadataOfHandle: pvt fun(handle: ptr, followLinks: bool) -> Result[Metadata, IoError]
{
	var information: FileInformation
	if GetFileInformationByHandle(handle, @information) == 0
		ret err(errorFrom(GetLastError()))
	
	var kind = EntryKind.file
	if (information.attributes & directoryAttribute) != 0
		kind = EntryKind.directory
	
	if !followLinks && (information.attributes & reparsePointAttribute) != 0
	{
		var tag: AttributeTag
		if GetFileInformationByHandleEx(handle, attributeTagInfo, @tag, u32(sizeOf(AttributeTag))) == 0
			ret err(errorFrom(GetLastError()))
		
		if (tag.tag & nameSurrogateTag) != 0
			kind = EntryKind.symbolicLink
	}
	
	var size: u64 = 0
	if kind is file
		size = u64(information.sizeHigh) << 32 | u64(information.sizeLow)
	
	ret ok(Metadata(kind, size, Attributes(information.attributes), u64(information.volumeSerial),
		u64(information.indexHigh) << 32 | u64(information.indexLow)))
}

removePath: mod fun(path: Path) -> Result[IoError]
{
	checkPath(path)?
	ret withWidePath(path, fun(wide) => removeWide(wide, false))
}

removeWide: pvt fun(wide: ptr[u16], directory: bool) -> Result[IoError]
{
	val handle = CreateFileW(wide, Access.delete | Access.readAttributes | Access.writeAttributes,
		Share.read | Share.write | Share.delete, null, Disposition.openExisting,
		Flags.backupSemantics | Flags.openReparsePoint, null)
	
	if handle == ptr(usize.maxValue)
		ret err(errorFrom(GetLastError()))
	
	val result = removeHandle(handle, directory)
	CloseHandle(handle)
	ret result
}

removeHandle: pvt fun(handle: ptr, directory: bool) -> Result[IoError]
{
	var information: FileInformation
	if GetFileInformationByHandle(handle, @information) == 0
		ret err(errorFrom(GetLastError()))
	
	val attributes = information.attributes
	val folder = (attributes & directoryAttribute) != 0 && (attributes & reparsePointAttribute) == 0
	if folder && !directory
		ret err(IoError(isDirectory, 0))
	
	if !folder && directory
		ret err(IoError(notADirectory, 0))
	
	ret deleteHandle(handle, attributes)
}

deleteHandle: pvt fun(handle: ptr, attributes: u32) -> Result[IoError]
{
	var flags = deleteDisposition | posixSemantics | ignoreReadOnly
	if SetFileInformationByHandle(handle, dispositionInfoEx, @flags, 4) != 0
		ret ok
	
	val code = GetLastError()
	if code != invalidParameter && code != notSupported && code != invalidFunction
		ret err(errorFrom(code))
	
	val readOnly = (attributes & readOnlyAttribute) != 0
	if readOnly && !setHandleAttributes(handle, attributesWithout(attributes, readOnlyAttribute))
		ret err(errorFrom(GetLastError()))
	
	var deleting: u8 = 1
	if SetFileInformationByHandle(handle, dispositionInfo, @deleting, 1) == 0
	{
		val failure = GetLastError()
		if readOnly
			setHandleAttributes(handle, attributesWithout(attributes, 0))
		
		ret err(errorFrom(failure))
	}
	
	ret ok
}

setHandleAttributes: pvt fun(handle: ptr, attributes: u32) -> bool
{
	var basic = BasicInformation(0, 0, 0, 0, attributes)
	ret SetFileInformationByHandle(handle, basicInfo, @basic, u32(sizeOf(BasicInformation))) != 0
}

createPath: mod fun(path: Path) -> Result[IoError]
{
	checkPath(path)?
	ret withWidePath(path, fun(wide) => createWide(wide))
}

createWide: pvt fun(wide: ptr[u16]) -> Result[IoError]
{
	if CreateDirectoryW(wide, null) == 0
		ret err(errorFrom(GetLastError()))
	
	ret ok
}

removeDirectoryPath: mod fun(path: Path) -> Result[IoError]
{
	checkPath(path)?
	ret withWidePath(path, fun(wide) => removeWide(wide, true))
}

attributesWithout: pvt fun(attributes: u32, removed: u32) -> u32
{
	val result = attributes & settableAttributes & ~removed
	if result == 0
		ret normalAttribute
	
	ret result
}

copyPath: mod fun(from: Path, to: Path, replace: bool) -> Result[IoError]
{
	checkPath(from)?
	checkPath(to)?
	ret withWidePath(from, fun(source) => withWidePath(to, fun(target) => copyWide(source, target, replace)))
}

copyWide: pvt fun(source: ptr[u16], target: ptr[u16], replace: bool) -> Result[IoError]
{
	var failIfExists = 1
	if replace
	{
		if sameFile(source, target)
			ret err(IoError(invalidInput, 0))
		
		failIfExists = 0
	}
	
	if CopyFileW(source, target, failIfExists) == 0
		ret err(errorFrom(GetLastError()))
	
	ret ok
}

sameFile: pvt fun(first: ptr[u16], second: ptr[u16]) -> bool
{
	var a: FileInformation
	var b: FileInformation
	ret identify(first, @a) && identify(second, @b) && a.volumeSerial == b.volumeSerial && a.indexHigh == b.indexHigh &&
		a.indexLow == b.indexLow
}

identify: pvt fun(wide: ptr[u16], information: ptr[FileInformation]) -> bool
{
	val handle = CreateFileW(wide, Access.readAttributes, Share.read | Share.write | Share.delete, null,
		Disposition.openExisting, Flags.backupSemantics, null)
	
	if handle == ptr(usize.maxValue)
		ret false
	
	val found = GetFileInformationByHandle(handle, information) != 0
	CloseHandle(handle)
	ret found
}

movePath: mod fun(from: Path, to: Path, replace: bool) -> Result[IoError]
{
	checkPath(from)?
	checkPath(to)?
	ret withWidePath(from, fun(source) => withWidePath(to, fun(target) => moveWide(source, target, replace)))
}

moveWide: pvt fun(source: ptr[u16], target: ptr[u16], replace: bool) -> Result[IoError]
{
	var flags = MoveFlags.copyAllowed
	if replace
		flags |= MoveFlags.replaceExisting
	
	if MoveFileExW(source, target, flags) != 0
		ret ok
	
	val code = GetLastError()
	val attributes = GetFileAttributesW(target)
	if !replace || code != accessDenied || attributes == invalidAttributes || (attributes & readOnlyAttribute) == 0 ||
		(attributes & directoryAttribute) != 0
		ret err(errorFrom(code))
	
	if SetFileAttributesW(target, attributesWithout(attributes, readOnlyAttribute)) == 0
		ret err(errorFrom(code))
	
	if MoveFileExW(source, target, flags) != 0
		ret ok
	
	val failure = GetLastError()
	SetFileAttributesW(target, attributesWithout(attributes, 0))
	ret err(errorFrom(failure))
}

Attributes: pub rec
{
	bits: pvt u32
	
	new: mod op(bits: u32)
	{
		self.bits = bits
	}
	
	readOnly: prop bool
	{
		get(self) => self.has(readOnlyAttribute)
		set(mut self, value) => self.change(readOnlyAttribute, value)
	}
	
	hidden: prop bool
	{
		get(self) => self.has(hiddenAttribute)
		set(mut self, value) => self.change(hiddenAttribute, value)
	}
	
	system: prop bool
	{
		get(self) => self.has(systemAttribute)
		set(mut self, value) => self.change(systemAttribute, value)
	}
	
	archive: prop bool
	{
		get(self) => self.has(archiveAttribute)
		set(mut self, value) => self.change(archiveAttribute, value)
	}
	
	temporary: prop bool
	{
		get(self) => self.has(temporaryAttribute)
		set(mut self, value) => self.change(temporaryAttribute, value)
	}
	
	offline: prop bool
	{
		get(self) => self.has(offlineAttribute)
		set(mut self, value) => self.change(offlineAttribute, value)
	}
	
	notContentIndexed: prop bool
	{
		get(self) => self.has(notContentIndexedAttribute)
		set(mut self, value) => self.change(notContentIndexedAttribute, value)
	}
	
	compressed: get(self) -> bool => self.has(compressedAttribute)
	encrypted: get(self) -> bool => self.has(encryptedAttribute)
	sparse: get(self) -> bool => self.has(sparseAttribute)
	
	has: pvt fun(self, flag: u32) -> bool => (self.bits & flag) != 0
	
	change: pvt fun(mut self, flag: u32, value: bool)
	{
		if value
			self.bits |= flag
		else
			self.bits &= ~flag
	}
	
	settable: mod get(self) -> u32 => attributesWithout(self.bits, 0)
}

setPathAttributes: mod fun(path: Path, attributes: Attributes) -> Result[IoError]
{
	checkPath(path)?
	val bits = attributes.settable
	ret withWidePath(path, fun(wide) => setWideAttributes(wide, bits))
}

setWideAttributes: pvt fun(wide: ptr[u16], bits: u32) -> Result[IoError]
{
	if SetFileAttributesW(wide, bits) == 0
		ret err(errorFrom(GetLastError()))
	
	ret ok
}

UnicodeName: pvt rec
{
	length: u16
	capacity: u16
	buffer: ptr[u16]
}

ObjectAttributes: pvt rec
{
	length: u32
	root: ptr
	name: ptr[UnicodeName]
	attributes: u32
	security: ptr
	quality: ptr
}

IoStatus: pvt rec
{
	status: ptr
	information: usize
}

BasicInformation: pvt rec
{
	created: i64
	accessed: i64
	written: i64
	changed: i64
	attributes: u32
}

listingOf: pvt fun(handle: ptr, followLinks: bool) -> Result[NativeListing, IoError]
{
	var information: FileInformation
	if GetFileInformationByHandle(handle, @information) == 0
	{
		val code = GetLastError()
		CloseHandle(handle)
		ret err(errorFrom(code))
	}
	
	val attributes = information.attributes
	val linked = !followLinks && (attributes & reparsePointAttribute) != 0
	if (attributes & directoryAttribute) == 0 || linked
	{
		CloseHandle(handle)
		ret err(IoError(notADirectory, 0))
	}
	
	var heap = Heap()
	val buffer = ptr[u8](heap.allocate(Layout.arrayOf[u64](listingBufferSize / 8)))
	if buffer == null
		panic "out of memory"
	
	ret ok(NativeListing(handle, buffer))
}

openListing: pvt fun(wide: ptr[u16], followLinks: bool) -> Result[NativeListing, IoError]
{
	var flags = Flags.backupSemantics
	if !followLinks
		flags |= Flags.openReparsePoint
	
	val handle = CreateFileW(wide, Access.listDirectory | Access.readAttributes | Access.synchronize,
		Share.read | Share.write | Share.delete, null, Disposition.openExisting, flags, null)
	
	if handle == ptr(usize.maxValue)
		ret err(errorFrom(GetLastError()))
	
	ret listingOf(handle, followLinks)
}

NativeListing: mod rec
{
	handle: ptr
	buffer: ptr[u8]
	offset: u32
	filled: bool
	currentKind: EntryKind
	nameLength: usize
	nameBytes: array[u8, 1024]
	
	new: op(handle: ptr, buffer: ptr[u8])
	{
		self.handle = handle
		self.buffer = buffer
		self.offset = 0
		self.filled = false
		self.currentKind = EntryKind.other
		self.nameLength = 0
	}
	
	open: fun(path: Path, followLinks: bool) -> Result[NativeListing, IoError]
	{
		checkPath(path)?
		ret withWidePath(path, fun(wide) => openListing(wide, followLinks))
	}
	
	openChild: fun(imm self) -> Result[NativeListing, IoError]
	{
		val handle = self.openRelative(Access.listDirectory | Access.readAttributes | Access.synchronize,
			directoryOption | synchronousOption | backupIntentOption | reparsePointOption)?
		
		ret listingOf(handle, false)
	}
	
	next: fun(mut self) -> Result[bool, IoError]
	{
		loop
		{
			if self.filled
			{
				val step = *ptr[u32](self.entry())
				if step == 0
					self.filled = false
				else
					self.offset += step
			}
			
			if !self.filled
			{
				if GetFileInformationByHandleEx(self.handle, fullDirectoryInfo, self.buffer, u32(listingBufferSize)) == 0
				{
					val code = GetLastError()
					if code == noMoreFiles
						ret ok(false)
					
					ret err(errorFrom(code))
				}
				
				self.filled = true
				self.offset = 0
			}
			
			val entry = self.entry()
			val length = usize(*ptr[u32](entry + nameLengthOffset)) / 2
			val name = ptr[u16](entry + nameOffset)
			if name[0] == 0x2E && (length == 1 || length == 2 && name[1] == 0x2E)
				cont
			
			val attributes = *ptr[u32](entry + attributesOffset)
			self.currentKind = EntryKind.file
			if (attributes & directoryAttribute) != 0
				self.currentKind = EntryKind.directory
			
			if (attributes & reparsePointAttribute) != 0 && (*ptr[u32](entry + tagOffset) & nameSurrogateTag) != 0
				self.currentKind = EntryKind.symbolicLink
			
			self.nameLength = wideToBytes(View[u16](name, length), @self.nameBytes)
			ret ok(true)
		}
	}
	
	entry: pvt fun(imm self) -> ptr[u8] => self.buffer + usize(self.offset)
	name: get(imm self) -> Path => Path(View[u8](@self.nameBytes, self.nameLength))
	kind: get(imm self) -> EntryKind => self.currentKind
	
	openRelative: pvt fun(imm self, access: Access, options: u32) -> Result[ptr, IoError]
	{
		val entry = self.entry()
		val bytes = u16(*ptr[u32](entry + nameLengthOffset))
		var name = UnicodeName(bytes, bytes, ptr[u16](entry + nameOffset))
		var attributes = ObjectAttributes(u32(sizeOf(ObjectAttributes)), self.handle, @name, 0, null, null)
		var status: IoStatus
		var handle: ptr = null
		val result = NtOpenFile(@handle, access, @attributes, @status, Share.read | Share.write | Share.delete, options)
		if result != 0
			ret err(errorFrom(RtlNtStatusToDosError(result)))
		
		ret ok(handle)
	}
	
	removeCurrent: fun(imm self) -> Result[IoError]
	{
		val handle = self.openRelative(Access.delete | Access.readAttributes | Access.writeAttributes | Access.synchronize,
			synchronousOption | backupIntentOption | reparsePointOption)?
		
		var information: FileInformation
		var result: Result[IoError] = ok
		if GetFileInformationByHandle(handle, @information) == 0
			result = err(errorFrom(GetLastError()))
		else
			result = deleteHandle(handle, information.attributes)
		
		CloseHandle(handle)
		ret result
	}
	
	close: fun(self)
	{
		CloseHandle(self.handle)
		var heap = Heap()
		heap.release(self.buffer, Layout.arrayOf[u64](listingBufferSize / 8))
	}
}

copyLink: mod fun(from: Path, to: Path) -> Result[IoError]
{
	checkPath(from)?
	checkPath(to)?
	ret withWidePath(from, fun(source) => withWidePath(to, fun(target) => copyLinkWide(source, target)))
}

copyLinkWide: pvt fun(source: ptr[u16], target: ptr[u16]) -> Result[IoError]
{
	val handle = CreateFileW(source, Access.readAttributes, Share.read | Share.write | Share.delete, null,
		Disposition.openExisting, Flags.backupSemantics | Flags.openReparsePoint, null)
	
	if handle == ptr(usize.maxValue)
		ret err(errorFrom(GetLastError()))
	
	var information: FileInformation
	var data: array[u64, reparseBufferSize / 8]
	var returned: u32 = 0
	var code: u32 = 0
	if GetFileInformationByHandle(handle, @information) == 0 ||
		DeviceIoControl(handle, getReparsePoint, null, 0, @data, u32(reparseBufferSize), @returned, null) == 0
		code = GetLastError()
	
	CloseHandle(handle)
	if code != 0
		ret err(errorFrom(code))
	
	val bytes = ptr[u8](@data)
	val tag = *ptr[u32](bytes)
	if tag == mountPointTag
		ret recreateJunction(target, bytes)
	
	if tag != symlinkTag
		ret err(IoError(invalidInput, 0))
	
	var nameOffset = usize(*ptr[u16](bytes + 12))
	var nameLength = usize(*ptr[u16](bytes + 14)) / 2
	if nameLength == 0
	{
		nameOffset = usize(*ptr[u16](bytes + 8))
		nameLength = usize(*ptr[u16](bytes + 10)) / 2
	}
	
	var name: array[u16, reparseBufferSize / 2]
	val units = ptr[u16](bytes + 20 + nameOffset)
	for i in 0..nameLength
		name[i] = units[i]
	
	name[nameLength] = 0
	var flags = allowUnprivilegedLink
	if (information.attributes & directoryAttribute) != 0
		flags |= directoryLink
	
	if CreateSymbolicLinkW(target, @name, flags) == 0
		ret err(errorFrom(GetLastError()))
	
	ret ok
}

recreateJunction: pvt fun(target: ptr[u16], data: ptr[u8]) -> Result[IoError]
{
	if CreateDirectoryW(target, null) == 0
		ret err(errorFrom(GetLastError()))
	
	val handle = CreateFileW(target, Access.genericWrite, Share.read | Share.write | Share.delete, null,
		Disposition.openExisting, Flags.backupSemantics | Flags.openReparsePoint, null)
	
	var code: u32 = 0
	if handle == ptr(usize.maxValue)
		code = GetLastError()
	else
	{
		var returned: u32 = 0
		val size = u32(*ptr[u16](data + 4)) + 8
		if DeviceIoControl(handle, setReparsePoint, data, size, null, 0, @returned, null) == 0
			code = GetLastError()
		
		CloseHandle(handle)
	}
	
	if code == 0
		ret ok
	
	removeWide(target, true)
	ret err(errorFrom(code))
}

createHardLinkPath: mod fun(target: Path, link: Path) -> Result[IoError]
{
	checkPath(target)?
	checkPath(link)?
	ret withWidePath(target, fun(existing) => withWidePath(link, fun(wide) => createHardLinkWide(existing, wide)))
}

createHardLinkWide: pvt fun(existing: ptr[u16], link: ptr[u16]) -> Result[IoError]
{
	if CreateHardLinkW(link, existing, null) != 0
		ret ok
	
	val code = GetLastError()
	val attributes = GetFileAttributesW(existing)
	if code == accessDenied && attributes != invalidAttributes && (attributes & directoryAttribute) != 0
		ret err(IoError(isDirectory, code))
	
	ret err(errorFrom(code))
}

readLinkPath[A: Allocator + noref]: mod fun(path: Path, alloc: A) -> Result[PathBuffer[A], IoError]
{
	checkPath(path)?
	val handle = withWidePath(path, fun(wide) => CreateFileW(wide, Access.readAttributes,
		Share.read | Share.write | Share.delete, null, Disposition.openExisting,
		Flags.backupSemantics | Flags.openReparsePoint, null))
	
	if handle == ptr(usize.maxValue)
		ret err(errorFrom(GetLastError()))
	
	var data: array[u64, reparseBufferSize / 8]
	var returned: u32 = 0
	var code: u32 = 0
	if DeviceIoControl(handle, getReparsePoint, null, 0, @data, u32(reparseBufferSize), @returned, null) == 0
		code = GetLastError()
	
	CloseHandle(handle)
	if code != 0
		ret err(errorFrom(code))
	
	val bytes = ptr[u8](@data)
	val tag = *ptr[u32](bytes)
	var names = bytes + 16
	var relative = false
	if tag == symlinkTag
	{
		names = bytes + 20
		relative = (*ptr[u32](bytes + 16) & relativeLink) != 0
	}
	else if tag != mountPointTag
		ret err(IoError(invalidInput, 0))
	
	val offset = usize(*ptr[u16](bytes + 8))
	val length = usize(*ptr[u16](bytes + 10)) / 2
	val units = Span[u16](ptr[u16](names + offset), length)
	if !relative && length >= 4 && units[0] == 0x5C && units[1] == 0x3F && units[2] == 0x3F && units[3] == 0x5C
	{
		units[1] = 0x5C
		ret ok(pathFromWide(shortened(units), alloc))
	}
	
	ret ok(pathFromWide(units, alloc))
}

createLinkPath: mod fun(target: Path, link: Path, directory: bool) -> Result[IoError]
{
	checkPath(target)?
	checkPath(link)?
	ret withWidePath(target, fun(destination) => withWidePath(link, fun(wide) => createLinkWide(destination, wide, directory)))
}

createLinkWide: pvt fun(destination: ptr[u16], link: ptr[u16], directory: bool) -> Result[IoError]
{
	var flags = allowUnprivilegedLink
	if directory
		flags |= directoryLink
	
	if CreateSymbolicLinkW(link, destination, flags) == 0
		ret err(errorFrom(GetLastError()))
	
	ret ok
}

NativeFile: mod rec
{
	handle: ptr
	
	open: fun(path: Path, mode: FileMode, access: FileAccess) -> Result[NativeFile, IoError]
	{
		checkPath(path)?
		ret withWidePath(path, fun(wide) => openWide(wide, mode, access))
	}
	
	openWide: pvt fun(wide: ptr[u16], mode: FileMode, access: FileAccess) -> Result[NativeFile, IoError]
	{
		val handle = CreateFileW(wide, desiredAccess(mode, access), Share.read | Share.write | Share.delete, null,
			dispositionOf(mode), Flags.normal, null)
		
		if handle == ptr(usize.maxValue)
		{
			val code = GetLastError()
			val attributes = GetFileAttributesW(wide)
			if code == accessDenied && attributes != invalidAttributes && (attributes & directoryAttribute) != 0
				ret err(IoError(isDirectory, code))
			
			ret err(errorFrom(code))
		}
		
		ret ok(NativeFile(handle))
	}
	
	read: fun(self, buffer: Span[u8]) -> Result[usize, IoError]
	{
		var count = buffer.length
		if count > largestTransfer
			count = largestTransfer
		
		var read: u32 = 0
		if ReadFile(self.handle, buffer.data, u32(count), @read, null) == 0
		{
			val code = GetLastError()
			if code == handleEndOfFile || code == brokenPipe
				ret ok(0)
			
			ret err(errorFrom(code))
		}
		
		ret ok(usize(read))
	}
	
	write: fun(self, data: View[u8]) -> Result[usize, IoError]
	{
		var count = data.length
		if count > largestTransfer
			count = largestTransfer
		
		var written: u32 = 0
		if WriteFile(self.handle, data.data, u32(count), @written, null) == 0
			ret err(errorFrom(GetLastError()))
		
		ret ok(usize(written))
	}
	
	seek: fun(self, target: SeekFrom) -> Result[u64, IoError]
	{
		val distance = match target
		{
			start(val offset) => i64(offset)
			current(val offset) => offset
			end(val offset) => offset
		}
		
		val method = match target
		{
			start(_) => MoveMethod.begin
			current(_) => MoveMethod.current
			end(_) => MoveMethod.end
		}
		
		var position: i64 = 0
		if SetFilePointerEx(self.handle, distance, @position, method) == 0
			ret err(errorFrom(GetLastError()))
		
		ret ok(u64(position))
	}
	
	size: fun(self) -> Result[u64, IoError]
	{
		var size: i64 = 0
		if GetFileSizeEx(self.handle, @size) == 0
			ret err(errorFrom(GetLastError()))
		
		ret ok(u64(size))
	}
	
	metadata: fun(self) -> Result[Metadata, IoError] => metadataOfHandle(self.handle, true)
	
	resize: fun(self, size: u64) -> Result[IoError]
	{
		var end = i64(size)
		if SetFileInformationByHandle(self.handle, endOfFileInfo, @end, u32(sizeOf(i64))) == 0
			ret err(errorFrom(GetLastError()))
		
		ret ok
	}
	
	sync: fun(self) -> Result[IoError]
	{
		if FlushFileBuffers(self.handle) == 0
			ret err(errorFrom(GetLastError()))
		
		ret ok
	}
	
	close: fun(self)
	{
		CloseHandle(self.handle)
	}
}