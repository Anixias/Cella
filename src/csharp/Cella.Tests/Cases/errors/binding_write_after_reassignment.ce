mod test

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Effect: enum
{
	none
	hold(buffer: Buffer)

	clear: fun(mut self)
	{
		match mut self
		{
			hold(b) =>
			{
				self = Effect.none
				b = Buffer(3)
			}
			else => {}
		}
	}
}

main: fun -> i32
{
	var e = Effect.hold(Buffer(1))
	match mut e
	{
		hold(b) =>
		{
			e = Effect.none
			b = Buffer(2)
		}
		else => {}
	}

	if e is hold(mut b)
	{
		e = Effect.none
		b.id = 42
	}

	var arr = [Buffer(4), Buffer(5)]
	for b in mut arr
	{
		arr = [Buffer(6), Buffer(7)]
		b.id = 9
		break
	}

	ret 0
}
