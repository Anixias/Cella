mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Effect: enum
{
	none
	hit(n: i32)
}

Box: rec
{
	e: Effect
	k: i32
}

main: fun -> i32
{
	var e = Effect.hit(1)
	match mut e
	{
		hit(val n) =>
		{
			n = 5
			printf("%d\n", n)
			e = Effect.none
		}
		else => {}
	}

	var b = Box(Effect.hit(2), 3)
	match mut b.e
	{
		hit(val n) =>
		{
			b.k = 4
			printf("%d %d\n", n, b.k)
		}
		else => {}
	}

	ret 0
}
