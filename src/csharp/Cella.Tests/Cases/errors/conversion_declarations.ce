mod test

Text: rec
{
	value: i32

	as: op(self, extra: i32) -> i32 = 1
	as: op(self) -> Text = self
	as: op(mut self) -> i32 = 1
	as: op(self) -> mut[i32] = mut self.value
	as: op(own self) -> imm[i32] = imm self.value
	as: op(a: i32, b: i32) -> Text = Text(a)
	as: op(mut a: i32) -> Text = Text(a)
	as: op(a: i64) -> i32 = 1
	as: op(a: Text) -> Text = a
	as: op(a: u8) -> Text = Text(1)
	as: op(own a: u8) -> Text = Text(2)
	as: op(self) -> u16 = 1
	as: op(self) -> u16 = 2
	as: op(self) -> u32 = 1
	new: op(own self) -> u32 = 1
	as: op(self) {}
	new: op(self, extra: i32) -> i64 = 1
	new: op(self) -> imm[Text] = imm self
}

Numeric: trait
{
	as: op(self) -> i32
}

Mismatched: rec impl Numeric
{
	value: i32

	as: op(self) -> i64 = 1
}

Missing: rec impl Numeric
{
	value: i32
}

main: fun -> i32 = 0
