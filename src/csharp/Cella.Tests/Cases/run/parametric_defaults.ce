mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

base: const usize = 100

measure[T]: fun(imm x: T, extra: usize = sizeOf(T)) -> usize = extra

offset[T]: fun(imm x: T, extra: usize = sizeOf(T) + base) -> usize = extra

count[N: const usize]: fun(extra: usize = N) -> usize = extra

layout[T, N: const usize]: fun(imm x: T, extra: usize = N * sizeOf(T) + alignOf(T)) -> usize = extra

forward[U]: fun(imm u: U) -> usize = offset(imm u)

relay[M: const usize]: fun -> usize = count[M]()

box[T]: rec
{
	value: T

	size: fun(imm self, extra: usize = sizeOf(T)) -> usize = extra
}

main: fun -> i32
{
	printf("%zu %zu %zu %zu\n", measure(1), measure(2.0), count[3](), layout[i16, 4](5))
	printf("%zu %zu %zu %zu\n", forward(1i64), relay[7](), box(1i16).size(), offset(1u8, 3))
	ret 0
}
