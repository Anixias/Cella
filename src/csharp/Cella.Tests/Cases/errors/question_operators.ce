mod test

Result[T, E]: enum
{
	ok(value: T)
	err(error: E)

	?: op(own self) -> T => match own self
	{
		ok(own value) => value
		err(own error) => ret Result.err(own error)
	}
}

Broken[T]: enum
{
	held(value: T)

	?: op(own self) -> T => match own self
	{
		held(own value) => valu
	}
}

parse: fun(n: i32) -> Result[i32, i32] => Result.ok(n)

plain: fun -> i32 => parse(1)?

nothing: fun
{
	val x = parse(1)?
}

stop: fun -> never
{
	val x = parse(1)?
	while true
	{
	}
}

numbers: fun -> i32
{
	val x = 5
	ret x?
}

unused: fun -> Result[i32, i32] => Result.ok(Broken.held(1)?)

main: fun -> i32 => 0
