mod test

View[T]: ref rec
{
	data: pvt ptr[T]
	length: pvt set usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}

	as[const N: usize]: op(imm values: array[T, N]) -> View[T] => View[T](@values, N)
}

make: fun -> array[i32, 2] => [1, 2]

back: fun -> View[i32] => [5, 6]

main: fun -> i32
{
	val a: View[u16] = [1, 400]
	val b = View[u16]([1, 400])
	val c: View[i32] = make()
	var four = [1, 2, 3, 4]
	var d: View[i32] = four
	d = [7, 8]
	ret 0
}
