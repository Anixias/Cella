mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Texture: rec
{
	id: i32

	drop: op
	{
		printf("free %d\n", self.id)
	}
}

result[T, E]: enum
{
	ok(value: T)
	err(error: E)

	?: op(own self) -> T = match own self
	{
		ok(own value) => value
		err(own error) => ret result.err(own error)
	}
}

option[T]: enum
{
	none
	some(value: T)

	?: op(own self) -> T = match own self
	{
		some(own value) => value
		none => ret option.none
	}
}

wrap[T]: enum
{
	held(inner: option[T])

	?: op(own self) -> T = match own self
	{
		held(own inner) => inner?
	}
}

Probe: rec
{
	texture: Texture

	?: op(own self) -> i32 = self.texture.id
}

sized[T]: enum
{
	held(value: T)

	?: op(own self) -> usize = sizeOf(T)
}

parse: fun(n: i32) -> result[i32, i32]
{
	if n < 0
		ret result.err(n)

	ret result.ok(n * 2)
}

sumTwo: fun(a: i32, b: i32) -> result[i64, i32]
{
	val total = parse(a)? + parse(b)?
	ret result.ok(i64(total))
}

half: fun(n: i32) -> option[i32]
{
	if n % 2 != 0
		ret option.none

	ret option.some(n / 2)
}

quarter: fun(n: i32) -> option[i32] = option.some(half(half(n)?)?)

load: fun(id: i32) -> result[Texture, i32]
{
	if id < 0
		ret result.err(id)

	ret result.ok(Texture(id))
}

pair: fun(a: i32, b: i32) -> result[i32, i32]
{
	val first = load(a)?
	val second = load(b)?
	printf("loaded %d %d\n", first.id, second.id)
	ret result.ok(first.id + second.id)
}

local: fun -> result[i32, i32]
{
	val r = load(7)
	val t = r?
	ret result.ok(t.id)
}

first[T: copy]: fun(a: result[T, i32], b: result[T, i32]) -> result[T, i32]
{
	val x = a?
	val y = b?
	ret result.ok(x)
}

lambda: fun -> i32
{
	val f = fun(n: i32) -> result[i32, i32] = result.ok(first(result[i32, i32].ok(n), result.ok(2))? + 1)
	match f(4)
	{
		ok(val v) => ret v
		err(val e) => ret e
	}
}

nested: fun(w: wrap[i32]) -> option[i32] = option.some(w? + 1)

show: fun(r: result[i64, i32])
{
	match r
	{
		ok(val v) => printf("ok %lld\n", v)
		err(val e) => printf("err %d\n", e)
	}
}

main: fun -> i32
{
	show(sumTwo(1, 2))
	show(sumTwo(-1, 2))
	show(sumTwo(1, -5))
	printf("%d %d\n", quarter(8) is some(_), quarter(6) is some(_))

	val a = pair(1, 2)
	val b = pair(3, -4)
	val c = local()
	printf("%d %d\n", a is ok(3), c is ok(7))

	match first(result[i32, i32].ok(1), result.err(9))
	{
		ok(val v) => printf("ok %d\n", v)
		err(val e) => printf("err %d\n", e)
	}

	printf("lambda %d\n", lambda())
	printf("%d %d\n", nested(wrap.held(option.some(4))) is some(5), nested(wrap.held(option[i32].none)) is none)

	val p = Probe(Texture(10))
	val id = p?
	printf("probe %d\n", id)
	printf("sum %d\n", Probe(Texture(11))? + i32(sized.held(40i64)?))
	ret 0
}
