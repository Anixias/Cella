mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Bag: rec
{
	items: array[i32, 4]
	count: usize

	in: op(imm self) -> BagCursor => BagCursor(imm self, 0, 0)
}

BagCursor: ref rec
{
	bag: imm[Bag]
	current: usize
	next: usize

	for: op(mut self) -> bool
	{
		self.current = self.next
		self.next += 1
		ret self.current < self.bag.count
	}

	*: op(self) -> imm[i32] => imm self.bag.items[self.current]
}

Countdown: rec
{
	left: i32

	for: op(mut self) -> bool
	{
		self.left -= 1
		ret self.left >= 0
	}

	*: op(imm self) -> imm[i32] => imm self.left
}

takeByte: fun(value: u8) -> u8 => value

main: fun -> i32
{
	val xs = [10, 20, 30]
	var copies = [0, 0, 0]
	for x, i in xs
		copies[i] = x + 1
	
	printf("%d %d %d\n", copies[0], copies[1], copies[2])
	
	for x, i in xs
		printf("%d:%d ", i, x)
	
	printf("\n")
	
	for n, i in 5..8
		printf("%d@%d ", n, i)
	
	printf("\n")
	
	for n, i in 5..=7
	{
		if n == 6
			cont
		
		printf("%d@%d ", n, i)
	}
	
	printf("\n")
	
	val bag = Bag([4, 5, 6, 7], 3)
	for item, i in bag
	{
		if i == 1
			cont
		
		printf("%d#%d ", item, takeByte(i))
	}
	
	printf("\n")
	
	for left, i in Countdown(4)
	{
		if i == 2
			break
		
		printf("%d/%d ", left, i)
	}
	
	printf("\n")
	
	var edited = [1, 2, 3]
	for mut value, i in edited
		value *= i + 1
	
	printf("%d %d %d %zu\n", edited[0], edited[1], edited[2], sizeOf(edited))
	var last: u8 = 0
	for n, i in 0..256
		last = takeByte(i)

	printf("%d\n", i32(last))
	ret 0
}
