mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Span[T]: ref rec
{
	data: ptr[T]
	length: usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}
}

View[T]: ref rec
{
	data: ptr[T]
	length: usize

	new: op(data: ptr[T], length: usize)
	{
		self.data = data
		self.length = length
	}
}

Ring: rec
{
	items: array[i32, 3]

	as: op(mut self) -> Span[i32] => Span[i32](ptr[i32](ptr(@self.items)), 3)
	as: op(imm self) -> View[i32] => View[i32](ptr[i32](ptr(@self.items)), 3)
}

fill: fun(values: Span[i32], value: i32)
{
	for i in 0..values.length
		values.data[i] = value
}

total: fun(values: View[i32]) -> i32
{
	var sum = 0
	for i in 0..values.length
		sum += values.data[i]

	ret sum
}

main: fun -> i32
{
	var ring = Ring([1, 2, 3])
	printf("%d\n", total(ring))
	fill(mut ring, 4)
	printf("%d\n", total(ring))
	val all: Span[i32] = mut ring
	all.data[0] = 10
	printf("%d %d\n", ring.items[0], total(ring))
	ret 0
}
