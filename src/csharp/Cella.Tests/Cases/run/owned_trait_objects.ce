mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

boxed[K: trait]: rec
{
	object: ptr[dyn[K]]

	of[T: K]: fun(own value: T) -> boxed[K]
	{
		val memory = ptr[T](malloc(sizeOf(T)))
		own *memory = own value
		ret boxed[K](memory)
	}

	*: op(self) -> imm[dyn[K]] = imm *self.object

	*: op(mut self) -> mut[dyn[K]] = mut *self.object

	drop: op
	{
		printf("free %zu %zu\n", sizeOf(*self.object), alignOf(*self.object))
		drop *self.object
		free(self.object)
	}
}

Shape: trait
{
	area: fun(self) -> f64
	grow: fun(mut self)
}

Circle: rec impl Shape
{
	radius: f64

	area: fun(self) -> f64 = self.radius * self.radius * 3.0
	grow: fun(mut self)
	{
		self.radius += 1.0
	}

	drop: op
	{
		printf("circle %.1f gone\n", self.radius)
	}
}

Dot: rec impl Shape
{
	x: u8

	area: fun(self) -> f64 = 0.0
	grow: fun(mut self)
	{
		self.x += 1
	}
}

Label: rec
{
	id: i32

	drop: op
	{
		printf("label %d gone\n", self.id)
	}
}

Tagged: rec impl Shape
{
	label: Label
	side: f64

	area: fun(self) -> f64 = self.side * self.side
	grow: fun(mut self)
	{
		self.side *= 2.0
	}
}

i64: impl Shape
{
	area: fun(self) -> f64 = f64(self)
	grow: fun(mut self)
	{
		self += 1
	}
}

describe: fun(shape: dyn[Shape]) -> f64 = shape.area()

keep: fun(own shape: boxed[Shape]) -> f64
{
	printf("kept %.1f\n", shape.area())
	ret describe(*shape)
}

main: fun -> i32
{
	var circle = boxed[Shape].of(Circle(1.0))
	circle.grow()
	printf("%.1f %.1f %zu\n", circle.area(), describe(*circle), sizeOf(*circle))
	{
		val dot = boxed[Shape].of(Dot(3))
		var tagged = boxed[Shape].of(Tagged(Label(9), 2.0))
		val number = boxed[Shape].of(i64(40))
		tagged.grow()
		printf("%.1f %.1f %.1f\n", dot.area(), tagged.area(), number.area())
	}
	printf("%.1f\n", keep(boxed[Shape].of(Circle(3.0))))
	printf("end\n")
	ret 0
}
