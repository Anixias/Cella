mod std.num

use std.cmp.[Ord, Ordering]

Additive: pub trait
{
	+: op(imm left: Self, imm right: Self) -> Self
	-: op(imm left: Self, imm right: Self) -> Self
}

Multiplicative: pub trait
{
	*: op(imm left: Self, imm right: Self) -> Self
	/: op(imm left: Self, imm right: Self) -> Self
	%: op(imm left: Self, imm right: Self) -> Self
}

WrappedAdditive: pub trait
{
	+%: op(imm left: Self, imm right: Self) -> Self
	-%: op(imm left: Self, imm right: Self) -> Self
}

WrappedMultiplicative: pub trait
{
	*%: op(imm left: Self, imm right: Self) -> Self
}

Number: pub trait req Additive + Multiplicative + Ord + copy + noref
{
	minValue: const Self
	maxValue: const Self
	zero: const Self
	one: const Self
	
	compare: fun(imm left: Self, imm right: Self) -> Ordering
	{
		if (left == right)
			ret equal
		
		if (left < right)
			ret less
		
		ret greater
	}
	
	min: fun(a: Self, b: Self) -> Self
	max: fun(a: Self, b: Self) -> Self
	clamp: fun(x: Self, min: Self, max: Self) -> Self
	abs: fun(x: Self) -> Self
	isZero: fun(x: Self) -> bool
}

SignedNumber: pub trait req Number
{
	sign: fun(x: Self) -> Self
	copySign: fun(x: Self, sign: Self) -> Self
	isPositive: fun(x: Self) -> bool
	isNegative: fun(x: Self) -> bool
	-: op(self) -> Self
}

Integer: pub trait req Number + WrappedAdditive + WrappedMultiplicative
{
	~: op(self) -> Self
	&: op(a: Self, b: Self) -> Self
	|: op(a: Self, b: Self) -> Self
	^: op(a: Self, b: Self) -> Self
	<<<: op(a: Self, b: Self) -> Self
	<<: op(a: Self, b: Self) -> Self
	>>>: op(a: Self, b: Self) -> Self
	>>: op(a: Self, b: Self) -> Self
	
	min: fun(a: Self, b: Self) -> Self => match a < b { true => a, else => b }
	max: fun(a: Self, b: Self) -> Self => match a > b { true => a, else => b }
	
	clamp: fun(x: Self, min: Self, max: Self) -> Self
	{
		if min > max
			panic "{nameOf(clamp)}'s lower bound is greater than its upper bound"
		
		if x < min
			ret min
		
		if x > max
			ret max
		
		ret x
	}
	
	isZero: fun(x: Self) -> bool => x == Self.zero
}

SignedInteger: pub trait req Integer + SignedNumber
{
	sign: fun(x: Self) -> Self
	{
		if x == Self.zero
			ret Self.zero
		
		if x < Self.zero
			ret -Self.one
		
		ret Self.one
	}
	
	copySign: fun(x: Self, sign: Self) -> Self 
	{
		if (x < Self.zero) == (sign < Self.zero)
			ret x
	
		ret -x
	}
	
	abs: fun(x: Self) -> Self => match x < Self.zero { true => -x, else => x }
	
	isPositive: fun(x: Self) -> bool => x > Self.zero
	isNegative: fun(x: Self) -> bool => x < Self.zero
}

UnsignedInteger: pub trait req Integer
{
	abs: fun(x: Self) -> Self => x
}

Float: pub trait req SignedNumber
{
	posInf: const Self
	negInf: const Self
	nan: const Self
	epsilon: const Self
	subnormal: const Self
	normal: const Self
	pi: const Self
	tau: const Self
	e: const Self
	
	approxEq: fun(a: Self, b: Self) -> bool
	lerp: fun(a: Self, b: Self, t: Self) -> Self
	trunc: fun(x: Self) -> Self
	floor: fun(x: Self) -> Self
	ceil: fun(x: Self) -> Self
	round: fun(x: Self) -> Self
	roundEven: fun(x: Self) -> Self
	fract: fun(x: Self) -> Self
	fractPos: fun(x: Self) -> Self
	isNan: fun(x: Self) -> bool
	isInf: fun(x: Self) -> bool
	isPosInf: fun(x: Self) -> bool
	isNegInf: fun(x: Self) -> bool
	isFinite: fun(x: Self) -> bool
	isSubnormal: fun(x: Self) -> bool
	isNormal: fun(x: Self) -> bool
	sqrt: fun(x: Self) -> Self
	sin: fun(x: Self) -> Self
	cos: fun(x: Self) -> Self
	exp: fun(x: Self) -> Self
	log: fun(x: Self) -> Self
	pow: fun(x: Self, e: Self) -> Self
	fma: fun(x: Self, y: Self, z: Self) -> Self
}