mod std.mem

use std.[Hash, HashBuilder, Shows]
use std.cmp.Eq

Box[T: noref, A: Allocator = Heap]: pub own rec
{
	data: pvt req ptr[T]
	alloc: pvt req A
	
	new: op(value: T, allocator: A)
	{
		self.alloc = allocator
		
		// TODO Move to const after const functions exist
		val layout = Layout.of[T]()
		
		val p = self.alloc.allocate(layout)
		if p == null
			panic "out of memory"
		
		self.data = ptr[T](p)
		own *self.data = value
	}
	
	drop: op
	{
		drop *self.data
		
		// TODO Move to const after const functions exist
		val layout = Layout.of[T]()
		self.alloc.release(self.data, layout)
	}
	
	unbox: fun(self) -> T
	{
		val p = own self.data
		val value = own *p
		
		// TODO Move to const after const functions exist
		val layout = Layout.of[T]()
		self.alloc.release(p, layout)
		
		ret value
	}
	
	*: op(imm self) -> imm[T] => imm *self.data
	*: op(mut self) -> mut[T] => mut *self.data
}

Box[T: noref, A: Allocator + new]: impl
{
	new: op(value: T)
	{
		self = Box[T, A](value, A())
	}
}

Box[T: noref + Shows[Q], A: Allocator]: impl Shows[Q]
{
	show: fun(imm self, imm check: fun[imm Q -> bool]) -> bool => (*self).show(imm check)
}

Box[T: noref + Hash, A: Allocator]: impl Hash
{
	hash[H: HashBuilder]: fun(imm self, mut hashBuilder: H) => (*self).hash(mut hashBuilder)
}

Box[T: noref + Eq, A: Allocator]: impl Eq
{
	==: op(imm left: Box[T, A], imm right: Box[T, A]) -> bool => *left == *right
	!=: op(imm left: Box[T, A], imm right: Box[T, A]) -> bool => !(*left == *right)
}