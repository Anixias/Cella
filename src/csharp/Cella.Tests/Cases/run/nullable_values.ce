mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Nullable[T: null]: enum match T
{
	none = null
	some(value) = else

	isSome: get(imm self) -> bool => self is some(_)

	or: fun(self, fallback: T) -> T => match self { some(val v) => v, none => fallback }
}

Lent: ref enum match imm[i32]
{
	missing = null
	found(value) = else
}

Node: rec
{
	value: i32
}

Handler: rec
{
	id: i32
	callback: Nullable[fun[i32 -> i32]]
}

Cell[T: null]: rec
{
	value: Nullable[T]
}

wrap[T: null]: fun(value: T) -> Nullable[T] => some(value)

triple: fun(n: i32) -> i32 => n * 3
twice: fun(n: i32) -> i32 => n * 2

readNode: fun(n: Nullable[ptr[Node]]) -> i32 => match n { some(val p) => p.value, none => -1 }

find: fun(mut values: array[i32, 3], target: i32) -> Nullable[imm[i32]]
{
	var i: usize = 0
	while i < 3
	{
		if values[i] == target
			ret some(imm values[i])

		i += 1
	}

	ret none
}

pick: fun(mut values: array[i32, 3], index: usize) -> Lent
{
	if index < 3
		ret found(imm values[index])

	ret missing
}

slot: fun(mut value: i32, give: bool) -> Nullable[mut[i32]]
{
	if give
		ret some(mut value)

	ret none
}

main: fun -> i32
{
	var node = Node(5)
	val a: Nullable[ptr[Node]] = some(@node)
	val b: Nullable[ptr[Node]] = none
	var c: Nullable[ptr[Node]]
	printf("%d %d %d %d %d\n", readNode(a), readNode(b), readNode(c), i32(a.isSome), i32(ptr[Node](b) == null))

	var values = [10, 20, 30]
	val hit = find(mut values, 20)
	printf("%d %d\n", match hit { some(val v) => v, none => -1 }, i32(find(mut values, 99) is none))

	val got = pick(mut values, 1)
	printf("%d %d %d\n", match got { found(val v) => v, missing => -1 }, i32(pick(mut values, 7) is missing),
		i32(sizeOf(Lent)))

	var total = 10
	match slot(mut total, true)
	{
		some(val r) => r += 5
		none => printf("none\n")
	}

	printf("%d %d\n", total, i32(slot(mut total, false) is none))

	var handler = Handler()
	printf("%d %d\n", handler.id, i32(handler.callback is none))
	handler.callback = some(triple)
	val call = match handler.callback { some(val f) => f(5), none => -1 }
	printf("%d %d\n", call, i32(sizeOf(Handler)))

	var m = 6
	val doubled: fun[i32 -> i32] = twice
	val empty: Nullable[fun[i32 -> i32]] = none
	val cell = Cell[cstr]()
	val text = Cell[cstr](some("text"))
	printf("%d %d %d %d\n", *wrap(@m).or(@node.value), wrap(doubled).or(triple)(4), empty.or(triple)(4),
		i32(cell.value is none))
	printf("%s %s\n", text.value.or("?"), cell.value.or("?"))
	ret 0
}
