mod std.text

use std.[Hash, HashBuilder, View]
use std.cmp.Eq
use std.mem.[Allocator, Heap, Layout]

String[A: Allocator = Heap]: pub own rec
{
	data: pvt ptr[u8]
	length: pvt set usize
	alloc: pvt req A
	
	new: op(text: str, allocator: A)
	{
		self.alloc = allocator
		
		val length = text.byteLength
		self.length = length
		
		if length == 0
		{
			self.data = null
			ret
		}
		
		val layout = Layout.arrayOf[u8](length)
		
		val p = self.alloc.allocate(layout)
		if p == null
			panic "out of memory"
		
		self.data = ptr[u8](p)
		for i in 0..length
			*(self.data + i) = text[i]
	}
	
	drop: op
	{
		if self.data == null
			ret
		
		val layout = Layout.arrayOf[u8](self.length)
		self.alloc.release(self.data, layout)
	}
	
	as: op(imm self) -> str => str(self.data, self.length)
	as: op(imm self) -> View[u8] => View[u8](self.data, self.length)
	
	==[B: Allocator]: op(imm left: String[A], imm right: String[B]) -> bool
	{
		val leftText: str = left
		val rightText: str = right
		ret leftText == rightText
	}
	
	!=[B: Allocator]: op(imm left: String[A], imm right: String[B]) -> bool => !(left == right)
}

String[A: Allocator]: impl Hash
{
	hash[H: HashBuilder]: fun(imm self, mut hashBuilder: H) => hashBuilder.writeBytes(...self)
}

String[A: Allocator]: impl Eq
{
	==: op(imm left: String[A], imm right: String[A]) -> bool
	{
		val leftText: str = left
		val rightText: str = right
		ret leftText == rightText
	}
	
	!=: op(imm left: String[A], imm right: String[A]) -> bool => !(left == right)
}

String[A: Allocator + default]: impl
{
	new: op(value: str)
	{
		self = String[A](value, A())
	}
}