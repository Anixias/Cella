mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
	malloc: fun(size: usize) -> ptr
	free: fun(memory: ptr)
}

Box[T]: own rec
{
	target: pvt req ptr[T]

	new: op(value: T)
	{
		self.target = ptr[T](malloc(sizeOf(T)))
		own *self.target = value
	}

	new: mod op(adopt: ptr[T])
	{
		self.target = adopt
	}

	*: op(imm self) -> imm[T] => imm *self.target

	drop: op
	{
		drop *self.target
		free(self.target)
	}
}

main: fun -> i32
{
	var n = 5
	val p = @n
	val b = Box(p)
	printf("%d\n", **b)
	val c: i32 = b
	ret 0
}
