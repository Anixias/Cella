mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

P: rec
{
	x: i32

	get: fun(self) -> i32 = self.x
}

Effect: enum { none, hit(n: i32) }

Boxed: enum { empty, full(p: P) }

hitting: const Effect = Effect.hit(3)
quiet: const Effect = Effect.none
strong: const bool = hitting is hit(val n) && n > 2
weak: const bool = quiet is hit(val n) && n > 2
either: const bool = quiet is hit(val n) || hitting is hit(val m) && m == 3
held: const Boxed = Boxed.full(P(5))
debugOn: const bool = false

show: fun(imm p: P) -> i32 = p.x

make: fun -> Boxed = Boxed.full(P(4))

main: fun -> i32
{
	printf("%d %d %d\n", i32(strong), i32(weak), i32(either))
	if held is full(val p) && p.x > 2
		printf("%d %d\n", p.get(), show(imm p))

	val local = make()
	if debugOn && local is full(val q)
		printf("%d\n", q.get())

	if !debugOn && local is full(val r)
		printf("%d\n", r.get())

	ret 0
}
