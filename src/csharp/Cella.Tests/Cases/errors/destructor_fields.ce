mod test

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Holder: rec
{
	buffer: Buffer
	count: i32

	drop: op
	{
	}
}

Inner: rec
{
	buffer: Buffer
}

Shell: rec
{
	inner: Inner
	items: array[Buffer, 2]

	drop: op
	{
	}
}

Outer: rec
{
	holder: Holder
	spare: Buffer
}

make: fun(id: i32) -> Buffer = Buffer(id)
take: fun(own buffer: Buffer) -> i32 = buffer.id

local: fun -> i32
{
	val holder = Holder(make(1), 2)
	val buffer = own holder.buffer
	val count = own holder.count
	val copied = holder.count
	ret buffer.id + count + copied + holder.buffer.id
}

nested: fun -> i32
{
	val shell = Shell(Inner(make(1)), [make(2), make(3)])
	ret take(shell.inner.buffer) + take(shell.items[0])
}

owned: fun(own holder: Holder) -> i32 = take(holder.buffer)

whole: fun -> i32
{
	val outer = Outer(Holder(make(1), 2), make(3))
	val holder = own outer.holder
	val spare = own outer.spare
	ret holder.count + spare.id
}

refilled: fun(mut holder: Holder) -> i32
{
	val old = own holder.buffer
	holder.buffer = make(old.id + 1)
	ret old.id
}

main: fun -> i32 = 0
