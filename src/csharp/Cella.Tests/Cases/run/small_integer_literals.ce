mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

pick: fun(a: i32, b: i64) -> i32
{
	ret 1
}

pick: fun(a: i64, b: i32) -> i32
{
	ret 2
}

main: fun -> i32
{
	var tiny: i8 = 127
	var byte: u8 = 255
	var short: u16 = 65535
	var wrappedTiny = tiny +% 1
	var wrappedByte = byte +% 1
	var wrappedShort = short +% 1
	var widened: u32 = u32(byte) + 1
	var outOfRange = tiny + 200
	printf("%d %d %d %u %d\n", wrappedTiny, wrappedByte, wrappedShort, widened, outOfRange)
	printf("%d %d %d %d\n", sizeOf(wrappedTiny), sizeOf(wrappedByte), sizeOf(wrappedShort), sizeOf(outOfRange))

	var count: i32 = 0
	printf("%d\n", pick(count, 5))
	ret 0
}
