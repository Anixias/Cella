mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Writable[T]: trait
{
	[]: op(imm self, i: usize) -> mut[T]
}

view[T]: ref rec impl Writable[T]
{
	data: ptr[T]
	length: usize

	[]: op(self, i: usize) -> mut[T] = mut self.data[i]
}

fill[V: Writable[i32]]: fun(imm values: V, count: usize, value: i32)
{
	for i in 0usize..count
		values[i] = value
}

main: fun -> i32
{
	var items = [1, 2, 3]
	fill(view[i32](@items[0], 3), 3, 7)
	printf("%d %d %d\n", items[0], items[1], items[2])
	ret 0
}
