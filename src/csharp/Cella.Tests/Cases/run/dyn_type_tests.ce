mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Shape: trait
{
	area: fun(imm self) -> f64
}

Circle: rec impl Shape
{
	radius: f64

	area: fun(self) -> f64 => self.radius
}

Square: rec impl Shape
{
	side: f64

	area: fun(self) -> f64 => self.side
}

Triangle: rec impl Shape
{
	base: f64

	area: fun(self) -> f64 => self.base
}

kind: fun(imm shape: dyn[Shape]) -> i32
{
	if shape is Circle circle
		ret i32(circle.radius) * 10

	if shape is Square
		ret 2

	ret 0
}

name: fun(imm shape: dyn[Shape]) -> i32 => match shape
{
	Circle c => 100 + i32(c.radius)
	Square => 200
	else => 300
}

stretch: fun(mut shape: dyn[Shape])
{
	match mut shape
	{
		Circle circle => circle.radius *= 2.0
		Square square => square.side += 1.0
		else => {}
	}

	if mut shape is Triangle t
		t.base = 99.0
}

main: fun -> i32
{
	var c = Circle(4.0)
	var s = Square(3.0)
	var t = Triangle(5.0)
	printf("%d %d %d\n", kind(imm c), kind(imm s), kind(imm t))
	printf("%d %d %d\n", name(imm c), name(imm s), name(imm t))
	stretch(mut c)
	stretch(mut s)
	stretch(mut t)
	printf("%.1f %.1f %.1f\n", c.radius, s.side, t.base)
	ret 0
}
