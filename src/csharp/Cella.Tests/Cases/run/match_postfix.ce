mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

Kind: enum
{
	a
	b
}

Pair: rec
{
	left: i32
	right: i32

	sum: fun(self) -> i32 => self.left + self.right
}

double: fun(x: i32) -> i32 => x * 2
triple: fun(x: i32) -> i32 => x * 3

main: fun -> i32
{
	val k = Kind.b
	val n = match k { a => [1, 2], b => [3, 4] }[1]
	val m = match k { a => Pair(1, 2), b => Pair(3, 4) }.right
	val s = match k { a => Pair(1, 2), b => Pair(5, 6) }.sum()
	val f: fun[i32 -> i32] = double
	val g: fun[i32 -> i32] = triple
	val c = match k { a => f, b => g }(7)
	val multi = match k
	{
		a => [10, 20]
		b => [30, 40]
	}[0]
	printf("%d %d %d %d %d\n", n, m, s, c, multi)
	ret 0
}
