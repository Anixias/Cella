mod test

Buffer: rec
{
	id: i32

	drop: op
	{
	}
}

Holder: rec
{
	items: array[Buffer, 2]
}

make: fun(id: i32) -> Buffer = Buffer(id)
take: fun(own buffer: Buffer) -> i32 = buffer.id
show: fun(buffer: Buffer) -> i32 = buffer.id

moves: fun(i: usize) -> i32
{
	var items = [make(1), make(2), make(3)]
	val picked = items[i]
	val shown = show(items[i])
	val first = items[0]
	ret picked.id + shown + first.id + take(items[2])
}

parameter: fun(mut items: array[Buffer, 2], i: usize) -> i32 = take(own items[i])

large: fun -> i32
{
	var items: array[Buffer, 100] = undef
	items[70] = make(1)
	ret take(items[70])
}

writes: fun(i: usize) -> i32
{
	var items: array[Buffer, 2] = undef
	items[i] = make(1)
	items[0] = make(2)
	items[i] = make(3)
	items[1] = make(4)
	items[i] = make(5)
	ret items[0].id
}

moved: fun(i: usize) -> i32
{
	var items = [make(1), make(2)]
	val other = items
	items[i] = make(3)
	ret other[0].id
}

nested: fun(i: usize) -> i32
{
	var holder: Holder = undef
	holder.items[i] = make(1)
	ret 0
}

main: fun -> i32 = 0
