mod test

ext
{
	printf: fun(format: cstr, ...) -> i32
}

View[T]: ref rec
{
	data: ptr[T]
	length: usize

	as[const N: usize]: op(imm values: array[T, N]) -> View[T] => View(@values[0], N)
}

same: fun(xs: View[i32]) -> usize
{
	printf("view\n")
	ret xs.length
}

same: fun(...xs: View[i32]) -> usize
{
	printf("pack\n")
	ret xs.length
}

Bag: rec
{
	count: usize

	new: op(xs: View[i32])
	{
		self.count = xs.length
	}

	new: op(...xs: View[i32])
	{
		self.count = xs.length + 100
	}
}

main: fun -> i32
{
	val numbers = [1, 2, 3]
	val v: View[i32] = numbers
	same(v)
	same(1, 2)
	same(...v)
	same()
	printf("%zu %zu\n", Bag(v).count, Bag(1, 2).count)
	ret 0
}
