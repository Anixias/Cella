mod test

table: val array[usize, 2] = [1, 2]

Has: trait
{
	bits: const usize
}

a[const N: usize]: fun(values: array[i32, N + 1]) => ret
e[const N: usize]: fun(values: array[i32, usize(N)]) => ret
c[const N: usize]: fun(values: array[i32, table[N]]) => ret
f[const N: usize]: fun(values: array[i32, [N, 1][0]]) => ret
b[const N: usize]: fun(values: array[i32, match N { 0 => 1, else => 2 }]) => ret
t[T: Has]: fun(values: array[i32, T.bits * 2]) => ret
k[const N: usize]: fun(values: array[i32, table[1]]) => ret

main: fun -> i32 => 0
